# py_kwonly.ar — キーワード専用引数（bare `*`）・位置専用引数（`/`）を持つ Python の関数を Arrow から呼ぶ
#
# `def f(a, *, b)` の `*` より後ろはキーワードでしか渡せない。Arrow の型スタブには「位置渡し禁止」を表す印が無いので、
# 静的には通り、位置で渡すと CPython が `TypeError` にする（②）。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py-int] test_modules.py_kwonly as m

mut a = 1
mut b = 2
mut c = 3

# ── ① キーワードで渡す（Python と同じ書き方） ────────────────────────────
print(m.f(a, b=b))
# 12

# ── ② 位置で渡す（CPython の TypeError） ────────────────────────────────
try:
    print(m.f(a, b))
except TypeError as e:
    print("TypeError:", e)
# TypeError: f() takes 1 positional argument but 2 were given

# ── ③ キーワード専用が 2 個 ─────────────────────────────────────────────
print(m.g(a, b=b, c=c))
# 6

# ── ④ bare `*` だけ（位置引数なし） ─────────────────────────────────────
mut n = 5
print(m.only_kw(b=n))
# 6

# ── ⑤ `/` と `*` の併用（`/` の前は位置で、`*` の後はキーワードで渡す） ────
print(m.both_markers(a, b, c=c))
# 123

# ── ⑥ `__init__` の bare `*` ────────────────────────────────────────────
mut p = m.Point(a, y=b)
print(p.total())
# 3
