# py_ternary.ar — Python の三項演算子（`a if cond else b`）を使う関数を Arrow から呼ぶ
#
# 三項演算子は CPython が実行する（選ばれた腕しか評価しない・⑨ で副作用の回数まで確かめる・腕の型が違ってもよい）。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py] test_modules.py_ternary as m

mut t = True
mut f = False

# ── ① 素朴な三項式 ──────────────────────────────────────────────────────
mut a = 5
print(m.sign(a))
# pos
mut b = -5
print(m.sign(b))
# nonpos

# ── ② 入れ子（括弧つき） ────────────────────────────────────────────────
mut z = 0
print(m.nested(z))
# zero
print(m.nested(a))
# pos
print(m.nested(b))
# neg

# ── ③ 括弧なしの連鎖（右結合＝ elif 相当） ──────────────────────────────
mut k2 = 2
print(m.chain(k2))
# b
mut k9 = 9
print(m.chain(k9))
# z

# ── ④ 代入の右辺 ────────────────────────────────────────────────────────
print(m.in_assign(t))
# 1
print(m.in_assign(f))
# 2

# ── ⑤ 呼び出し引数の中 ──────────────────────────────────────────────────
print(m.in_arg(t))
# 3
print(m.in_arg(f))
# 4

# ── ⑥ リスト要素 / dict の値 ────────────────────────────────────────────
print(m.in_list(t))
# [1, 3]
print(m.in_dict(t))
# {'k': 10}

# ── ⑦ while の条件式の中 ────────────────────────────────────────────────
mut n = 3
print(m.in_cond(n))
# 3

# ── ⑧ 腕の型が違う ──────────────────────────────────────────────────────
print(m.mixed(t))
# 1
print(m.mixed(f))
# one

# ── ⑨ ★遅延評価: 選ばれた腕しか評価されない（CALLS が 1 件だけ） ────────
print(m.lazy(t))
# T:1
