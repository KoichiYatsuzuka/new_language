# rs_unsupported_signature_error.ar — 今の Arrow から呼べない Rust の関数・メソッドは静的エラー（負例・2-5）
#
# 以前はこうした関数・メソッドは import 時に**黙って消え**、使うと「そんな名前は無い」という誤りになっていた
# （型スタブにも載らないので理由が分からない）。今は理由を書いた印を付けて型スタブに載せ、使った箇所を
# 静的エラーにする（`TypeErrorKind::FfiUnsupported`）。`Vec<String>` などの受け渡しはフェーズ 5（5-4）で対応する。
#
# 9 種類: コレクションの戻り値・スライスの引数・ジェネリック・`Vec<u8>` の引数・`&mut` の引数・タプルの戻り値・
# Arrow から作れない構造体の構築・`self` の無い関連関数・`self` を消費するメソッド。どれも実行前に止まる。
#
# 実行には cargo が要る（rs_crates/ffi_probe_rs）。対になる正例: rs_values.ar

import[rs] ffi_probe_rs as fp

let w = fp.words("a b")
let total = fp.sum([1, 2])
let same = fp.ident(1)
let n = fp.count_bytes("x")
mut k = 1
fp.bump(k)
let pr = fp.pair()
let sealed = fp.Sealed()
let c = fp.Counter(1)
let zero = fp.Counter.zero()
let taken = c.into_n()
