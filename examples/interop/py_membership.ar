# py_membership.ar — Python の `in` / `not in` を使う関数を Arrow から呼ぶ
#
# list / tuple / set は要素、dict はキー、str は部分文字列（CPython が実行する）。Arrow の list / dict / set は
# `=> py_list[T]` などで写して渡す。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py] test_modules.py_membership as m

mut xs = [1, 2, 3]
mut two = 2
mut nine = 9

# ── ① list ──────────────────────────────────────────────────────────────
print(m.in_list(two, xs => py_list[int]))
# True
print(m.in_list(nine, xs => py_list[int]))
# False
print(m.not_in_list(nine, xs => py_list[int]))
# True

# ── ② dict はキーに対するメンバシップ ───────────────────────────────────
mut d = {"a": 1}
mut ka = "a"
print(m.in_dict(ka, d => py_dict[str, int]))
# True
mut kz = "z"
print(m.in_dict(kz, d => py_dict[str, int]))
# False

# ── ③ str は部分文字列 ──────────────────────────────────────────────────
mut s = "hello"
mut sub = "ell"
print(m.in_str(sub, s))
# True

# ── ④ tuple / set ───────────────────────────────────────────────────────
mut tup = (1, 2)
mut one = 1
print(m.in_tuple(one, tup))
# True
mut st = {1, 2, 3}
print(m.in_set(two, st => py_set[int]))
# True

# ── ⑤ 条件式としての利用 ────────────────────────────────────────────────
print(m.guard(xs => py_list[int]))
# yes

# ── ⑥ `and` と組み合わせる ──────────────────────────────────────────────
mut ys = [9]
print(m.combined(two, xs => py_list[int], ys => py_list[int]))
# True

# ── ⑦ ループ内フィルタ（典型的な用途） ──────────────────────────────────
mut banned = [2]
print(m.filter_loop(xs => py_list[int], banned => py_list[int]))
# [1, 3]
