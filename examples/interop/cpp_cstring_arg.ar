# cpp_cstring_arg.ar — `const char*` の引数へ str を渡す（正例・ffi_value_exchange_plan.md 1-2）
#
# Arrow の str は UTF-8 の NUL 終端の一時コピーとして渡る（呼び出しの間だけ有効）。
# `const char*` の引数は今の Arrow から正しく受け渡せる形の 1 つで、ここで確かめる。
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。
#
# 実行には examples/interop/test_modules/ffi_probe.dll が要る（build_ffi_probe.ps1）。
# 対になる負例: cpp_cstring_nul_error.ar（NUL を含む str）・cpp_unsupported_signature_error.ar

import[cpp-dll] test_modules.ffi_probe as fp

fn check(let label: str, let got: int, let want: int) -> None:
    if got != want:
        raise RuntimeError(label + ": expected " + str(want) + " but got " + str(got))
    print(label, got)

check("fp_len(abc)", fp.fp_len("abc"), 3)
check("fp_len(empty)", fp.fp_len(""), 0)
check("fp_len(nihongo) bytes", fp.fp_len("日本語"), 9)

# 関数の中・ループの中から（一時コピーが呼び出しごとに作られ、捨てられる）
fn total_len(let words: list[str]) -> int:
    mut acc = 0
    for w in words:
        acc += fp.fp_len(w)
    return acc

check("total_len", total_len(["a", "bb", "ccc", "あ"]), 9)
