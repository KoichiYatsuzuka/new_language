# py_tuple.ar — Python のタプル（リテラル・入れ子・アンパック・比較）を使う関数を Arrow から呼ぶ
#
# タプルは不変なので境界で Arrow のタプルに写す（要素の list などは CPython の物のまま `py_list`）。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py] test_modules.py_tuple as m

# ── ① リテラル / 空 / 単要素 ────────────────────────────────────────────
print(m.literal())
# (1, 2, 3)
print(m.empty())
# ()
print(m.single())
# (1,)

# ── ② 入れ子 / 型混在 ───────────────────────────────────────────────────
print(m.nested())
# ((1, 2), (3, 4))
print(m.mixed())
# (1, 'a', True, None)

# ── ③ 要素が式 ──────────────────────────────────────────────────────────
mut a = 1
mut b = 3
print(m.from_exprs(a, b))
# (2, 6)

# ── ④ 添字 / スライス / len / in / 反復 ─────────────────────────────────
mut t = (1, 2, 3)
print(m.index(t))
# 2
print(m.slice_it(t))
# (2, 3)
print(m.length(t))
# 3
mut two = 2
print(m.contains(t, two))
# True
print(m.iterate(t))
# 6

# ── ⑤ デフォルト引数 / リスト要素 / 戻り値のペア ────────────────────────
print(m.as_default())
# (7, 8)
print(m.in_list())
# [(1, 2), (3, 4)]
mut p = 7
mut q = 8
print(m.as_return_pair(p, q))
# (7, 8)

# ── ⑥ 等価比較は値で行われる（list と違ってタプルは正しい） ─────────────
print(m.compare())
# True
