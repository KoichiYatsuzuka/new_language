# py_class_factory.ar — 関数の中でクラスを作る Python のコード（デコレータ・クラスのファクトリ）
#
# 関数の中のクラスは CPython が作る。関数の中でクラスを作って使い切る関数（count_by など）も、Python の中でデコレータを
# 掛けたクラス（@add_greeting class Person）も Arrow から使える（デコレータがメンバーを足すことがあるので、そのクラスの
# メンバーは静的に「無い」と言わない）。
# ⚠ Arrow の関数の中の class は構文の誤り（classes/class_in_function_error.ar）。
# ⚠ インスタンスは CPython の物なので `mut` で持つ（D-3）。

import[py-int] test_modules.py_class_factory as f

# ── ① ファクトリを Python の中で使い切る ────────────────────────────────
#     Counter は関数の引数 step（3）を閉包として捕まえ、最上位の Base を継承する。
mut step = 3
mut times = 4
print(f.count_by(step, times))
# base 12

# ── ② メソッドがクラス自身を名前で引く ──────────────────────────────────
mut n = 5
print(f.chain_length(n))
# 5

# ── ③ if / else の中のクラス ────────────────────────────────────────────
mut yes = True
mut no = False
print(f.pick(yes))
# yes
print(f.pick(no))
# no

# ── ④ メソッドが関数のローカルのリストを書き換える（同じリストを指す） ──
mut values = [1, 2, 3]
print(f.collect(values => py_list[int]))
# 3

# ── ⑤ Python の中でデコレータを掛けたクラス ──────────────────────────────
#     Person は add_greeting が返した派生クラス（greet が足されている）。
mut name = "ann"
mut p = f.Person(name)
print(p.name)
# ann
print(p.greet())
# hello from ann

# ── ⑥ 引数を取るデコレータ（tagged_with("v1")）───────────────────────────
mut r = f.Release()
print(r.tag())
# v1
print(r.ok)
# True
