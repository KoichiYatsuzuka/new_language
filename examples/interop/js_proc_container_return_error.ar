# js_proc_container_return_error.ar — 型スタブと食い違うコンテナの戻り値は FfiTypeError（負例・2-3）
#
# `js_probe.ars` は `mixed() -> list[int]` と宣言しているが、JS の実装は `[1, "two"]` を返す（JS は型を守らない）。
# 以前は js-proc のスタブの戻り値がプリミティブしか読まれず（`collect_module_types`）、コンテナを返す関数は照合
# されなかったので、`list[int]` の変数に文字列が黙って入っていた。今は要素まで照合して FfiTypeError にする。
#
# 実行には Node.js が要る（型は js_probe.ars、実装は js_probe.js）。
# 対になる正例: js_proc_values.ar

import[js-proc] js_probe as jp

print("ints:", jp.ints())
let xs: list[int] = jp.mixed()
print("unreachable:", xs)
