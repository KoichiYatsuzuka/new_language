# py_property.ar — Python の @property / @x.setter / @x.deleter / @Base.x.getter を CPython で動かし、Arrow から読み書きする
#
# 読み書きは CPython のディスクリプタのプロトコルで getter / setter に回る（Arrow からの `o.x` / `o.x = v` も CPython の
# `getattr` / `setattr`）。pp.run() の出力（CPython）:
#   25
#   77.0
#   212.0
#   below absolute zero
#   property 'fahrenheit' of 'Temperature' object has no setter
#   property True
#   True True
#   0
#   [1, 2] (2,)
#   child of base
#   base
#   7 ['property']           ← `@logged @property`（property を包むデコレータ・タスク 6-6）
#   Temperature in degrees Celsius. name of the base None None
#                            ← getter の docstring が `__doc__`（setter のは使わない・getter を差し替えると付け直す・タスク 6-7）

import[py] test_modules.py_property as pp

pp.run()

# Arrow からも Python のクラスの property を読み書きできる
mut t = pp.Temperature(10)
print(t.celsius)
t.celsius = 30
print(t.fahrenheit)
