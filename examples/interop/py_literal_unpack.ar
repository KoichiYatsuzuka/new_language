# py_literal_unpack.ar — `import[py]` 変換器の **リテラル内の `*` 展開**（U3 / C6）。
#
# Arrow に splat / spread は**字句・構文とも存在しない**ので、連結へ脱糖する:
#
#   [0, *a, 9]  ->  [0] + a + [9]      （B5 で入った list の `+` を使う）
#   [*a]        ->  a + []             （必ずリテラルを 1 つ残して新しいリストにする）
#   {1, *a, 2}  ->  set([1, 2]).union(a)
#
# ⚠⚠ **リスト版は展開元がリストでないと落ちる**。Arrow に `list()` 組込みが無いため
#   `list(a) + [...]` と書けない。タプル / セット / str / dict を展開すると
#   `TypeError: unsupported operand types for Add` になる（型が判れば静的に、
#   `.py` 由来で `Any` なら実行時に）。**黙って違う結果にはならない**ので許容している。
#   → `py_literal_unpack_error.ar` の ①。
#
# ⚠ **セット版は展開元の種類を選ばない**（`set()` は任意のイテラブルを受け、
#   `union` もリストを受ける）。リスト版との非対称はここ。
#
# ⚠ **辞書の `{**d}` は未対応**（明示エラー）。Arrow に dict のマージ手段が無い。
#   `dict()` コンストラクタが入れば `dict(d1.items() + d2.items())` で書ける
#   （`items()` は C5 で追加済み）。FUTURE_FEATURE §4 (4-a) の `dict()` と同じ前提。
#
# ⚠ **タプル表示の `(*a, 9)` と呼び出しの `f(*a)` も未対応**（U4/U5・フェーズ F）。
#
# 7 形すべて CPython と出力一致を突き合わせ済み。

import[py] test_modules.py_literal_unpack as m

mut a = [1, 2]
mut b = [3, 4]

# ── ① 前後にリテラルがある ──────────────────────────────────────────────
print(m.mid(a))
# [0, 1, 2, 9]

# ── ② 先頭が展開 ────────────────────────────────────────────────────────
print(m.head(a))
# [1, 2, 9]

# ── ③ 末尾が展開 ────────────────────────────────────────────────────────
print(m.tail(a))
# [0, 1, 2]

# ── ④ 展開だけ（＝コピー） ──────────────────────────────────────────────
print(m.only(a))
# [1, 2]

# ── ⑤ 展開が 2 つ ───────────────────────────────────────────────────────
print(m.two(a, b))
# [1, 2, 3, 4]

# ── ⑥ `[*a]` が**新しいリスト**であること（元を書き換えない） ───────────
print(m.copy_check(a))
# (2, 3)

# ── ⑦ セット表示の展開 ──────────────────────────────────────────────────
print(m.s_mid(a))
print(m.s_two(a, b))
# {1, 2}
# {1, 2, 3, 4}
