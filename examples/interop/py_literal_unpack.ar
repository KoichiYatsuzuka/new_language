# py_literal_unpack.ar — リテラルの中の `*` 展開（`[0, *a, 9]`・`(*a, 9)`・`{*a}`）を使う関数を Arrow から呼ぶ
#
# 展開は CPython が実行する。Arrow の list は `=> py_list[int]` で写して渡す。
# Arrow の側の `*other` は `examples/collections/seq_spread.ar`。

import[py-int] test_modules.py_literal_unpack as m

mut a = [1, 2]
mut b = [3, 4]
mut t = (5, 6)

# ── ① 前後にリテラルがある ──────────────────────────────────────────────
print(m.mid(a => py_list[int]))
# [0, 1, 2, 9]

# ── ② 先頭が展開 ────────────────────────────────────────────────────────
print(m.head(a => py_list[int]))
# [1, 2, 9]

# ── ③ タプルを展開 ──────────────────────────────────────────────────────
print(m.from_tuple(t))
# [5, 6, 9]

# ── ④ 展開だけ（＝コピー） ──────────────────────────────────────────────
print(m.only(a => py_list[int]))
# [1, 2]

# ── ⑤ 展開が 2 つ ───────────────────────────────────────────────────────
print(m.two(a => py_list[int], b => py_list[int]))
# [1, 2, 3, 4]

# ── ⑥ `[*a]` が**新しいリスト**であること（元を書き換えない） ───────────
print(m.copy_check(a => py_list[int]))
# (2, 3)

# ── ⑦ タプル表示の展開 ──────────────────────────────────────────────────
print(m.tup(a => py_list[int]))
# (1, 2, 9)

# ── ⑧ セット表示の展開（並びは当てにしない） ────────────────────────────
print(m.st(a => py_list[int]))
# (3, True)
