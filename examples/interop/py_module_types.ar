# py_module_types.ar — Python のモジュールのクラスはモジュールの名前で型として書ける
#
# 対になる誤りの例: py_module_types_error.ar
#
# `test_modules/py_module_types_zoo.py` の `Dog` は `test_modules.py_module_types_zoo.Dog` という型。
# import の別名（`z.Dog`）と `from ... import` した素の名前のどちらでも、`is` / `mustbe` / 型注釈に書ける。
# 派生は基底の型で受けられ（`fn describe(mut a: z.Animal)` に `z.Puppy()`）、`is` は CPython の `isinstance`。
# 別のモジュールのクラスを継承したクラス（kennel の `Corgi(zoo.Dog)`）も基底の型で受けられる。
# 別のモジュールの同名クラス（kennel の `Dog`）は別の型。
# ⚠ インスタンスは CPython の物なので `mut` で受ける（D-3）。
# ⚠ ほかのモジュールの基底へは、そのモジュールもプログラムが import しているときだけたどれる（型の表はモジュールごと）。

import[py-int] test_modules.py_module_types_zoo as z
import[py-int] test_modules.py_module_types_kennel as k
from test_modules.py_module_types_zoo import[py-int] Puppy

# ── ① is: 自分のクラスと、その基底 ──────────────────────────────────────
mut p = z.Puppy()
print(p is z.Puppy, p is z.Dog, p is z.Animal)            # True True True
print(z.Animal() is z.Dog)                                 # False（基底は派生ではない）
print(p is Puppy)                                          # True（from import した素の名前）

# ── ② 型注釈・mustbe: 派生を基底の型で受ける ────────────────────────────
fn describe(mut a: z.Animal) -> str:
    return a.kind()

mut d: z.Dog = z.Puppy()
print(describe(d))                                         # puppy
mut m = p mustbe z.Dog
print(m is z.Puppy)                                        # True

# ── ③ 別のモジュールのクラスを継承する（kennel.Corgi は zoo.Dog の派生）──
mut c = k.Corgi()
print(c is k.Corgi, c is z.Dog, c is z.Animal)            # True True True
print(describe(c))                                         # corgi

# ── ④ 別のモジュールの同名クラスは別の型 ───────────────────────────────
mut kd = k.Dog()
print(kd is k.Dog, kd is z.Dog, p is k.Dog)               # True False False
print(kd.kind())                                           # kennel dog
