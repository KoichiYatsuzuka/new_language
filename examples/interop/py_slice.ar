# py_slice.ar — Python のスライス（負のインデックス・負のステップ・範囲外・逆転した境界・スライス代入）を使う関数を Arrow から呼ぶ
#
# スライスは CPython が実行する。Arrow の list は `=> py_list[int]` で写して渡す（⑧ のスライス代入は Python の中の list）。
# Arrow の値のスライスは `examples/collections/` の例題、CPython の物のスライスは `py_int_slices.ar`。

import[py-int] test_modules.py_slice as m

mut xs = [1, 2, 3, 4, 5]

# ── ① 基本形 ────────────────────────────────────────────────────────────
print(m.basic(xs => py_list[int]))
# [2, 3]
print(m.open_begin(xs => py_list[int]))
# [1, 2]
print(m.open_end(xs => py_list[int]))
# [3, 4, 5]
print(m.full(xs => py_list[int]))
# [1, 2, 3, 4, 5]

# ── ② ステップ ──────────────────────────────────────────────────────────
print(m.step(xs => py_list[int]))
# [1, 3, 5]
print(m.begin_end_step(xs => py_list[int]))
# [2, 4]

# ── ③ 負のインデックス・負のステップ ────────────────────────────────────
print(m.negative(xs => py_list[int]))
# [1, 2, 3, 4]
print(m.neg_begin(xs => py_list[int]))
# [4, 5]
print(m.reverse(xs => py_list[int]))
# [5, 4, 3, 2, 1]
print(m.neg_step_partial(xs => py_list[int]))
# [5, 4, 3]

# ── ④ 範囲外・逆転した境界（Python は例外にせず空／切り詰め） ────────────
print(m.out_of_range(xs => py_list[int]))
# []
print(m.reversed_bounds(xs => py_list[int]))
# []
print(m.big_end(xs => py_list[int]))
# [2, 3, 4, 5]

# ── ⑤ str / tuple にも効く ──────────────────────────────────────────────
mut s = "hello"
print(m.on_str(s))
# el|olleh
mut t = (1, 2, 3, 4)
print(m.on_tuple(t))
# (2, 3)

# ── ⑥ 境界が式 ──────────────────────────────────────────────────────────
mut a = 1
mut b = 4
print(m.computed(xs => py_list[int], a, b))
# [2, 3, 4]

# ── ⑦ スライスの結果にさらにスライス ────────────────────────────────────
print(m.nested_expr(xs => py_list[int]))
# [2, 3]

# ── ⑧ スライス代入 ──────────────────────────────────────────────────────
mut ys = [1, 2, 3, 4, 5]
print(m.slice_assign(ys => py_list[int]))
# [1, 99, 98, 4, 5]

# ⚠ `xs[::0]` は Arrow でも `ValueError: slice step cannot be zero`（CPython と**文言まで一致**）。
#    例題を止めてしまうのでここでは呼ばない。
