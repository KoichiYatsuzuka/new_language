# py_fstring.ar — f-string を使う Python の関数を Arrow から呼ぶ
#
# f-string は CPython が評価する（`!s` / `!r` / 入れ子の f-string・`{{` / `}}`）。書式指定は `py_format.ar`。
# Arrow の list / dict は `=> py_list[T]` / `=> py_dict[K, V]` で写して渡す。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py] test_modules.py_fstring as m

# ── ① 基本形 ────────────────────────────────────────────────────────────
mut name = "bob"
print(m.simple(name))
# hi bob
mut n = 5
print(m.multi(name, n))
# hi bob, n=5!
print(m.only_expr(n))
# 5
print(m.empty())
#            （空行）
print(m.literal_only())
# plain
mut a = 1
mut b = 2
print(m.adjacent(a, b))
# 12

# ── ② `{{` / `}}` はリテラルの波括弧 ────────────────────────────────────
print(m.braces(n))
# {literal} 5

# ── ③ 埋め込みは任意の式（演算・呼び出し・属性・添字） ──────────────────
print(m.expr_inside(a, b))
# sum=3
mut xs = [1, 2, 3]
print(m.call_inside(xs => py_list[int]))
# len=3
mut o = m.Box(7)
print(m.attr_inside(o))
# v=7
mut d = {"x": 9}
print(m.index_inside(d => py_dict[str, int]))
# x=9

# ── ④ 変換フラグ `!s` / `!r` ────────────────────────────────────────────
mut s = "hi"
print(m.conv_str(s))
# hi
print(m.conv_repr(s))
# 'hi'      （repr なので引用符が付く）

# ── ⑤ f-string の結果をさらに f-string に埋める ─────────────────────────
print(m.nested_fstring(n))
# outer [5]
