# py_int_cast_required_error.ar — Arrow の list / dict / set をキャストせずに Python へ渡すのは静的な誤り
# （pandas_import_plan.md の D-12・2-11）。リテラルも同じで、`=> py_list[int]` などで写して渡す。
#
# 写して渡すと Python の書き換えが戻らず（`heapq.heappush(h, 0)` の後も `h` は元のまま）、包んで渡すと pandas などが
# 壊れる（計画書 6.8）。どちらも黙って違う結果になるので、書いた所で誤りにする。
import[py-int] heapq
import[py-int] py_int_collections as pc

mut h = [3, 1, 2]
heapq.heappush(h, 0)                          # 関数の引数
pc.append_twice([1], 2)                       # リテラルも
mut reg = pc.Registry()
reg.add([1, 2])                               # メソッドの引数
pc.same(a = [1], b = [2])                     # キーワード引数
pc.same(*[[1], [2]])                          # 展開した引数
mut scores = pc.make_scores()
scores["c"] = [5]                             # 要素への代入（py_dict[str, py_list[int]] の値）
mut loose = pc.untyped_list() mustbe py_list[Any]
loose.append([1])                             # 要素が Any でも Arrow の list は置けない
reg.kept = [[1] => py_list[int]]              # 属性への代入
let ok = 3 in ([1, 2, 3] => py_list[int])     # 写せば渡せる（誤りではない）
