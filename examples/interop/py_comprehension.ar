# py_comprehension.ar — Python の内包表記（リスト・集合・辞書）を使う関数を Arrow から呼ぶ
#
# 内包表記は CPython が実行する。Arrow の list / dict は `=> py_list[T]` / `=> py_dict[K, V]` で写して渡し、戻り値の
# list / set / dict は CPython の物のまま `py_list` などで受ける（表示は Python の形）。
# Arrow の内包表記は `examples/collections/comprehension.ar`。

import[py] test_modules.py_comprehension as m

mut xs = [1, 2, 3, 4]
mut ys = [10, 20]

# ── ① 基本形 ────────────────────────────────────────────────────────────
print(m.simple(xs => py_list[int]))
# [2, 4, 6, 8]

# ── ② フィルタ / フィルタ複数 ───────────────────────────────────────────
print(m.filtered(xs => py_list[int]))
# [3, 4]
print(m.two_ifs(xs => py_list[int]))
# [2, 3]

# ── ③ 多重 for（結果は平坦） ────────────────────────────────────────────
print(m.nested(xs => py_list[int], ys => py_list[int]))
# [10, 20, 20, 40, 30, 60, 40, 80]
print(m.nested_filtered(xs => py_list[int], ys => py_list[int]))
# [60, 80]

# ── ④ range / 任意の要素式 ──────────────────────────────────────────────
mut n = 3
print(m.over_range(n))
# [0, 1, 2]
print(m.expr_elt(xs => py_list[int]))
# ['1!', '2!', '3!', '4!']

# ── ⑤ 内包表記の中に内包表記 ────────────────────────────────────────────
print(m.comp_of_comp(xs => py_list[int], ys => py_list[int]))
# [[1, 2, 3, 4], [1, 2, 3, 4]]

# ── ⑥ 式なので呼び出し引数にそのまま置ける ──────────────────────────────
print(m.in_call(xs => py_list[int]))
# 3

# ── ⑦ セット内包（`set(<for 式>)` に脱糖される） ────────────────────────
#     ⚠ セットの表示順は当てにできないので、大きさとメンバシップで確認する。
print(m.set_comp_size(xs => py_list[int]))
# 2
mut zero = 0
print(m.set_comp_has(xs => py_list[int], zero))
# True
mut nine = 9
print(m.set_comp_has(xs => py_list[int], nine))
# False

# ── ⑧ 辞書内包 ──────────────────────────────────────────────────────────
print(m.dict_comp(xs => py_list[int]))
# {1: 2, 2: 4, 4: 8}
mut words: dict[str, int] = {"a": 1, "b": 2}
print(m.dict_comp_items(words => py_dict[str, int]))
# {1: 'a', 2: 'b'}
