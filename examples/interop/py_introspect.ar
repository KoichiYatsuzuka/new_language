# py_introspect.ar — issubclass / callable / getattr / hasattr / setattr を使う Python のコードと、Arrow から CPython のクラスを調べる
#
# 対になる誤りの例: py_introspect_error.ar
#
# Arrow の `issubclass(m.Puppy, m.Animal)` / `callable(m.Dog)` は CPython のクラスを受ける（CPython の `issubclass`・
# pandas_import_plan.md 3-1）。片方だけ CPython のクラスなら偽（Arrow のクラスと継承でつながらない）。
# - issubclass(C, spec): クラス同士は isinstance と同じ判定（同じクラスか派生）、組み込みの型は bool ⊂ int、組は要素ごと
# - callable(x): 関数・クラス・組み込みの関数と型・`__call__` を持つインスタンスは真

import[py-int] test_modules.py_introspect as m

print(m.kinds())          # ['bool', 'int', 'sequence of 2', 'sequence of 1', 'dict', 'Puppy (an Animal)', 'other: str']
mut p = m.Puppy("x")
mut three = 3
print(m.by_variable(p), m.by_variable(three))      # True False
print(m.subclasses())     # [True, False, True, True]
print(m.callables())      # [True, True, False, True, True]
print(m.attributes())     # ['rex', 'brown', [True, False], 'max', 'max says woof']
print(m.types())          # [True, True, False, 'copy says woof', 'bool']

print("=== from Arrow ===")
print(issubclass(m.Puppy, m.Animal), issubclass(bool, int), issubclass(int, bool))   # True True False
print(callable(len), callable(m.Dog), callable(3), callable(print))                  # True True False True
