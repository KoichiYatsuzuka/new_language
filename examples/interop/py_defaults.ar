# py_defaults.ar — 既定値のある引数を持つ Python の関数を Arrow から呼ぶ
#
# 型スタブは既定値のある引数を省略できる引数として読む（型検査が省略を許す）。既定値の式は CPython が評価する。
# ⚠ 可変の既定値は `def` のときに 1 回だけ作られて共有される（⑦・CPython の有名な罠）。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py-int] test_modules.py_defaults as m

# ── ① デフォルトを使う / 上書きする ──────────────────────────────────────
mut name = "bob"
print(m.greet(name))
# hi bob
mut greeting = "yo"
print(m.greet(name, greeting))
# yo bob

# ── ② デフォルト複数（後ろから埋まる） ──────────────────────────────────
mut a = 1
mut b = 2
mut c = 3
print(m.add(a))
# 111
print(m.add(a, b))
# 103
print(m.add(a, b, c))
# 6

# ── ③ キーワード専用引数のデフォルト ─────────────────────────────────────
print(m.kw(a))
# 134
print(m.kw(a, c=c))
# 133

# ── ④ None デフォルト ───────────────────────────────────────────────────
print(m.nonespec())
# None

# ── ⑤ タプルリテラルのデフォルト ────────────────────────────────────────
print(m.pair())
# 3

# ── ⑥ `__init__` のデフォルト ───────────────────────────────────────────
mut o = m.Box()
print(o.show())
# box=7
mut v = 9
mut o2 = m.Box(v)
print(o2.show())
# box=9

# ── ⑦ 可変の既定値は共有される（1 → 2） ──────────────────────────────────
print(m.mutdef())
# 1
print(m.mutdef())
# 2
