# async_native_call.ar — 非同期タスクの中から C の関数を呼ぶ（正例・ffi_value_exchange_plan.md 6-1）
#
# タスクのワーカーは自分のインタプリタを作るので、読み込んだ DLL の表（`native_libs`）を渡す。
# ⚠ 6-1 より前は、タスクの中で初めて呼ぶハンドル経路の関数（出力バッファ・ポインタを返す関数など）が
#   `RuntimeError: native library not loaded` になっていた。メインスレッドで一度呼んでいれば、AST に残った関数の
#   ポインタを使うので動いた（型つき経路の関数は読み込みのときに引くので動いた）。
#
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。
# 実行には examples/interop/test_modules/ffi_probe.dll が要る（build_ffi_probe.ps1）。

import[cpp-dll] test_modules.ffi_probe as fp

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

mut mng = AsyncManager(num_thread=2)
# ハンドル経路（出力バッファ）: この関数はメインスレッドでは一度も呼ばない
mng <- async->bytes:
    mut buf = bytes(8)
    fp.fp_fill(buf, 8)
    block_return buf
# ハンドル経路（ポインタを返す・受ける）
mng <- async->int:
    let h = fp.fp_handle_new()
    block_return fp.fp_handle_get(h)
# 型つき経路
mng <- async->int:
    block_return fp.fp_len("abcd".encode())
mng.wait_for_finish()

let errors = mng.error_list
check("no task failed", errors[0] is None and errors[1] is None and errors[2] is None)
let results = mng.results
check("output buffer filled in a task", (results[0] mustbe bytes)[0:6] == "filled".encode())
check("pointer round trip in a task", results[1] == 4242)
check("typed path in a task", results[2] == 4)
