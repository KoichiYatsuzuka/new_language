# py_function_attrs.ar — Python の関数の値の __name__ / __qualname__ / __doc__（CPython で実行する）
#
# デコレータがよく使う `func.__name__`、関数の中の関数の `outer.<locals>.inner`、メソッドの `C.m`、
# property の getter（`p.fget.__name__` は元の名前 `celsius`）、ラムダの `<lambda>` が CPython と同じになる。
#
# 出力（CPython）:
#   3 ['add']
#   wrapper logged.<locals>.wrapper
#   logged Record each call under the function's name.
#   step make_counter.<locals>.step None
#   3 6 13 make_adder.<locals>.adder
#   <lambda> run.<locals>.<lambda>
#   Temperature.describe describe 20Temperature.describe.<locals>.unit
#   celsius Temperature.celsius Degrees Celsius.
#   celsius Temperature.celsius
#   run run None

import[py] test_modules.py_function_attrs as fa

