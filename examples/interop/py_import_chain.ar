# py_import_chain.ar — Python のモジュールの**中にある import**（`chain_top.py` → `chain_util.py` → `chain_leaf.py`）
#
# 中の import は CPython が実行する（探索先は `sys.path`。`ar_config.json` の `python.search_paths` = `py_libs` を含む）。
# 型スタブは `from chain_leaf import double as dbl` の再エクスポートもたどる（pandas_import_plan.md 1-3）。

import[py] chain_top

# ── ① 2 段先の定数まで届く（モジュール本体の実行順） ──────────────────────
#    `chain_leaf.LEAF_MARKER` → `chain_util.UTIL_MARKER` → `chain_top.TOP_MARKER`
print(chain_top.TOP_MARKER)

# ── ② `from ... import x as y` 経由の呼び出し（`dbl` = `chain_leaf.double`） ──
# ── ③ `import m` 経由の呼び出し（`chain_leaf.double`） ──────────────────────
#    run(x) = quad(x) + leaf_of(x) = (x*2)*2 + x*2
mut n = 3
print(chain_top.run(n))
