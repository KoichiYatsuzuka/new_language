# py_multi_assign.ar — 複数代入（`a = b = c`）とタプルのアンパック代入（`a, b = t` / `a, *rest = t` / 入れ子）を使う関数を Arrow から呼ぶ
#
# 代入は CPython が実行する（右辺は 1 回だけ評価・`a = b = []` は同じリスト・入れ子の `a, (b, c) = t`）。
# Arrow の list は `=> py_list[T]` で写して渡す。

import[py-int] test_modules.py_multi_assign as m

# ── ① 複数代入 ──────────────────────────────────────────────────────────
print(m.chain())
# (5, 5)

# ── ② 右辺は 1 回だけ評価される（一時変数の効果） ───────────────────────
print(m.chain_once())
# (1, 1, 1)

# ── ③ 2 要素の分解 ──────────────────────────────────────────────────────
mut t2 = (1, 2)
print(m.unpack2(t2))
# (1, 2)

# ── ④ 3 要素の分解 ──────────────────────────────────────────────────────
mut t3 = (1, 2, 3)
print(m.unpack3(t3))
# 6

# ── ⑤ `*rest`（末尾のみ・スライスへ脱糖） ──────────────────────────────
print(m.unpack_rest(t3))
# (1, 2)

# ── ⑥ リスト形のターゲット ──────────────────────────────────────────────
mut l2 = [7, 8]
print(m.unpack_list(l2 => py_list[int]))
# (7, 8)

# ── ⑦ スワップ（右辺のタプルを 1 回だけ作る） ──────────────────────────
mut a = 1
mut b = 2
print(m.swap(a, b))
# (2, 1)

# ── ⑧ ループ本体の中（補助文が毎周回きちんと置かれる） ──────────────────
mut pairs = [(1, 2), (3, 4)]
print(m.in_loop(pairs => py_list[tuple[int, int]]))
# [3, 7]

# ── ⑨ while 本体の中 ────────────────────────────────────────────────────
mut t = (5, 6)
mut n = 3
print(m.in_while(t, n))
# 33

# ── ⑩ 添字ターゲットへの分解 ────────────────────────────────────────────
print(m.attr_targets(t2))
# {'a': 1, 'b': 2}

# ── ⑪ 入れ子のアンパック ────────────────────────────────────────────────
mut tn = (1, (2, 3))
print(m.nested(tn))
# (1, 2, 3)

# ── ⑫ 3 段の入れ子 ──────────────────────────────────────────────────────
mut td = (1, (2, (3, 4)))
print(m.nested_deep(td))
# (1, 2, 3, 4)

# ── ⑬ 先頭が入れ子 ──────────────────────────────────────────────────────
mut th = ((1, 2), 3)
print(m.nested_head(th))
# (1, 2, 3)

# ── ⑭ 入れ子の中の `*rest` ──────────────────────────────────────────────
mut tr = (1, (2, 3, 4))
print(m.nested_rest(tr))
# (1, 2, 2)
