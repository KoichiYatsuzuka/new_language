# py_mutarg.ar — Python の関数へ、変数・リテラル・`mut` の要素・戻り値を渡す
#
# Python の関数の引数は型スタブで不変（`mut` の実引数を求めない）なので、どれも渡せる。Arrow の list は
# `=> py_list[int]` で写して渡す。

import[py] test_modules.py_mutarg as m

mut n = 5
mut xs = [1, 2, 3]

# ── ① mut 変数（従来から通っていた形） ──────────────────────────────────
print(m.take(n))
# 5

# ── ② リテラル ──────────────────────────────────────────────────────────
print(m.take(5))
# 5

# ── ③ mut コレクションの要素 ─────────────────────────────────────────────
print(m.take(xs[0]))
# 1

# ── ④ 呼び出しの戻り値 ──────────────────────────────────────────────────
print(m.take(m.take(n)))
# 5

# ── ⑤ リテラルのコレクションを直接渡す ──────────────────────────────────
print(m.scale(2, [1, 2, 3] => py_list[int]))
# [2, 4, 6]
