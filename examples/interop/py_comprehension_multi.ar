# py_comprehension_multi.ar — 内包表記の多ターゲット（`[k for k, v in d.items()]`）を使う関数を Arrow から呼ぶ
#
# 内包表記は CPython が実行する。Arrow の側の多ターゲットは `examples/collections/comprehension_multi_target.ar`。

import[py-int] test_modules.py_comprehension_multi as m

mut d = {"a": 1, "b": 2}
mut pairs = [(1, 10), (2, 20)]
mut xs = ["p", "q"]

# ── ① キーだけ取る ──────────────────────────────────────────────────────
print(m.keys(d => py_dict[str, int]))
# ['a', 'b']

# ── ② 両方使う ──────────────────────────────────────────────────────────
print(m.joined(d => py_dict[str, int]))
# ['a1', 'b2']

# ── ③ フィルタ付き ──────────────────────────────────────────────────────
print(m.filt(pairs => py_list[tuple[int, int]]))
# [2]

# ── ④ セット内包 ────────────────────────────────────────────────────────
print(m.sset(d => py_dict[str, int]))
# 2

# ── ⑤ enumerate ─────────────────────────────────────────────────────────
print(m.with_enumerate(xs => py_list[str]))
# ['0p', '1q']
