# native_builtins.ar — コンパイル済みコードから組み込み関数を呼ぶ（native_object_access_plan.md 1-3）
#
# モジュールは .arc（コンパイル済み）を読む。非コンパイル（.ar）でも同じ値になること。
#   1. cargo run --release -- --compile examples/interop/test_modules/native_builtins_module.ar
#   2. cargo run --release -- examples/interop/native_builtins.ar
#
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。

import test_modules.native_builtins_module as m

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

check("range in for", m.sum_range(5) == 10)
check("enumerate in for", m.count_enumerate([4, 5, 6]) == 3)
check("zip in for", m.count_zip([1, 2], [3, 4, 5]) == 2)
check("set in for", m.count_set({1, 2, 4}) == 7)
check("repr", m.show(42) == "42")
check("print and len", m.say("hello from native") == 17)
check("getenv with a default", m.env_or("AR_NATIVE_BUILTINS_SURELY_UNSET", "fallback") == "fallback")
