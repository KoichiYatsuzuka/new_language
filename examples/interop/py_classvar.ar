# py_classvar.ar — Python のクラス変数（全インスタンスで共有する可変の属性）を Arrow から読み書きする
#
# Python のクラス属性は**可変・全インスタンス共有**。`m.Counter.count = 100` は CPython の `setattr`（2-9）。
# インスタンスの `self.x = ...` はクラス属性を隠すインスタンス属性を新しく作る（⑦: `self.count` は 99、
# `Counter.count` は 102 のまま）。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py] test_modules.py_classvar as m

# ── ① クラス経由の読み取り ──────────────────────────────────────────────
print(m.Counter.count)
# 0
print(m.Counter.label)
# c

# ── ② ドライバ側からクラス変数を書き換える ──────────────────────────────
m.Counter.count = 100
print(m.Counter.count)
# 100

# ── ③ メソッド内からクラス経由で読み書き（全インスタンスで共有） ────────
mut a = m.Counter(1)
mut b = m.Counter(2)
print(a.bump())
# 101
print(b.bump())
# 102
print(a.read())
# 102
print(m.Counter.count)
# 102

# ── ④ `self` 経由の読み取りはクラス変数に落ちる ─────────────────────────
print(a.via_self())
# 102

# ── ⑤ 可変オブジェクトのクラス変数は中身が共有される ────────────────────
mut x = 7
print(a.push(x))
# [7]
mut y = 8
print(b.push(y))
# [7, 8]
print(m.Counter.items)
# [7, 8]

# ── ⑥ 注釈つきクラス変数 ────────────────────────────────────────────────
print(m.Typed.n)
# 5
mut t = m.Typed()
print(t.get())
# 5

# ── ⑦ `self.x = ...` はクラス属性を隠すインスタンス属性を作る ──────────────
print(a.shadow())
# (99, 102)
print(m.Counter.count)
# 102
