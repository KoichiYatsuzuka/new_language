# py_subscript.ar — Python の添字・キーへの代入（`d[k] = v` / `xs[i] += v` / 入れ子の `box["k"][0] = v`）を使う関数を Arrow から呼ぶ
#
# 代入は CPython が実行する。Arrow から CPython の物の添字へ書くのは `py_int_values.ar`。

import[py-int] test_modules.py_subscript as m

# ── ① dict のキー代入 / 読んで書き戻し ──────────────────────────────────
print(m.dict_set())
# {'a': 11, 'b': 5}

# ── ② list の添字代入 ───────────────────────────────────────────────────
print(m.list_set())
# [99, 2, 3]

# ── ③ 複合代入 `+=` / `*=` / `-=` ───────────────────────────────────────
print(m.aug_list())
# [1, 9, 9]
print(m.aug_dict())
# {'n': 6}

# ── ④ 入れ子の添字代入 ──────────────────────────────────────────────────
print(m.nested())
# {'k': [42, 10]}

# ── ⑤ 属性 + 添字（`self.data[i] += 1`） ────────────────────────────────
mut h = m.Holder()
mut i = 1
print(h.bump(i))
# [0, 1]
print(m.attr_and_index(h))
# [7, 1]

# ── ⑥ ループの中で dict を組み立てる ────────────────────────────────────
mut n = 3
print(m.in_loop(n))
# {0: 0, 1: 1, 2: 4}
