# cpp_struct_by_value_layout_error.ar — C と同じレイアウトが分からない構造体は値で受け渡せない（負例・1-3）
#
# `Rgba8` は `unsigned char` を 4 つ並べた 4 バイトの構造体。Arrow の C 型の扱い（`CType::Int`）は
# 4 バイト未満の整数を 4 バイトとして扱うので、以前は 16 バイトの構造体として読み書きしていた
# （黙って壊れた値になる）。今はヘッダ解析がこの構造体を「レイアウト不明」とみなし、値で受け渡す関数を
# 生成しない。呼ぶとエラーで止まる（黙って壊れた値を渡さない）。
#
# 実行には examples/interop/test_modules/ffi_probe.dll が要る（build_ffi_probe.ps1）。
# 対になる正例: cpp_dll_struct_by_value.ar

import[cpp-dll] test_modules.ffi_probe as fp

let c = fp.fp_make_rgba(1, 2, 3, 4)
print("unreachable:", c)
