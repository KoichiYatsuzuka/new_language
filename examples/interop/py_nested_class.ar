# py_nested_class.ar — Python のクラス本体の中のクラス（入れ子のクラス）を Arrow から使う
#
# 型スタブは入れ子のクラスを Python の __qualname__（`Tree.Node`）の名前で持ち上げ、外側のクラスにはその型の値の属性
# （`Node: type[Tree.Node]`）を置く（pandas_import_plan.md 3-1）。⇒ `m.Tree.Node(..)` / `t.Leaf(..)`（インスタンスから）/
# `m.Config.Section.Entry(..)`（入れ子の入れ子）が引ける。最上位の `Node` や別のクラスの同名の入れ子（`Graph.Node`）とは
# 別の型。入れ子のクラスの基底は同じ本体の兄弟を先に引く（`class Leaf(Node):` の `Node` は `Tree.Node`・Python と同じ）。
# ⚠ インスタンスは CPython の物なので `mut` で持つ（D-3）。

import[py] test_modules.py_nested_class as m

# ── ① Python の中で使う ────────────────────────────────────────────────
print(m.summary())
# top-level Node, Tree.Node, Tree.Leaf of 5, Graph.Node

# ── ② Arrow から入れ子のクラスを作る ───────────────────────────────────
mut v = 7
mut n = m.Tree.Node(v)
print(n.kind())
# Tree.Node
print(n.value)
# 7

# ── ③ インスタンス経由（self.Leaf と同じ形）───────────────────────────
mut t = m.Tree()
mut w = 3
mut leaf = t.Leaf(w)
print(leaf.kind())
# Tree.Leaf of 3

# ── ④ 3 段の入れ子 ─────────────────────────────────────────────────────
mut key = "port"
mut e = m.Config.Section.Entry(key)
print(e.key)
# port
