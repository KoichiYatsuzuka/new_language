# py_decorators.ar — デコレータを使う Python のモジュール（関数・クラス・`@staticmethod` / `@classmethod` / `@abstractmethod`）
#
# デコレータは CPython が実行する。型スタブは `@staticmethod` / `@classmethod` を静的メソッドとして読み（`@classmethod`
# の `cls` は呼び出しで渡さない）、Python と同じくインスタンスからも呼べる。
# ⚠ `@classmethod` の戻り値の型は注釈（`-> "Box"`）から取る（注釈が無ければ `Any`）。

import[py] test_modules.py_decorators as d

# ── 定義時に走るデコレータの副作用 ───────────────────────────────────────
# import の時点で以下が出力済み:
#   registered   … @banner
#   B / A        … @tag_a @tag_b（下から適用）
#   marked       … @mark（クラスデコレータ）

# ── ① 元の関数をそのまま返すデコレータ ──────────────────────────────────
mut name = "bob"
print(d.hello(name))
# hello bob

# ── ② スタックされたデコレータ ───────────────────────────────────────────
print(d.stacked())
# stacked

# ── ③ 関数を別の関数へ差し替えるデコレータ ──────────────────────────────
#     twice(3) は本来 6 だが、@always42 が差し替えているので 42。
mut n = 3
print(d.twice(n))
# 42

# ── ④ クラスデコレータ（@mark はクラスをそのまま返す） ──────────────────
mut v = 7
mut b = d.Box(v)
print(b.get())
# 7

# ── ⑤ @staticmethod → `static fn`（クラス経由で呼ぶ） ────────────────────
mut a = 10
print(d.Box.bump(a))
# 11

# ── ⑥ @classmethod → `class_method fn`（第 1 引数にクラス自身が渡る） ────
mut w = 99
mut b2 = d.Box.of(w)
print(b2.get())
# 99

# ── ⑦ @abstractmethod は抽象フラグに振り替えるだけ（本体はそのまま動く） ─
print(b.described())
# box
