# cs_proc_values.ar — import[cs-proc] で C# の値を宣言どおりの型で受け渡す（ffi_value_exchange_plan.md 2-1）
#
# 以前のブリッジは戻り値の型を見ずにタグだけで読んでいて、次のように黙って違う値になっていた:
#   - C# のオブジェクトを返すメソッド（`Person make_person(..)`）→ 整数（C# 側のハンドル番号）
#   - `char` / `byte` / `short` / `ushort` / `ulong` の戻り値 → 整数（ホストがオブジェクトとして控えた番号）
#   - `string?` の null → 型スタブは `str` なのに `None`（`str` の変数に `None` が入る）
#   - `long?` の引数 → C# 側で変換に失敗
# 今は型スタブの宣言で読む。`string?` / `Person?` / `long?` は `Option[...]`（C# の nullable 注釈を読む）、
# クラスは `CsObject`、`ulong` の 2^63 以上は OverflowError、`object` で宣言された値のうち中身のクラスが
# 分からないもの・null にならないはずの戻り値の null は TypeError。
# コレクションを受け渡すメソッドは静的エラー（cs_proc_unsupported_signature_error.ar）。
#
# ⚠ ゲートの多くは exit code しか見ないので、期待値と違えば raise する。
# 非 ASCII の文字列の受け渡しは cs_proc_utf8.ar（2-2）。
#
# 実行には examples/interop/cs_probe/cs_probe.exe と cs_probe.dll が要る（build_cs_probe.ps1）。

import[cs-proc] cs_probe as cp

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

# ── クラスの戻り値は CsObject（以前は整数）────────────────────────────────────
let p = cp.Probe.make_person("bob")
check("make_person is a C# object", p.get_name() == "bob")
check("method on it", p.hello() == "I am bob")
let q = p.older(5)
check("object returned by an instance method", q.get_name() == "bob+")
check("pass it back to C#", cp.Probe.describe(q) == "bob+")
check("type test on a C# object", p is Person)

# ── nullable 注釈（`string?` / `Person?` / `long?`）は Option[...] ───────────────
check("string? with a value", (cp.Probe.maybe(True) mustbe str) == "yes")
check("string? null is None", cp.Probe.maybe(False) is None)
check("long? with a value", (cp.Probe.maybe_num(True) mustbe int) == 7)
check("long? null is None", cp.Probe.maybe_num(False) is None)
let found = cp.Probe.find("amy")
match found:
    case None:
        raise ValueError("find(amy) returned None")
    case _:
        check("Person? with a value", (found mustbe Person).get_name() == "amy")
check("Person? null is None", cp.Probe.find("nobody") is None)
check("instance method returning Person?", p.best_friend() is None)
check("Person? argument: None", cp.Probe.describe_opt(None) == "none")
check("Person? argument: object", cp.Probe.describe_opt(p) == "bob")
check("long? argument: None", cp.Probe.add_opt(1, None) == 101)
check("long? argument: value", cp.Probe.add_opt(1, 2) == 3)

# ── 小さな値型は値のまま（以前はハンドル番号）──────────────────────────────────
check("char return", cp.Probe.initial("abc") == "a")
check("char argument", cp.Probe.twice("z") == "zz")
check("byte return", cp.Probe.low_byte(300) == 44)
check("short return", cp.Probe.neg_short() == -12)
check("ushort return", cp.Probe.big_ushort() == 65000)
check("ulong return", cp.Probe.small_ulong() == 9)
mut overflow = False
try:
    let big = cp.Probe.huge_ulong()
    print("unreachable:", big)
except OverflowError as e:
    overflow = True
    print("ulong 2^64-1: OverflowError: " + e.message)
check("ulong >= 2^63 is OverflowError", overflow)

# ── object で宣言された値 ─────────────────────────────────────────────────────
check("object holding a string", (cp.Probe.any_str() mustbe str) == "object string")
mut unknown = False
try:
    let o = cp.Probe.any_obj()
    print("unreachable:", o)
except TypeError as e:
    unknown = True
    print("object of an unknown class: TypeError: " + e.message)
check("object of an unknown class is TypeError", unknown)

# ── null にならないはずの戻り値の null ────────────────────────────────────────
mut broken = False
try:
    let s = cp.Probe.broken_contract()
    print("unreachable:", s)
except TypeError as e:
    broken = True
    print("null from a non-nullable string: TypeError: " + e.message)
check("null for `string` is TypeError", broken)

# ── 関数の中・ループの中から（同じ呼び出し点を何度も通る）──────────────────────
fn names(let n: int) -> str:
    mut out = ""
    mut i = 0
    while i < n:
        let who = cp.Probe.make_person("p" + str(i))
        out = out + who.get_name()
        i += 1
    return out

check("objects in a loop", names(3) == "p0p1p2")
