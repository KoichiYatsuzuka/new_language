# py_bytes.ar — Python の b".." リテラルと bytes / frozenset を使うモジュールを CPython で動かし、bytes を受ける
#
# bytes は不変なので境界で Arrow の bytes に写す（`-> bytes` の注釈が型になる）。
# pb.run() の出力（CPython）:
#   b'\x89PNG\r\n' 6 True False
#   [b'name=caf\xc3\xa9', b'tags=a,b'] ['name', 'tags']
#   café café
#   UnicodeDecodeError: 'utf-8' codec can't decode byte 0xe9 in position 3: unexpected end of data
#   [b'a', b'b'] True tags

import[py] test_modules.py_bytes as pb

let tail: bytes = pb.run()
print(tail, tail.hex())
