# py_ellipsis_value.ar — Python の値の `...`（Ellipsis）と Arrow の `Ellipsis`
#
# 値の `...` は唯一の値 `Ellipsis`（クラス `ellipsis` の唯一のインスタンス）。境界を越えても同じ値で、Python の `...` は
# Arrow の `Ellipsis` に、Arrow の `Ellipsis` は Python の `...` になる（`is` / `===` で同じ物）。表示は `Ellipsis`。
#
# pe.run() の出力（CPython）:
#   True True False True
#   True False False True
#   True True True True 1
#   Ellipsis Ellipsis Ellipsis [Ellipsis, 1] ellipsis True
#   True True True True
#   TypeError: EllipsisType takes no arguments
#   AttributeError: 'ellipsis' object has no attribute 'x'
#
# ⚠ `pe.pick()` の型は `Any`（注釈が無い）。`Any` の値に `===` は使えないので、同じ物かは `id()` で比べる。

import[py] test_modules.py_ellipsis_value as pe

pe.run()

fn check(let ok: bool, let what: str) -> None:
    if not ok:
        raise ValueError(f"failed: {what}")

# Arrow のソースからも同じ値
let e = Ellipsis
mut picked = pe.pick()
check(id(picked) == id(e) and id(picked) == id(Ellipsis), "same object as Python's ...")
mut given = pe.pick(None)
check(id(given) != id(e), "None is not Ellipsis")
mut back = pe.pick(e)
check(id(back) == id(e), "Arrow's Ellipsis comes back as itself")
let es = [e, Ellipsis]
check(es[0] === es[1] and es[0] == es[1], "only one Ellipsis")
check(repr(e) == "Ellipsis" and str(e) == "Ellipsis", "display")
check(e is object, "Ellipsis is an object")
print("arrow side ok")
