# cpp_default_args.ar — C の既定値（DEFAULTPARAM( = x ) / C++ の `= x`）の引数を省略する（正例・ffi_value_exchange_plan.md 7-13）
#
# DxLib などのヘッダは既定値を `int b DEFAULTPARAM( = -1 )` の形で書く（C++ では `= -1`、C では何も無い）。
#   - 既定値を読めた末尾の引数は省略でき、省略した引数には**宣言した既定値**が入る（-1 / 0.5 / NULL）
#   - 既定値はその引数の型で読む: 整数（10 進・16 進・TRUE / FALSE）・浮動小数（1.5f）・bool・ポインタの NULL
#   - 読めない既定値（マクロ名・式）の引数は省略できない（負例 cpp_default_args_error.ar）
# ⚠ 7-13 より前は型スタブが既定値を持たず省略が静的エラーで、実行時は省略した引数を一律に 0 / NULL で埋めていた
#   （`DEFAULTPARAM( = -1 )` も 0 になり、7-12 以降は数値の引数が TypeError になった）。
#
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。
# 実行には examples/interop/test_modules/ffi_probe.dll が要る（build_ffi_probe.ps1）。
# 対になる負例: cpp_default_args_error.ar

import[cpp-dll] test_modules.ffi_probe as fp

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

# fp_defaults(a, b = -1, c = 0.5, s = NULL) は a + b + c + (s ? strlen(s) : 100)
check("all defaults: b = -1, c = 0.5, s = NULL", fp.fp_defaults(1) == 100.5)
check("b given", fp.fp_defaults(1, 2) == 103.5)
check("b and c given", fp.fp_defaults(1, 2, 3.0) == 106.0)
check("nothing omitted", fp.fp_defaults(1, 2, 3.0, "ab".encode()) == 8.0)
# 読めない既定値の引数は書けば使える
check("a macro default is passed explicitly", fp.fp_mode(1, 3) == 4)
