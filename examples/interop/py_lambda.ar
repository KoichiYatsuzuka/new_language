# py_lambda.ar — lambda を使う Python の関数（`sorted(key=lambda ..)`・捕捉・入れ子・既定値つき）を Arrow から呼ぶ
#
# lambda は CPython が実行する。Arrow へ返した lambda は CPython の呼べる物（`Any`）で、Arrow から呼べる。

import[py] test_modules.py_lambda as m

mut x = 5

# ── ① 変数に入れて呼ぶ ──────────────────────────────────────────────────
print(m.simple(x))
# 6

# ── ② クロージャ捕捉 ────────────────────────────────────────────────────
print(m.capture(x))
# 15

# ── ③ 呼び出し引数の中（最頻出の位置） ──────────────────────────────────
print(m.as_arg(x))
# 15

# ── ④ デフォルト引数つき lambda ─────────────────────────────────────────
print(m.with_default(x))
# (15, 6)

# ── ⑤ 入れ子の lambda（内側が外側の本体へ入る） ─────────────────────────
print(m.nested(x))
# 105

# ── ⑥ 同じ文脈に 2 つ ───────────────────────────────────────────────────
print(m.two_in_one(x))
# (6, 10)

# ── ⑦ lambda をデフォルト値に（`def` の前へ持ち上がる） ─────────────────
print(m.as_default())
# 6
