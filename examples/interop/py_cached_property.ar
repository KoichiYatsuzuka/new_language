# py_cached_property.ar — Python の functools.cached_property を持つクラスを Arrow から読む
#
# `@cached_property def area(self)` は初めて読んだときだけ計算し、以後はインスタンスの `__dict__` に覚えた値を返す
# （`obj.area = v` もそこへ入る）。Arrow からの読み書きも CPython の `getattr` / `setattr` なので同じ。
#
# cp.run() の出力（CPython）:
#   12.0 12.0 27.0 [2, 3]
#   ['round', 'small'] ['round']
#   1.5 [2, 3]
#   cached_property area Area, computed once per instance. area
#   True

import[py-int] test_modules.py_cached_property as cp

cp.run()

# Arrow からも読める。getter の戻り値の注釈（`-> float`）が型になる（タスク 6-8 と同じ）。
mut c = cp.Circle(10)
print(c.area * 2.0)
print(c.area, cp.CALLS)
c.area = 0.5
print(c.area)
