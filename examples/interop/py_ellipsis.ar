# py_ellipsis.ar — `...`（Ellipsis）を使う Python のモジュールを CPython で動かす
#
# 文としての `...`（スタブ本体のプレースホルダ）は何もせず、値としての `...` は CPython の `Ellipsis`
# （Arrow の `Ellipsis` と同じ値・py_ellipsis_value.ar）。
# ⚠ 型を書いたスタブ本体（`def stub_typed(x: int) -> int: ...`）は CPython では `None` を返すので、
#   戻り値の境界の検査が `FfiTypeError` にする（型スタブの注釈と違う値は通さない）。

import[py-int] test_modules.py_ellipsis as m

# ── ① 関数のスタブ本体（戻り値は None） ────────────────────────────────
print(m.stub())
# None

mut n = 5
try:
    print(m.stub_typed(n))
except FfiTypeError:
    print("FfiTypeError: declared int, returned None")
# FfiTypeError: declared int, returned None

# ── ② クラスの空本体 / メソッドのスタブ ────────────────────────────────
mut c = m.C()
print("C ok")
# C ok

mut d = m.D()
print(d.m())
# None

# ── ③ `if` の枝のプレースホルダ ─────────────────────────────────────────
print(m.guarded(n))
# pos

mut neg = -1
print(m.guarded(neg))
# neg

# ── ④ ループ本体のプレースホルダ ────────────────────────────────────────
mut xs = [1, 2]
print(m.loop_body(xs => py_list[int]))
# done

# ── ⑤ 値位置の `...` は `Ellipsis` ────────────────────────────────────────
print(m.value_pos())
# Ellipsis
