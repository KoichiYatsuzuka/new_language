# py_int_instance_arg_error.ar — `let` の Arrow のインスタンスは Python から書き換えられない（負例・pandas_import_plan.md の 2-6）
#
# Arrow のインスタンスは写さずに Python へ渡る（2-6）。`let` の変数から渡した物は読むだけの包みで、属性への代入と
# `mut self` のメソッドは Python の TypeError になる（`let` の値は変わらない）。書き換えさせるなら `mut` の変数を渡す。
# ⚠ 2-6 より前は、Arrow のインスタンスは Python へ渡せなかった（`cannot pass an Arrow value of type 'Point' to Python`）。
#
# 対になる正例: py_int_arrow_objects.ar

import[py-int] py_int_arrow_objects as po

class Point:
    mut x: int
    mut y: int

    fn shift(mut self, let dx: int) -> None:
        self.x = self.x + dx

let p = Point(1, 2)
print("read:", po.as_key(p))
po.shift_it(p)
print("unreachable:", p.x)
