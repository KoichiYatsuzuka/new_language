# cpp_ptr_protocol_pending_error.ar — ArPtrProtocol を返す C の関数はまだ呼べない（負例・ffi_value_exchange_plan.md 4-2・4-4）
#
# ヘッダ解析は ArPtrProtocol（bridge/ptr_protocol/ar_ptr_protocol.h・仕様は docs/ptr_protocol.md）を引数・戻り値・
# 構造体のフィールドで認識する。引数（Ptr / None を渡す）は 4-4 で使えるようになった（cpp_typed_pointers.ar）。
# 戻り値の受け取りは 4-5 で入るので、今は返す関数を使った箇所が理由つきの静的エラーになる。
# ⚠ 4-5 で受け取りが入ったら、この例題は正例に置き換える。
# 実行には examples/interop/test_modules/ffi_probe.dll が要る（build_ffi_probe.ps1）。

import[cpp-dll] test_modules.ffi_probe as fp

let p = fp.fp_squares(3)
print("unreachable:", fp.fp_protocol_sum(p))
