# py_int_cast_required_runtime_error.ar — 型で分からない所で Arrow の list を Python へ渡すと実行時の TypeError
# （pandas_import_plan.md の D-12・2-11）
#
# `apply(f, x)` は注釈の無い Python の関数で、Arrow の関数 `pair` を呼ぶ。`pair` が返す Arrow の list は Python へ渡る値だが、
# 呼ばれるのは Python の中なので静的には分からない。境界で TypeError（`=> py_list[int]` で返せと言う）になる。
# 対になる正例: `pair_ok` は `=> py_list[int]` で返すので通る。
import[py-int] py_int_callbacks as pc

fn pair_ok(let x: int) -> py_list[int]:
    return [x, x] => py_list[int]

fn pair(let x: int) -> list[int]:
    return [x, x]

mut good = pc.apply(pair_ok, 3)
print("with a cast:", good)
mut bad = pc.apply(pair, 3)
print("unreachable:", bad)
