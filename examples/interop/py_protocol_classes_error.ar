# py_protocol_classes_error.ar — Python の protocol を満たさない物は静的な誤り（pandas_import_plan.md の 6-9）
#
# `SupportsRead[str]` は `read(n) -> str` を要求する。何も持たない `Nothing` は渡せない。戻り値の型も型引数で決まる
# （`take` の戻り値は `str`）。
#
# 期待されるエラー（StaticTypeError・実行の前）:
#   argument 0 of 'test_modules.py_protocol_classes.take' expects 'test_modules.py_protocol_classes.SupportsRead[str]' but got 'test_modules.py_protocol_classes.Nothing'
#   'n' is declared 'int' but initialized with 'str'

import[py] test_modules.py_protocol_classes as m

mut z = m.nothing()
print(m.take(z, 1))
mut r = m.reader()
let n: int = m.take(r, 2)
