# py_decorator_forward.ar — デコレータの転送パターン（`*args` / `**kwargs` で包んだ関数を返す）を Arrow から呼ぶ
#
# Python で最頻出の形: `def deco(f): def wrapper(*args, **kwargs): return f(*args, **kwargs)`。
# 包まれた関数・クロージャ・関数値を受ける関数は CPython が実行し、Arrow は戻り値と関数値（`inc`・`m.triple`）を受けて呼ぶ。

import[py-int] test_modules.py_decorator_forward as m

mut n = 5

# ── ① デコレータ（値を 2 倍にして返すラッパ） ──────────────────────────
print(m.triple(n))
# 30

# ── ② スタックしたデコレータ（下から適用） ──────────────────────────────
mut four = 4
print(m.stacked(four))
# [10]

# ── ③ int を捕捉するクロージャ（B3 で直っていた分） ────────────────────
mut ten = 10
mut inc = m.counter(ten)
print(inc(n))
# 15

# ── ④ 関数値を引数で受けて呼ぶ（入れ子なし） ────────────────────────────
mut one = 1
print(m.apply_twice(m.triple, one))
# 36
