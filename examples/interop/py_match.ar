# py_match.ar — Python の `match` 文を使う関数を Arrow から呼ぶ
#
# `match` は CPython が実行する（当たった 1 本だけ走る・どれにも当たらず `_` も無ければ何もしない）。

import[py] test_modules.py_match as m

# ── ① 整数リテラル ──────────────────────────────────────────────────────
mut a = 0
mut b = 1
mut c = 7
print(m.classify(a))
print(m.classify(b))
print(m.classify(c))
# zero
# one
# many

# ── ② 文字列リテラル ────────────────────────────────────────────────────
mut s = "b"
mut t = "z"
print(m.word(s))
print(m.word(t))
# B
# ?

# ── ③ シングルトン（None / True / False） ───────────────────────────────
print(m.singleton(None))
mut yes = True
print(m.singleton(yes))
# none
# true

# ── ④ `_` が無く、どれにも当たらない（何もしない） ──────────────────────
print(m.no_default(c))
# untouched
