# py_varargs.ar — `*args` / `**kwargs` を受ける Python の関数を Arrow から呼ぶ
#
# 型スタブは `*args` / `**kwargs` を持つ関数の引数を検査しない（位置引数の個数・キーワードの名前が開いている）。
# 束縛は CPython が行う（余った位置引数はタプル・余ったキーワード引数は dict・1 個も無くても空）。

import[py-int] test_modules.py_varargs as m

mut a = 1
mut b = 2
mut c = 3

# ── ① `*args` の基本 ────────────────────────────────────────────────────
print(m.va(a, b, c))
# [1, 2, 3]
print(m.va())
# []
print(m.va_len(a, b))
# 2
print(m.va_index(a, b))
# 1
print(m.va_sum(a, b, c))
# 6

# ── ② 通常引数 + `*args` ────────────────────────────────────────────────
print(m.mixed(a, b, c))
# 6
print(m.mixed(a))
# 1

# ── ③ `**kwargs` の基本 ─────────────────────────────────────────────────
print(m.kw(x=a, y=b))
# {'x': 1, 'y': 2}
print(m.kw())
# {}          ← 1 個も渡さなくても空 dict が束縛される
print(m.kw_len(x=a))
# 1
mut k = "x"
print(m.kw_get(k, x=b))
# 2
print(m.kw_keys(x=a, y=b))
# ['x', 'y']

# ── ④ 両方いっぺんに ────────────────────────────────────────────────────
print(m.both(a, b, c, z=a))
# (1, 5, {'z': 1})

# ── ⑤ メソッドでも同じ ──────────────────────────────────────────────────
mut o = m.C(a, b)
print(o.xs)
# [1, 2]
print(o.m(c))
# [1, 2, 3]
print(o.k(p=a))
# {'p': 1}

# ── ⑥ `*args` の中身は tuple ─────────────────────────────────────────────
#     Arrow の関数の可変長（`let ...: T`）はリスト。
print(m.raw(a, b))
# (1, 2)

