# py_del_warn.ar — `del <name>` と例外の構文（`try` / `except` / 素の `except:`）を使う関数を Arrow から呼ぶ
#
# `del x`（束縛の削除）も CPython が実行する。

import[py-int] test_modules.py_del_warn as m

mut n = 5

# ── ① del <name> は無視され、残りはそのまま動く ─────────────────────────
print(m.del_name(n))
# 5

# ── ② 素の try / except E as e / finally は通り続ける ───────────────────
print(m.plain_try(n))
# ok

mut neg = -1
print(m.plain_try(neg))
# caught

# ── ③ 裸の except: も通り続ける ─────────────────────────────────────────
print(m.bare_except())
# bare
