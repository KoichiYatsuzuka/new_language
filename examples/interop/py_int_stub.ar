# py_int_stub.ar — **同梱 `.pyi` スタブ**による静的型予測（BYTECODE_VM_PLAN #19 / 群6）。
#
# ⚠⚠ **これは以前まったく検査されていなかった**。`time` / `math` は CPython の
#   **C 組み込みモジュール**で `.py` が存在しないので、`Parser::python_search_dirs()` が
#   stdlib まで辿っても必ず空振りし、`load_python_interface_module` は**空の body**
#   （＝型検査を丸ごと放棄）を返していた。
#   ⇒ `let s: str = math.sqrt(2.0)` が**黙って通って**いた。
#
# ⚠ **検索ディレクトリを増やす案は採らなかった**（群6 S2）:
#   ① `src/` に `current_exe()` の使用は 0 箇所 → `cargo run` と配布で相対位置が変わる
#   ② `python_search_dirs()` に 1 つ足すと**解決 1 回あたり `exists()` が 4 回**増える
#      （#69 が「syscall 連打が `interp_init` の 48〜53%」と実測して遅延化した場所）
#   ⇒ `include_str!` で**バイナリに埋め込む**。syscall ゼロ・パス依存ゼロ。
#
# ⚠ **利用者のファイルが常に勝つ**。埋め込み表を引くのは検索ディレクトリを全部見て
#   1 つも見つからなかったときだけなので、自分で `time.pyi` を置けば上書きできる。
#
# ⚠⚠ **前提は INF-D だった**。変換器は全パラメータを `mutable: true` にするので、
#   `mut` 実引数の検査を直す前にスタブを置くと `time.sleep(0.01)` が
#   `CallMutParamWithImmutableArg` で落ちる ＝ **純粋な退行**になっていた。
#
# ⚠ スタブに書けるのは `py_type_to_arrow` が解釈できる型だけ。**モジュール定数**
#   （`math.pi`）は現状どちらの経路も拾わないので関数だけを書いている。
#   ⇒ ⑤ で「宣言していないメンバも従来どおり使える」ことを固定する。

import[py-int] math
import[py-int] time

# ── ① 戻り値型が効く（float） ───────────────────────────────────────────
let a: float = math.sqrt(2.0)
print(a)
# 1.4142135623730951

# ── ② int を返す関数 ────────────────────────────────────────────────────
let b: int = math.floor(3.7)
print(b)
# 3

# ── ③ bool を返す関数 ───────────────────────────────────────────────────
let c: bool = math.isnan(1.0)
print(c)
# False

# ── ④ 引数もリテラルで渡せる（INF-D の効果） ────────────────────────────
print(math.gcd(12, 18))
time.sleep(0.01)
print("slept")
# 6
# slept

# ── ⑤ スタブに宣言していないメンバも従来どおり使える ────────────────────
print(math.pi)
# 3.141592653589793

# ── ⑥ time の戻り値型 ───────────────────────────────────────────────────
let t: float = time.time()
print(t > 0.0)
# True
