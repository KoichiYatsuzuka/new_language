# py_chained_compare.ar — `import[py]`（Python → Arrow 変換器）の **連鎖比較** 対応（項目 16 / D6）。
#
# 対象は `convert_expr` の `Compare` アーム（`src/python_converter/expressions.rs`）。
#
# Python の `a < b < c` に相当する構文は Arrow に無いので脱糖する。**脱糖は 2 通り**:
#
#   ① 中間オペランドに副作用が無い（素の名前・定数）… 圧倒的多数
#        a < b < c   →   (a < b) and (b < c)
#      ⚠ 中間を 2 回読むが、読んでも観測できないので命令を増やさない。
#
#   ② 中間オペランドに副作用がある（呼び出し・添字・属性 …）… D6
#        a < f() < c
#          →  block->bool:
#                 mut __py_cmp_0 = f()          # 中間は 1 回だけ評価
#                 if not (a < __py_cmp_0):
#                     block_return False        # ← ここで抜けるので c は評価されない
#                 block_return __py_cmp_0 < c
#
# ⚠⚠ **ブロック式はその場に埋め込む**（文へ持ち上げない）。持ち上げると
#   `while 0 < f() < 10:` が 1 回しか評価されない・`p and (0 < f() < 10)` で `p` が
#   偽でも `f()` が走る、という形で**黙って評価回数が変わる**。
#   `Expr::Block` は VM コンパイラの一般の式ディスパッチが扱うので、条件式の中でも
#   内包表記の中でもそのまま置ける。⇒ ⑧〜⑫ がその網。
#
# ⚠ 期待値は**すべて CPython と一致**（短絡・評価回数・評価順序・同一性）。
#
# ⚠ py 関数の引数は型注釈が無く Arrow からは `mut` 扱いなので、実引数も `mut` 変数で渡す。

import[py] test_modules.py_chained_compare as m

mut x = 5

# ── ① 基本形 ────────────────────────────────────────────────────────────
print(m.simple(x))
# True
mut big = 50
print(m.simple(big))
# False

# ── ② 3 段の連鎖 ────────────────────────────────────────────────────────
mut y = 20
print(m.triple(x, y))
# True

# ── ③ 演算子が混ざってもよい ────────────────────────────────────────────
print(m.mixed_ops(x))
# True
mut a = 1
print(m.eq_chain(a, a, a))
# True
mut b = 2
print(m.eq_chain(a, a, b))
# False

# ── ④ 他の演算子との組み合わせ ──────────────────────────────────────────
mut xs = [5]
print(m.with_in(x, xs))
# True

# ── ⑤ 連鎖でない比較も同じ経路（`is not` の特別扱いを壊していないこと） ──
print(m.is_chain(x))
# True

# ── ⑥ 条件式としての利用 ────────────────────────────────────────────────
print(m.guard(x))
# out      （1 < 5 < 5 は偽）
mut nine = 9
print(m.guard(nine))
# out

# ── ⑦ ★短絡は CPython と一致する ───────────────────────────────────────
#     `100 < 5` が偽なので右側の `side_len()` は評価されない ⇒ 呼び出し回数 0。
print(m.short_circuit(x))
# (False, 0)

# ── ⑧ ★中間オペランドは 1 回だけ評価される（D6） ────────────────────────
print(m.middle_once())
# (True, 1)
print(m.four_operands())
# (True, 2)      中間が 2 つ、どちらも 1 回
print(m.early_false())
# (False, 1)     先頭の比較が偽 ⇒ その先は評価されない
print(m.eval_order())
# (True, 'abc')  ★先頭にも副作用がある形。左→右の順を守る

# ── ⑨ `while` の条件 — **毎周回**評価される ─────────────────────────────
#     持ち上げていたら 1 回で終わってしまう位置。
print(m.in_while())
# (3, 4)

# ── ⑩ `and` / `or` の右辺 — 短絡したら評価されない ──────────────────────
print(m.in_and_rhs())
# (False, 0)
print(m.in_or_rhs())
# (True, 0)

# ── ⑪ 三項の**選ばれない腕** ────────────────────────────────────────────
print(m.in_ternary())
# ('hit', 0)

# ── ⑫ 内包表記の条件 — **要素ごとに 1 回** ──────────────────────────────
print(m.in_comprehension())
# ([1, 2], 3)

# ── ⑬ ★同一性が動かないこと ────────────────────────────────────────────
#     一時変数へ退避しても `is` の結果は変わらない（呼び出し結果の束縛は複製しない）。
print(m.is_identity())
# True
