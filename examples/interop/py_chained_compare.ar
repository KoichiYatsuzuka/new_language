# py_chained_compare.ar — Python の連鎖比較（`a < b < c`）を使う関数を Arrow から呼ぶ
#
# 連鎖比較は CPython が実行するので、短絡（`a < f() < c` で左が偽なら `c` を評価しない）・中間の評価回数（1 回）・
# 評価順序・同一性（`a is b is c`）は CPython と同じ。⑧〜⑫ は条件式・内包・`while` の中の連鎖比較。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。

import[py-int] test_modules.py_chained_compare as m

mut x = 5

# ── ① 基本形 ────────────────────────────────────────────────────────────
print(m.simple(x))
# True
mut big = 50
print(m.simple(big))
# False

# ── ② 3 段の連鎖 ────────────────────────────────────────────────────────
mut y = 20
print(m.triple(x, y))
# True

# ── ③ 演算子が混ざってもよい ────────────────────────────────────────────
print(m.mixed_ops(x))
# True
mut a = 1
print(m.eq_chain(a, a, a))
# True
mut b = 2
print(m.eq_chain(a, a, b))
# False

# ── ④ 他の演算子との組み合わせ ──────────────────────────────────────────
mut xs = [5]
print(m.with_in(x, xs => py_list[int]))
# True

# ── ⑤ 連鎖でない比較も同じ経路（`is not` の特別扱いを壊していないこと） ──
print(m.is_chain(x))
# True

# ── ⑥ 条件式としての利用 ────────────────────────────────────────────────
print(m.guard(x))
# out      （1 < 5 < 5 は偽）
mut nine = 9
print(m.guard(nine))
# out

# ── ⑦ ★短絡は CPython と一致する ───────────────────────────────────────
#     `100 < 5` が偽なので右側の `side_len()` は評価されない ⇒ 呼び出し回数 0。
print(m.short_circuit(x))
# (False, 0)

# ── ⑧ ★中間オペランドは 1 回だけ評価される（D6） ────────────────────────
print(m.middle_once())
# (True, 1)
print(m.four_operands())
# (True, 2)      中間が 2 つ、どちらも 1 回
print(m.early_false())
# (False, 1)     先頭の比較が偽 ⇒ その先は評価されない
print(m.eval_order())
# (True, 'abc')  ★先頭にも副作用がある形。左→右の順を守る

# ── ⑨ `while` の条件 — **毎周回**評価される ─────────────────────────────
#     持ち上げていたら 1 回で終わってしまう位置。
print(m.in_while())
# (3, 4)

# ── ⑩ `and` / `or` の右辺 — 短絡したら評価されない ──────────────────────
print(m.in_and_rhs())
# (False, 0)
print(m.in_or_rhs())
# (True, 0)

# ── ⑪ 三項の**選ばれない腕** ────────────────────────────────────────────
print(m.in_ternary())
# ('hit', 0)

# ── ⑫ 内包表記の条件 — **要素ごとに 1 回** ──────────────────────────────
print(m.in_comprehension())
# ([1, 2], 3)

# ── ⑬ ★同一性が動かないこと ────────────────────────────────────────────
#     一時変数へ退避しても `is` の結果は変わらない（呼び出し結果の束縛は複製しない）。
print(m.is_identity())
# True
