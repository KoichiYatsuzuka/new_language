# py_int_foreign_error.ar — py-int で Python が投げた例外の種類（正例・ffi_value_exchange_plan.md 7-24・pandas_import_plan.md の 2-1）
#
# Python が投げた組み込みの例外は、同じ名前の Arrow の例外（`ValueError`・`KeyError`）。メッセージ（`e.message`・`str(e)`）は
# CPython の `str(e)`。Arrow の値を Python へ渡せない（Arrow のインスタンスなど）のは Arrow 側の誤りなので `TypeError`。
# ⚠ ファイルの名前は 7-24 のときのもの。7-24 から 2-1 までは C# / JS と同じく `ForeignError`（`message` は `ValueError: bad`）で、
#   `except ValueError:` で捕まらなかった。7-24 より前は呼び出しの種類で決まる例外（関数は `RuntimeError: Python call failed: …`・
#   メソッドは `AttributeError: Python method call …`）だった。
# Python で定義した例外は py_int_exceptions.ar。
#
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。
# 実行には Python（py_int_probe.py）が要る。
# 対になる負例: py_int_exception_error.ar

import[py-int] py_int_probe as pp

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

class Point:
    mut x: int

mut message = ""
try:
    print(pp.fail("bad"))
except ValueError as e:
    message = e.message
check("a Python function's exception is a ValueError (" + message + ")", message == "bad")

message = ""
mut r = pp.make_raiser()
try:
    print(r.boom())
except KeyError as e:
    message = e.message
check("a Python method's exception is a KeyError (" + message + ")", message == "'k'")

message = ""
try:
    print(pp.big_text(Point(1)))
except TypeError as e:
    message = e.message
check("an Arrow value Python cannot take is a TypeError", "cannot pass an Arrow value of type 'Point'" in message)
