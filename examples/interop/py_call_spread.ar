# py_call_spread.ar — `*args` / `**kwargs` を受ける Python の関数を Arrow から呼ぶ（展開して転送する形）
#
# Python の関数が `def forward(*args, **kwargs): return add3(*args, **kwargs)` のように展開して転送する（④）。
# Arrow から渡す list / dict は `=> py_list[T]` / `=> py_dict[K, V]` で写して渡す（D-12）。
# Arrow 側の `f(*xs)` / `f(**d)` は `examples/basics/call_spread.ar`。

import[py-int] test_modules.py_call_spread as m

# ── ① リストを丸ごと展開 ────────────────────────────────────────────────
mut xs = [1, 2, 3]
print(m.star(xs => py_list[int]))
# 6

# ── ② 位置引数と混ぜる ──────────────────────────────────────────────────
mut one = 1
mut pair = [2, 3]
print(m.mixed(one, pair => py_list[int]))
# 6

# ── ③ 辞書をキーワード引数として展開 ────────────────────────────────────
mut d = {"b": 2, "c": 3}
print(m.kwstar(d => py_dict[str, int]))
# 6

# ── ④ ★転送パターン（`*args` / `**kwargs` を受けてそのまま渡す） ───────
print(m.use_forward())
# 6
