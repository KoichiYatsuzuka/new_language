# native_builtin_fast.ar — 引数の型が分かる組み込み関数をネイティブで行う（native_object_access_plan.md 5-2）
#
# モジュールは .arc（コンパイル済み）を読む。非コンパイル（.ar）でも同じ値になること。
#   1. cargo run --release -- --compile examples/interop/test_modules/native_builtin_fast_module.ar
#   2. cargo run --release -- examples/interop/native_builtin_fast.ar
#
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。

import test_modules.native_builtin_fast_module as m

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

# range(5) / range(2, 7) / range(10, 0, -3)（10, 7, 4, 1）/ 空の range
check("range with 1 / 2 / 3 arguments, negative step, empty", m.loops() == "10,20,10741,0")
# 奇数の i（1, 3, 5, 7）で 0..i-1 を足す、i > 7 で抜ける
check("continue / break / nested range loops", m.control(20) == 34)
check("variable step falls back to the range object", m.variable_step(3) == 63 and m.variable_step(7) == 21)
check("float(int) / float(float) / str(int)", m.scalars(6, 2.5) == "1.5|2.5|-18|6000000000000")
check("len of list / str / dict", m.lengths([1, 2, 3], "héllo", {"a": 1, "b": 2}) == 352)
