# py_set.ar — Python のセットのリテラルを使う関数を Arrow から呼ぶ
#
# 戻り値の set は CPython の物のまま `py_set` で受ける（D-12）。集合内包は `py_comprehension.ar`。
# ⚠⚠ **セットの repr 順は当てにしない**こと。CPython は文字列のハッシュを実行ごとにランダム化するので、
#   `{"a","b","c"}` の表示順は**実行のたびに変わる**。ここでは int / tuple のセットだけを表示し、str のセットは
#   メンバシップで確認する。

import[py] test_modules.py_set as m

# ── ① リテラル / 重複除去 / 単要素 ──────────────────────────────────────
print(m.literal())
# {1, 2, 3}
print(m.dedup())
# {1, 2, 3}
print(m.single())
# {7}

# ── ② 空セットは `set()` ────────────────────────────────────────────────
print(m.empty())
# set()

# ── ③ メンバシップ / 長さ / 追加 ────────────────────────────────────────
mut two = 2
print(m.membership(two))
# True
mut nine = 9
print(m.membership(nine))
# False
print(m.size())
# 3
print(m.add())
# {1, 2, 3}

# ── ④ 要素が式（重複はここでも潰れる） ──────────────────────────────────
mut a = 1
mut b = 3
print(m.from_exprs(a, b))
# {2, 6}

# ── ⑤ 入れ子 / tuple 要素 ───────────────────────────────────────────────
print(m.nested_in_list())
# [{1, 2}, {3}]
print(m.set_of_tuples())
# {(1, 2), (3, 4)}

# ── ⑥ str のセット（順不定なので `in` で確認） ──────────────────────────
mut ka = "a"
print(m.str_set_membership(ka))
# True
mut kz = "z"
print(m.str_set_membership(kz))
# False
