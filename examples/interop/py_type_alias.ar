# py_type_alias.ar — Python の型エイリアス（`type X = T`）を使うモジュールを CPython で動かす
#
# `type X = T` は CPython 3.12 の文で、CPython が実行する。型スタブは型エイリアスを読まない（`X` を注釈に使った関数の
# 引数・戻り値の型は `Any`）。Arrow の list は `=> py_list[int]` で写して渡す。

import[py] test_modules.py_type_alias as m
import[py] test_modules.py_type_alias_other as o

# ── ① `type Vec = list[int]` が展開される ───────────────────────────────
mut xs = [1, 2, 3]
print(m.total(xs => py_list[int]))
# 6

# ── ② 素の型へのエイリアス ──────────────────────────────────────────────
mut n = "bob"
print(m.greet(n))
# hi bob

# ── ③ エイリアスの連鎖（`type Pair = Vec` → list[int]） ─────────────────
print(m.chained(xs => py_list[int]))
# 3

# ── ④ 別モジュールの**同名**エイリアスは別の型のまま ────────────────────
mut s = "hello"
print(o.size(s))
# 5
