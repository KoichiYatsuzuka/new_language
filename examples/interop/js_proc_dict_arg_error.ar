# js_proc_dict_arg_error.ar — js-proc の関数に dict を渡すと TypeError（負例・2-3）
#
# js-proc の値の表現は数値・文字列・bool・None・リストだけで、dict / tuple / set / インスタンスはまだ運べない
# （フェーズ 5・5-2）。以前は黙って JS 側に `null` が届いていた（`type_of({"a": 1})` → "null"）。
#
# 実行には Node.js が要る（型は js_probe.ars、実装は js_probe.js）。
# 対になる正例: js_proc_values.ar（`try` で捕まえる形）

import[js-proc] js_probe as jp

print("list:", jp.type_of([1, 2]))
print("unreachable:", jp.type_of({"a": 1}))
