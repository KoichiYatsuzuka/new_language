# py_exception_args.ar — Python の例外の args / str(e) / super().__init__（python_builtins_plan.md のタスク 4-2）
#
# Python のクラスが組み込みの例外を継承したときも、args と str(e) は CPython と同じ:
#   - super().__init__(..) に渡したものが args になる（RangeError）
#   - __init__ を書かなければ、作るときの引数がそのまま args（Missing）
#   - __init__ が super().__init__ を呼ばなくても、作るときの引数が args（Coded・CPython の BaseException.__new__ と同じ）
# ⚠ 以前は super().__init__(..) が組み込みの例外へ届かず（`class 'Exception' has no method '__init__'` 相当）、
#   2 引数以上では作れなかった。

import[py] test_modules.py_exception_args as p

for line in p.describe_all():
    print(line)
# RangeError: str=1-9 args=('1-9',)
# Missing: str=('name', 2) args=('name', 2)
# Coded: str=7 args=(7,)

try:
    p.fail()
except LookupError as e:
    print("not reached")
except Exception as e:
    print("Arrow caught:", e)            # Arrow caught: 3-4
