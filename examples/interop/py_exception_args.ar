# py_exception_args.ar — Python で定義した例外の args / str(e) を CPython で動かして Arrow で受ける
#
# Python のクラスが組み込みの例外を継承したときの args と str(e)（CPython の BaseException の規則）:
#   - super().__init__(..) に渡したものが args になる（RangeError）
#   - __init__ を書かなければ、作るときの引数がそのまま args（Missing）
#   - __init__ が super().__init__ を呼ばなくても、作るときの引数が args（Coded・BaseException.__new__）
# Arrow の `except Exception as mut e` も Python で定義した例外を捕まえる（値は CPython の物なので `mut` で受ける・D-11）。

import[py] test_modules.py_exception_args as p

for line in p.describe_all():
    print(line)
# RangeError: str=1-9 args=('1-9',)
# Missing: str=('name', 2) args=('name', 2)
# Coded: str=7 args=(7,)

try:
    p.fail()
except LookupError as mut e:
    print("not reached")
except Exception as mut e:
    print("Arrow caught:", e)            # Arrow caught: 3-4
