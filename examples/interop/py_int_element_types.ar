# py_int_element_types.ar — Python の注釈の要素型を型スタブに残す（正例・ffi_value_exchange_plan.md 7-8）
#
# py-int の型スタブは Python の注釈から作る。`set[tuple[int, int]]` / `frozenset[str]` / `dict[str, list[int]]` は要素型まで
# Arrow の型になり（frozenset は Arrow の set で届くので `set[str]`）、戻り値の要素も境界で照合する。
# ⚠ 7-8 より前は `set[tuple[int, int]]` → `set[tuple]`・`frozenset[str]` → `Any`・`dict[K, V]` → `dict` と要素型を落としていた
#   ので、注釈に反する要素（`{(1, "x")}`・`{"a": "x"}`）が黙って通った。
#
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。
# 実行には Python（py_int_probe.py）が要る。
# 対になる負例: py_int_element_type_error.ar

import[py-int] py_int_probe as pp

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

let ps: set[tuple[int, int]] = pp.pairs()
check("set[tuple[int, int]]", (1, 2) in ps and len(ps) == 2)
let fs: set[str] = pp.frozen()
check("frozenset[str] is set[str]", "a" in fs)
let t: dict[str, list[int]] = pp.table()
check("dict[str, list[int]]", t["a"] == [1, 2])

mut caught = 0
try:
    let bad = pp.lying_pairs()
    print("unreachable:", bad)
except FfiTypeError:
    caught += 1
try:
    let bad2 = pp.lying_table()
    print("unreachable:", bad2)
except FfiTypeError:
    caught += 1
check("elements that break the annotation are FfiTypeError", caught == 2)
