# native_overload_module.ar — オーバーロードを含むモジュールのコンパイル（native_object_access_plan.md 1-8）
#
# ⚠ 以前は同じ名前の定義（オーバーロード）を全部コンパイルしようとして同じシンボルが 2 つでき、clang が
#   `invalid redefinition of function 'Box____init___impl'` で落ちて**モジュール全体が**ネイティブにならなかった
#   （`--compile` は「skipped」と出して DLL の無い .arc を書き、実行は黙って非コンパイルになる）。
#   明示の `__init__` の引数がフィールドと違うと、自動生成の `__init__`（全フィールド）と並ぶのでこれに当たる。
# 今はオーバーロードした名前だけをインタープリタに任せ、ほか（`area`・`plain`・`grow`）はコンパイルする。
# （最上位の関数のオーバーロードも同じ扱い。単体テスト `overloads_are_left_to_the_interpreter` が見る）
#
# Compile with:
#   cargo run --release -- --compile examples/interop/test_modules/native_overload_module.ar

class Box:
    mut w: int
    mut h: int

    # 自動生成の __init__(w, h) と並ぶ
    fn __init__(mut self, let side: int) -> None:
        self.w = side
        self.h = side

    fn area(let self) -> int:
        return self.w * self.h

    fn scale(mut self, let k: int) -> None:
        self.w = self.w * k

    fn scale(mut self, let kw: int, let kh: int) -> None:
        self.w = self.w * kw
        self.h = self.h * kh

fn plain(let x: int) -> int:
    return x + 1

fn grow(let side: int) -> int:
    mut b = Box(side)
    b.scale(2)
    b.scale(1, 3)
    return b.area()
