class V:
    mut x: float
    mut y: float
    fn __init__(mut self, x: float, y: float) -> None:
        ...


class K:
    mut v: V
    mut w: V
    mut name: str
    fn flip(mut self) -> None:
        ...
    fn shift(mut self, d: float) -> None:
        ...
    fn replace_v(mut self, x: float) -> float:
        ...
    fn set_v(mut self, mut nv: V) -> float:
        ...
    fn step(mut self, k: int) -> float:
        ...
    fn step_replace(mut self, mut old: V, mut nv: V) -> float:
        ...
    fn step_inner(mut self, mut old: V, mut nv: V) -> float:
        ...
    fn step_inner_new(mut self, mut old: V) -> float:
        ...
    fn step_other(mut self, mut o: K) -> float:
        ...
    fn __init__(mut self, v: V, w: V, name: str) -> None:
        ...


fn fresh() -> K:
    ...
