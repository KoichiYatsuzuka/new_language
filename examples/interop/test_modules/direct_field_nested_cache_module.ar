# direct_field_nested_cache_module.ar — examples/interop/direct_field_nested_cache.ar が読むモジュール
# （copy_alloc_speed_plan.md 7-13）
#
# `h.v.x` の `h.v` の番地は、関数の中で（変数, 属性）ごとに 1 回だけ取って使い回す。どの関数も、取った後で親のフィールドか
# 親の変数を差し替え、差し替えた後の子を読む。差し替える前の子は `mut old`（呼ぶ側が `h.v` を渡す。`mut` の仮引数は呼ぶ側の
# 物を共有する）が生かしておく: 捨てられた塊を読むと、アロケータが書き換えた先頭の語で初期化の印の検査が外れ、たまたま
# 遅い道が正しい値を読んでしまうので、古い番地を使ったら古い値が読めてしまう形にする。

class V:
    mut x: float
    mut y: float

# `tag` があるので raw レイアウトでない（`v` はインスタンスを持つ slot）
class H:
    mut v: V
    mut tag: str

    fn swap(mut self, let k: float) -> None:
        self.v = V(k, k)

    fn sum_twice(let self) -> float:
        return self.v.x + self.v.y + self.v.x

fn replace(mut h: H, let k: float) -> None:
    h.v = V(k, k + 1.0)

# 2 つの読み出しの間で、メソッドの呼び出しが親のフィールドを差し替える
fn after_method(mut old: V, mut h: H) -> float:
    let a = h.v.x
    h.swap(9.0)
    return a * 100.0 + h.v.x + old.y * 1000.0

# 同じく代入
fn after_assign(mut old: V, mut h: H) -> float:
    let a = h.v.x
    h.v = V(3.0, 4.0)
    return a * 100.0 + h.v.x + h.v.y + old.y * 1000.0

# 同じく関数の呼び出し（親を `mut` で渡す）
fn after_function(mut old: V, mut h: H) -> float:
    let a = h.v.y
    replace(h, 6.0)
    return a * 100.0 + h.v.y + old.x * 1000.0

# 同じ親を 2 つの名前で持つ（`mut` の仮引数は呼ぶ側の物を共有する）: `b` から差し替えたら `a` からも新しい子
fn two_names(mut old: V, mut a: H, mut b: H) -> float:
    let x0 = a.v.x
    b.v = V(5.0, 5.0)
    return x0 * 100.0 + a.v.x + old.y * 1000.0

# 親の変数を束縛し直す
fn rebind(mut h1: H, mut h2: H) -> float:
    mut g = h1
    let a = g.v.x
    g = h2
    return a * 100.0 + g.v.x

# ループ: 毎周読み、一部の周でだけ差し替える
fn loop_swap(mut old: V, mut h: H, let n: int) -> float:
    mut s = 0.0
    mut i = 0
    while i < n:
        s += h.v.x
        if i % 3 == 2:
            h.v = V(float(i), 0.0)
        i += 1
    return s + old.x * 1000.0

# 覚えた番地へ書き、差し替えた後は新しい子へ書く
fn write_after(mut old: V, mut h: H) -> float:
    let y0 = h.v.y
    h.v.x = 1.5
    let x1 = h.v.x
    h.swap(2.0)
    h.v.y = 7.0
    return y0 * 1000.0 + x1 * 100.0 + h.v.x * 10.0 + h.v.y + old.x * 10000.0 + old.y * 100000.0

# ループ変数が親（周ごとに別の親）
fn sum_all(mut hs: list[H]) -> float:
    mut s = 0.0
    for h in hs:
        s += h.v.x + h.v.y
    return s
