# import[py-int] の型を、Python のモジュールの import をたどって付ける（pandas_import_plan.md の D-2・タスク 1-3）
#
# 補助のパッケージ py_int_links_pkg は pandas と同じ形を小さく真似る:
#   ① `__init__.py` が `from .frames import Frame, read` で再エクスポートする（pandas の `pd.DataFrame`）
#   ② 注釈に、`if TYPE_CHECKING:` の中で import したよそのモジュールのクラスを書く（`-> Reader`）
#   ③ メソッドの多くが別のファイルの基底にあり、戻り値は `Self`（pandas の `NDFrame.head`）
#   ④ `@overload` で、引数によって戻り値の型が変わる（pandas の `read_csv(path)` は `DataFrame`、`chunksize=..` は
#      `TextFileReader`）。CPython の型の検査器と同じく、最初に当てはまる形を選ぶ
# ⚠ 以前は 1 つのファイルの宣言しか読まなかったので、①〜④はどれも `Any`（型の分からない値）になっていた。
# 静的な誤りの形は py_int_links_error.ar。

import[py-int] py_int_links_pkg as pk

fn check(label: str, ok: bool) -> None:
    if not ok:
        raise RuntimeError("failed: " + label)
    print(label + " OK")

# ① 再エクスポートしたクラスとコンストラクタ
mut f: pk.Frame = pk.Frame(3)
let w: int = f.width()
check("re-exported class (pk.Frame)", w == 2)

# ③ ほかのファイルの基底のメンバーと `Self`（`head` は `Frame` を返す）
mut h: pk.Frame = f.head()
let c: int = h.count()
check("member of a base class in another file, Self is the class", c == 3)

# ④ `@overload`: `lazy` を渡さなければ `Frame`、`lazy=True` なら `Reader`
mut frame: pk.Frame = pk.read("a.csv")
check("overload without lazy= returns Frame", frame is pk.Frame)
mut reader: pk.Reader = pk.read("a.csv", lazy=True)
check("overload with lazy=True returns Reader", reader is pk.Reader)

# ② 注釈のよそのクラス（`Reader.get` は `Frame` を返す・`frames.py` では `TYPE_CHECKING` の中で import した名前）
mut got: pk.Frame = reader.get()
check("a class named in an annotation through TYPE_CHECKING", got.width() == 2)
