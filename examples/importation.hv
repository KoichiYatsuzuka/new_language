# importation.hv — demonstrates all import styles and qualifiers.
#
# Import styles:
#   import             — auto: prefers .hvc if present, falls back to .hv
#   import[hv]         — force .hv source (tree-walk, ignores .hvc)
#   import[hvc]        — force .hvc compiled (error if no .hvc exists)
#   import[py-int]     — Python module with integer conversion
#   import[rs]         — Rust crate (auto-discovered from hv_config.json rust.crates_path)
#   from … import      — selective import from a .hv module
#   subdir.module      — subdirectory .hv module
#
# Prerequisites for section 1 (physics benchmark):
#   cargo run --release -- --compile examples/test_modules/physics.hv

import[py-int] time

# ── 1. Physics benchmark: native class-method dispatch ─────────────────────────
#
# Compares three execution paths for a Body class with four method calls per
# loop iteration (potential, vel_dot, kinetic×2):
#   import[hv]  — always tree-walk interpreter
#   import      — auto-selects native DLL (.hvc) when available
# Inline baseline pre-reads fields as local floats — upper speed bound.

import[hv]  test_modules.physics as interp_mod
import      test_modules.physics as native_mod

const N: int = 7_000_000

print("=== Physics benchmark  N =", N, " ===")
print("  Loop body: potential(other) + vel_dot(other) + kinetic() + kinetic()")
print("  = 4 method calls per iteration, ~40 callbacks per iteration in method bodies")
print()

let a_n = native_mod.Body(1.0,  2.0,  3.0,   0.5, -0.3, 0.7, 2.0)
let b_n = native_mod.Body(-1.0, 0.5, -2.0,  -0.2,  0.8, 0.1, 3.0)
let a_i = interp_mod.Body(1.0,  2.0,  3.0,   0.5, -0.3, 0.7, 2.0)
let b_i = interp_mod.Body(-1.0, 0.5, -2.0,  -0.2,  0.8, 0.1, 3.0)

print("Running NATIVE (method bodies compiled, dispatch native) ...")
let t0: float = time.time()
let r_native: float = native_mod.total_energy(a_n, b_n, N)
let t1: float = time.time()
let t_native: float = t1 - t0
print("  result:", r_native, "  time:", t_native, "s")
print()

print("Running INTERPRETED (all method calls through tree-walker) ...")
let t2: float = time.time()
let r_interp: float = interp_mod.total_energy(a_i, b_i, N)
let t3: float = time.time()
let t_interp: float = t3 - t2
print("  result:", r_interp, "  time:", t_interp, "s")
print()

print("Running INLINE baseline (typed float fields pre-read, native loop) ...")
let t4: float = time.time()
let r_inline: float = native_mod.total_energy_inline(a_n, b_n, N)
let t5: float = time.time()
let t_inline: float = t5 - t4
print("  result:", r_inline, "  time:", t_inline, "s")
print()

print("=== Summary ===")
if t_native > 0.0:
    print("  Speedup (native methods vs interp):", t_interp / t_native, "x")
if t_inline > 0.0:
    print("  Speedup (inline float vs interp)  :", t_interp / t_inline, "x")
    print("  Speedup (inline float vs native)  :", t_native / t_inline, "x")
print()
print("  [native]  loop compiled, method bodies run as native DLL code via CB_GET_ATTR/CB_BINOP callbacks")
print("  [inline]  loop + all arithmetic compiled — upper bound (no callbacks for fields)")
print()

# ── 2. import[py-int] — pandas ───────────────────────────────────────────────

import[py-int] warnings as w
w.simplefilter("ignore")   # suppress pandas CoW FutureWarning

import[py-int] pandas as pd

mut df = pd.DataFrame({
    "name":  ["Alice", "Bob", "Charlie", "Diana", "Eve"],
    "age":   [25, 30, 35, 28, 22],
    "score": [85, 92, 78, 95, 88]
})

print("=== DataFrame ===")
print(df)
print("shape:", df.shape)
print("rows :", len(df))

let scores = df["score"]
print("score mean:", scores.mean())
print("score max :", scores.max())
print("describe  :")
print(df.describe())

let mask = scores > 88
let high = df[mask]
print("score > 88 rows:")
print(high)

df["pass"] = df["score"] >= 85
print("with pass column:")
print(df)

print("score values:")
for v in scores:
    print(v)

let sorted_df = df.sort_values("score", ascending=False)
print("top 3 by score:")
print(sorted_df.head(3))

# ── 3. import[py-int] — PyObject operators and iteration ─────────────────────

import[py-int] test_modules.py_calculator as calc

# binary operators
let c = calc.make_container([1, 2])
let c2 = c * 3               # Container.__mul__
print(len(c2))               # 6

let c3 = 3 * c               # Container.__rmul__
print(len(c3))               # 6

let a = calc.make_container([1, 2])
let b = calc.make_container([3, 4, 5])
let ab = a + b               # Container.__add__
print(len(ab))               # 5

mut total = 0
for v in ab:
    total += v
print(total)                 # 15

# iteration
let c_iter = calc.make_container([10, 20, 30, 40])
mut sum_iter = 0
for x in c_iter:
    sum_iter += x
print(sum_iter)              # 100

let outer = calc.make_container([1, 2, 3])
mut result = 0
for v2 in outer:
    result += v2 * 10
print(result)                # 60

