# float_repr.ar — float と complex の表示を CPython の repr に合わせる（python_builtins_plan.md のタスク 1-5）
#
# float（str / repr / print）は最短の往復表現で、10 進の指数が -4 以下か 16 より大きければ指数表記、
# それ以外は小数表記に `.0` を足す（CPython の PyOS_double_to_string(x, 'r', 0, Py_DTSF_ADD_DOT_0)）。
# complex は成分に `.0` を付けず、実部が +0 なら虚部だけ（CPython の complex_repr）。
# ⚠ 以前は指数表記を使わず、`1e20` が `100000000000000000000`（`.0` も無し）、`1e-10` が `0.0000000001`、
#   NaN が `NaN`、complex が `(1.0+2.0j)` だった。

print("=== 1. ordinary values (unchanged) ===")
print(0.1, 2.5, 100.0, -0.0)                    # 0.1 2.5 100.0 -0.0
print(0.1 + 0.2)                                # 0.30000000000000004

print("=== 2. the switch to exponent notation ===")
print(1e15, 1e16)                               # 1000000000000000.0 1e+16
print(0.0001, 0.00001)                          # 0.0001 1e-05
print(1.5e-7, 2.5e300, -1e100)                  # 1.5e-07 2.5e+300 -1e+100

print("=== 3. inf and nan ===")
let big: float = 1e308 * 10.0
print(big, -big, big - big)                     # inf -inf nan

print("=== 4. str / repr / in a list ===")
print(str(1e20), repr(1e-10))                   # 1e+20 1e-10
print([1e16, 0.5])                              # [1e+16, 0.5]

print("=== 5. complex ===")
print(1 + 2j, 2j, 1.5 - 0j)                     # (1+2j) 2j (1.5+0j)
print(complex(1e20, 1e-5))                      # (1e+20+1e-05j)
