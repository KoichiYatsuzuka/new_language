# wrapper.ar — core.ar を import して使う中段のモジュール（例題 import_visibility.ar）。
#
# ここで import した `core` と `Item` は、CPython と同じく wrapper の名前空間のメンバーにもなる
# （再エクスポート）。`wrapper.core` / `from wrapper import Item` が書ける。

from . import core
from .core import Item

const WRAPPED: str = "wrapped " + core.LABEL

fn wrap(let v: int) -> Item:
    return core.make_item(v)

fn describe(let it: Item) -> str:
    return WRAPPED + ":" + str(it.v)
