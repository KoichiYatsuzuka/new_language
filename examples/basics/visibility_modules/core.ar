# core.ar — 例題 import_visibility.ar / import_visibility_error.ar の下段のモジュール。
#
# wrapper.ar がこれを import する（`from . import core`）。読み込まれたサブモジュールは
# 親パッケージの属性になる（`visibility_modules.core`・CPython と同じ）。

const LABEL: str = "core"

class Item:
    let v: int

    fn __init__(mut self, let v: int):
        self.v = v

fn make_item(let v: int) -> Item:
    return Item(v * 10)
