# global_assign_from_fn.ar — 関数本体からのグローバル代入（#39）
#
# 関数の中から最上位の `mut` 変数へ代入できる（`nonlocal` は無く、外側を `mut` にすることで
# 内側から書ける — 言語仕様どおり）。⚠ VM は長らくこれを bail していた（#39）。
#
# ⚠ 健全性の要点: この代入は **`scopes[0]` だけ**を対象にする。VM 関数は `scopes` を
#    一切押さないので、`assign_var` のローカル走査に映るのは**呼び出し元のローカル**であり、
#    そこを見ると同名の呼び出し元変数を書き換えてしまう。ケース 5 がその回帰検知。

print("=== 1. compound assignment to a global ===")
mut counter = 0
fn bump() -> None:
    counter += 1
for i in range(3):
    bump()
print(counter)                    # 3

print("=== 2. plain assignment to a global ===")
mut slot = 0
fn setit(let v: int) -> None:
    slot = v
setit(42)
print(slot)                       # 42

print("=== 3. a closure writes both an outer local and a global ===")
mut total = 0
fn outer() -> int:
    mut acc = 10
    fn inner() -> None:
        acc += 1
        total += 100
    inner()
    inner()
    return acc
print(outer())                    # 12
print(total)                      # 200

print("=== 4. a method writes a global ===")
mut hits = 0
class Counter:
    fn __init__(mut self) -> None:
        let _ = 0

    fn tick(let self) -> int:
        hits += 1
        return hits
let c = Counter()
print(c.tick())                   # 1
print(c.tick())                   # 2

print("=== 5. a same-named parameter in the caller must NOT be written ===")
# ⚠ グローバルと同名の**ローカル宣言**は静的型検査が禁じる（"already declared in an
#    accessible scope"）。同名にできるのは**パラメータと for ターゲット**だけなので、
#    呼び出し元フレームを守れているかはこの形で確かめる。
mut shared = 0
fn writes_global() -> None:
    shared = 999
fn caller(mut shared: int) -> int:
    writes_global()
    return shared
print(caller(1))                  # 1   （呼び出し元のパラメータは 1 のまま）
print(shared)                     # 999 （グローバルだけが書き換わる）

print("=== 6. a parameter shadows the global ===")
mut g6 = 5
fn shadowing(let g6: int) -> int:
    return g6 * 2
print(shadowing(3))               # 6
print(g6)                         # 5

print("=== 7. a for target shadows the global ===")
mut i7 = 100
fn loops() -> int:
    mut total2 = 0
    for i7 in range(3):
        total2 = total2 + i7
    return total2
print(loops())                    # 3
print(i7)                         # 100

print("=== 8. static mut and a global in the same function ===")
mut g8 = 0
fn ticks() -> int:
    static mut n = 0
    n += 1
    g8 += n
    return n
let _ = ticks()
let _ = ticks()
print(g8)                         # 3

print("=== 9. writing a global from inside a block expression ===")
mut g9 = 0
fn via_block() -> int:
    let v = block ->int:
        g9 += 7
        block_return g9
    return v
print(via_block())                # 7
print(g9)                         # 7
