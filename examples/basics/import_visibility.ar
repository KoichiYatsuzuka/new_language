# import_visibility.ar — import で何が見えるか（CPython と同じ・2026-10-02）
#
# 対になる誤り: import_visibility_error.ar
#
# ① `import a.b` は先にパッケージ `a`（a/__init__.ar。無ければ空の名前空間パッケージ）を実行し、
#    **先頭の `a` を束縛**する。`a.b.f()` と属性でたどる。
# ② 読み込まれたサブモジュールは親パッケージの属性になる（どこで読み込まれても・`sys.modules` と同じ）。
# ③ モジュールの中で import した名前もそのモジュールのメンバー（再エクスポート）。
# ④ `from a import b` は、b が a の名前に無ければサブモジュール a.b を読み込む。
#
# ⚠ 2026-10-02 のフェーズ 2 では「再エクスポートしない」だったが、利用者の決定で CPython 準拠に改めた。

import visibility_modules.wrapper

# ── ① パッケージ `visibility_modules` を束縛する ──
print(visibility_modules.PACKAGE)                 # visibility_modules（__init__.ar の名前）
let it = visibility_modules.wrapper.wrap(4)
print(it.v)                                       # 40
if it.v != 40:
    raise ValueError("wrapper.wrap")
print(visibility_modules.wrapper.describe(it))    # wrapped core:40

# ── ② wrapper が読み込んだ core は、パッケージの属性として見える ──
print(visibility_modules.core.LABEL)              # core

# ── ③ 再エクスポート: wrapper が import した core / Item は wrapper のメンバー ──
print(visibility_modules.wrapper.core.make_item(1).v)   # 10
from visibility_modules.wrapper import Item
let it2: Item = visibility_modules.wrapper.wrap(2)
print(it2.v)                                      # 20

# ── ④ `from パッケージ import サブモジュール` ──
from visibility_modules import core
print(core.make_item(3).v)                        # 30

# ── 型の名前も同じ綴りで書ける（`visibility_modules` を束縛しているので） ──
let it3: visibility_modules.core.Item = core.make_item(5)
print(it3.v)                                      # 50
