# import_visibility.ar — import したモジュールが import したものは見えない（再エクスポートしない・2026-10-02）
#
# 対になる誤り: import_visibility_error.ar
#
# visibility_modules/wrapper.ar は `import .core` / `from .core import Item` を書いている。
# メインが wrapper だけを import しても、`w.core` も `w.Item` も無い。
# core の型や関数を使いたければ、メインが自分で core を import する。
#
# ⚠⚠ 以前は 3 つの経路で「import したファイルの中で import されたファイル」が無条件に読めた:
#   - `w.core.LABEL` … モジュールの名前空間に、そのモジュールが import した名前まで入っていた
#   - `from visibility_modules.wrapper import Item` … 同上
#   - `let it: visibility_modules.core.Item` … 型の表がプログラム全体で 1 つなので、
#     import していないモジュールの型名まで注釈に書けた
# ⚠ 消えたのは「外から見えること」だけ。wrapper の関数は今までどおり core を使える。

import visibility_modules.wrapper as w
import visibility_modules.core as core
from visibility_modules.core import Item

# ── ① wrapper の関数は、wrapper が import した core を使える ──
let it: Item = w.wrap(4)          # 戻り値は core の Item（メインは core を自分で import した）
print(it.v)                       # 40
if it.v != 40:
    raise ValueError("w.wrap")
print(w.describe(it))             # wrapped core:40
print(w.WRAPPED)                  # wrapped core

# ── ② core のものは、メインが import した core から使う ──
print(core.LABEL)                 # core
print(core.make_item(1).v)        # 10
