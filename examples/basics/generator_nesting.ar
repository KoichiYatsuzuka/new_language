# generator_nesting.ar — ジェネレータの中でジェネレータを使う（bug_fix.md B12）
#
# ⚠⚠ 以前は「ジェネレータの本体が**別のジェネレータを作る**」だけで、外側が
#    **黙って空の列**になっていた。例外も警告も出ない 🔴 サイレント障害。
#    回さなくても、作った時点で壊れた（`let it = inner()` だけで再現した）。
#
# 原因は `GENERATOR_YIELDS`（yield の収集バッファ）が**入れ子にならない単一のスロット**
# だったこと。内側が上書き → 終了時に `take()` で `None` → 外側の以降の `yield` は
# 黙って捨てられ、外側は空で終わる。⇒ 退避・復元するようにした。
#
# ⚠ 再帰は無関係だった。**無関係な 2 つのジェネレータでも同じく壊れていた**。

print("=== 1. 別のジェネレータへ委譲する ===")
gen inner() -> int:
    yield 1
    yield 2

gen outer() -> int:
    for v in inner():
        yield v
    yield 99

mut a = []
for x in outer():
    a.append(x)
print(a)                          # [1, 2, 99]

print("=== 2. 作るだけで回さなくても外側は無事 ===")
# ⚠ ここが最小の再現形だった。`inner()` を作った時点で外側の収集が消えていた。
gen makes_one() -> int:
    yield 1
    let _unused = inner()
    yield 2

mut b = []
for x in makes_one():
    b.append(x)
print(b)                          # [1, 2]

print("=== 3. 再帰ジェネレータ ===")
gen nest(let n: int) -> int:
    if n > 0:
        for v in nest(n - 1):
            yield v
    yield n

for d in [0, 1, 3]:
    mut got = []
    for v in nest(d):
        got.append(v)
    print(d, "->", got)           # 0 -> [0] / 1 -> [0, 1] / 3 -> [0, 1, 2, 3]

print("=== 4. 木構造の走査（再帰ジェネレータが自然な形）===")
# ⚠ この書き方が黙って何も出さないのが B12 の実害だった。
class Node:
    mut value: int
    mut kids: list

gen walk(let node: Node) -> int:
    yield node.value
    for kid in node.kids:
        for v in walk(kid):
            yield v

let leaf1 = Node(2, [])
let leaf2 = Node(3, [])
let mid = Node(1, [leaf1, leaf2])
let root = Node(0, [mid])

mut seen = []
for v in walk(root):
    seen.append(v)
print(seen)                       # [0, 1, 2, 3]

print("=== 5. 3 段の入れ子 ===")
gen lvl1() -> int:
    yield 1

gen lvl2() -> int:
    for v in lvl1():
        yield v
    yield 2

gen lvl3() -> int:
    for v in lvl2():
        yield v
    yield 3

mut c = []
for x in lvl3():
    c.append(x)
print(c)                          # [1, 2, 3]
