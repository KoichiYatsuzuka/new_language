# function_attrs.ar — 関数の値の __name__ / __qualname__ / __doc__（python_builtins_plan.md のタスク 1-14）
#
# CPython と同じ規則:
#   - `__name__` は定義の名前、`__qualname__` はクラスと外側の関数を含む名前
#     （メソッドは `Box.get`、関数の中の関数は `outer.<locals>.inner`）
#   - `__doc__` は本体の先頭の文字列（docstring）。無ければ `None`（型は `Option[str]`）
#   - 束縛メソッド（`b.get`）は元のメソッドのもの。組み込みの値のメソッドは `list.append`
# 対になる誤りの例: function_attrs_error.ar（`__doc__` は `Option[str]` なので、そのまま `str` として使えない）

fn area(let w: int, let h: int) -> int:
    "Area of a rectangle."
    return w * h

fn outer() -> str:
    fn inner() -> int:
        return 1
    return inner.__qualname__

class Box:
    mut n: int
    fn __init__(mut self, let n: int) -> None:
        self.n = n
    fn get(self) -> int:
        "Return n."
        return self.n
    fn helper_name(self) -> str:
        fn helper() -> int:
            return 2
        return helper.__qualname__
    gen items(self) -> int:
        yield self.n

gen count(let n: int) -> int:
    yield n

fn check(let got: str, let want: str) -> None:
    if got != want:
        raise ValueError(f"got {got}, want {want}")
    print(got)

check(area.__name__, "area")
check(area.__qualname__, "area")
let doc: Option[str] = area.__doc__
if doc is str:
    check(doc, "Area of a rectangle.")
check(outer(), "outer.<locals>.inner")

let b = Box(3)
check(Box.get.__qualname__, "Box.get")
check(b.get.__name__, "get")
check(b.get.__qualname__, "Box.get")
check(b.helper_name(), "Box.helper_name.<locals>.helper")
check(b.items.__qualname__, "Box.items")
check(count.__name__, "count")
if count.__doc__ is None:
    print("count has no docstring")

mut xs: list[int] = []
check(xs.append.__name__, "append")
check(xs.append.__qualname__, "list.append")
