# let_immutability.ar — `let` の不変性が守られる 3 つの場面（bug_fix.md B8/B9/B11 系統）。
#
# Arrow の束縛の規則:
#   **参照を共有するのは `let → let` のときだけ。それ以外は必ずディープコピーする。**
#   ⇒ 共有している 2 つの束縛は必ず両方 `let` ＝ どちらからも変更できない。
#
# 関数の引数だけは別ルール:
#   `let` / `mut` は「**関数内で値を書き換えるか**」の宣言。`mut` パラメータに `mut` 変数を
#   渡して呼び出し元まで書き変わるのは**正しい仕様**だが、`let` 変数を渡すのは**エラー**。

print("=== L2: 式から let へ束縛しても共有しない ===")
# ⚠ 以前は「複製するかどうか」が**式の形**で決まっており、`let x = <変数名>` は複製するのに
#   添字や属性を挟むと共有していた。⇒ `let` のスナップショットが後から変わった。
mut xs = [[1]]
let item = xs[0]
xs[0].append(9)
print(item)              # [1]        let の item は変わらない
print(xs)                # [[1, 9]]

class K:
    mut f: list
    fn __init__(mut self, let f: list) -> None:
        self.f = f
mut o = K([1])
let snap = o.f
o.f.append(9)
print(snap)              # [1]        フィールドから取った snap も独立

print("=== L3: for のループ変数はコンテナの属性を継ぐ ===")
# ⚠ 以前はループ変数が無条件に `mut` 扱いで、`let` のコンテナの要素を書き換えられた。
#   今は規則 1（要素は再帰的に属性を引き継ぐ）どおり、コンテナが `let` ならループ変数も `let`。
mut ys = [[1]]
for it in ys:
    it.append(9)         # ys は mut なので通る
print(ys)                # [[1, 9]]

# ⚠ `let zs` に対する `for it in zs: it = ...` は
#   StaticTypeError: cannot assign to immutable variable 'it' になる。
# ⚠⚠ `range(n)` やリテラルのような**一時値**の反復対象も `let`（規則 3・B4）。
#   その場で作られて誰とも共有していないので、書き換える意味が無い:
#     for i in range(3):
#         i = i * 10    # StaticTypeError: cannot assign to immutable variable 'i'
for i in range(3):
    print("range のループ変数も let:", i)

print("=== B8: let の中身は変更メソッドでも書き換えられない ===")
# ⚠⚠ 以前は**添字代入だけ**が弾かれ、メソッド経由は素通りだった。
#   `let a = [1]; a[0] = 9` はエラーなのに `a.append(9)` は通る、という食い違い。
#   今は同じ規則で弾く:
#     let a = [1]
#     a.append(9)   # StaticTypeError: cannot call 'append' on 'a' — it is immutable
#
# ⚠ **推移的にも効く**（規則 1: 要素は根の属性を引き継ぐ）:
#     let o = K([1]); o.f.append(9)      # 根の 'o' が let なので弾かれる
#     let w = [[1]]; w[0].append(9)      # 根の 'w' が let なので弾かれる
#     let zs = [[1]]; for it in zs: it.append(9)   # ループ変数も let を継ぐ
#
# ⚠ **ユーザー定義クラスは誤検出しない。** レシーバの型がコレクションのときだけ見るので、
#   `let` インスタンス自身の `remove()` のようなメソッドは通る（下の対照）。
mut ok = [1]
ok.append(9)             # mut なら通る
print(ok)                # [1, 9]

class Bag:
    mut n: int
    fn __init__(mut self, let n: int) -> None:
        self.n = n
    fn remove(let self) -> int:
        return self.n
let bag = Bag(5)
print(bag.remove())      # 5   同名でもユーザー定義メソッドは通る

print("=== B11: let を mut パラメータへ渡せない ===")
fn touch(mut v: list) -> None:
    v.append(9)

mut m = [1]
touch(m)                 # mut なら通る（呼び出し元まで書き変わるのが仕様）
print(m)                 # [1, 9]

touch([1])               # リテラルは一時値なので通る
print("リテラルは通る")

# ⚠ `let a = [1]; touch(a)` は
#   StaticTypeError: parameter 'v' of 'touch' expects a mutable argument, but got an immutable value
#   ⚠ `let` の**要素**も同じ（`let b = [[1]]; touch(b[0])` も弾かれる）。規則 1 のとおり。
