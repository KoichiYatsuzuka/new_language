# metafn_syntax_error.ar — メタ関数の構文が**パースはできるが、まだ展開できない**ことを固定する。
#
# タスク 1-1（構文解析）まで実装済み。展開器は Phase 2 なので、
# メタ関数の定義が実行まで届いたら**明示エラー**にする。
# ⚠ 黙って無視すると「メタ関数を書いたのに何も起きない」という最悪の失敗形になる。
#
# 設計は implementation_plans/comptime_metafn_design.md §1。
# ⚠ 成功例（実際に展開されるもの）は展開器の完成後に足す。
#
# 期待されるエラー（実行時）:
#   MetaError: metafunction 'make_greeting' was not expanded
#              (the compile-time expander is not implemented yet)

# ── 純粋メタ関数: `Code` を返す ──────────────────────────────────────────
exprconst fn make_greeting() -> Code:
    # ⚠ `code:` の中身は**パースされない**。未完の断片（本体の無い `if` など）も書ける。
    let body = code:
        print("hello")
    return body

# ── 入れ子関数（クロージャ）の中の `code:` ──────────────────────────────
# ⚠ `code:` は値を作るだけなので、メタ関数の中の普通の関数にも書ける。
#   `syntax_cov.ps1` の NESTED-GAP（入れ子関数で一度も書かれていない構文）を塞ぐ。
exprconst fn make_pair() -> Code:
    fn inner() -> Code:
        let frag = code:
            print("inner")
        return frag
    return inner()

# ── 配置メタ関数: `quote` で呼び出し位置へ置く ──────────────────────────
# ⚠ `quote` は関数を抜ける（設計書 §1.3）。
exprconst !fn place_greeting() -> None:
    quote make_greeting()

# ── 空の `Code`（設計書 §1.2 の B-2）────────────────────────────────────
# `code:` の直後にインデントが来なければ空になる。何も出さずに抜けるときに使う。
exprconst !fn place_nothing() -> None:
    let empty = code:
    quote empty

print("unreachable")
