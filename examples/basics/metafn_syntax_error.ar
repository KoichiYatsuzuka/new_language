# metafn_syntax_error.ar — メタ関数の構文が**パースはできるが、まだ展開できない**ことを固定する。
#
# タスク 1-1（構文解析）/ 1-2（スプライス）/ 1-3（`^`）まで実装済み。展開器は Phase 2 なので、
# メタ関数の定義が実行まで届いたら**明示エラー**にする。
# ⚠ 黙って無視すると「メタ関数を書いたのに何も起きない」という最悪の失敗形になる。
#
# 設計は implementation_plans/comptime_metafn_design.md §1。
# ⚠ 成功例（実際に展開されるもの）は展開器の完成後に足す。
#
# 期待されるエラー（実行時）:
#   MetaError: metafunction 'make_greeting' was not expanded
#              (the compile-time expander is not implemented yet)

# ── 純粋メタ関数: `Code` を返す ──────────────────────────────────────────
exprconst fn make_greeting() -> Code:
    # ⚠ `code:` の中身は**パースされない**。未完の断片（本体の無い `if` など）も書ける。
    let body = code:
        print("hello")
    return body

# ── スプライス `<! !>`（設計書 §1.4）─────────────────────────────────────
# ⚠ `code:` の中で**唯一パースされる**のがここ。中身は展開時に評価される普通の式で、
#   値がその位置のトークン列（変数名・型名など）に変換されて差し込まれる。
# ⚠ `code:` の外では書けない。失敗例は `metafn_splice_error.ar`。
exprconst fn make_binding(var_name: str, init: int) -> Code:
    let body = code:
        let <! var_name !> = <! init + 1 !>
    return body

# ── メタ情報演算子 `^`（設計書 §1.5）───────────────────────────────────
# ⚠ `^` は `.` より**強く**束縛する。`^T.fields` は `(^T).fields`、つまり
#   「メタ情報オブジェクトへの射影」であって「フィールド `T.fields` のメタ情報」ではない。
# ⚠ テンプレート実体化は対象側に含まれる（`^Box[int].fields`）。
# ⚠ 書けるのはメタ関数の中か呼び出しの実引数の中だけ。失敗例は `metafn_caret_error.ar`。
#   `^^` は廃止（D10）。失敗例は `metafn_double_caret_error.ar`。
exprconst fn describe(t) -> Code:
    let kind = ^t
    let members = ^t.fields
    let body = code:
        print(<! ^t.name !>)
    return body

# ── 入れ子関数（クロージャ）の中の `code:` と `^` ───────────────────────
# ⚠ `code:` も `^` も値を作るだけなので、メタ関数の中の普通の関数にも書ける。
#   `syntax_cov.ps1` の NESTED-GAP（入れ子関数で一度も書かれていない構文）を塞ぐ。
exprconst fn make_pair(t) -> Code:
    fn inner() -> Code:
        let kind = ^t
        let frag = code:
            print("inner")
        return frag
    return inner()

# ── 配置メタ関数: `quote` で呼び出し位置へ置く ──────────────────────────
# ⚠ `quote` は関数を抜ける（設計書 §1.3）。
exprconst !fn place_greeting() -> None:
    quote make_greeting()

# ── 空の `Code`（設計書 §1.2 の B-2）────────────────────────────────────
# `code:` の直後にインデントが来なければ空になる。何も出さずに抜けるときに使う。
exprconst !fn place_nothing() -> None:
    let empty = code:
    quote empty

# ── 装飾子 `!名前`（設計書 §1.6）───────────────────────────────────────
# ⚠ 対象が**第一引数として渡る**。対象はクラス宣言・関数宣言・クラスフィールド宣言・
#   変数束縛の 4 つ。宣言でない文に付けると弾かれる（`metafn_decorator_error.ar`）。
# ⚠ `@` は実行時クロージャ装飾子として据え置き。別物なので混ぜない。
# ⚠ クラスメンバーへの装飾は `metafn_decorator_member_error.ar` を参照
#   （展開器が無い間は「黙って無視」を避けるため明示エラーにしてある）。
!place_nothing
fn decorated_fn() -> int:
    return 1

# 引数付き・積み重ねも書ける。上から順に並ぶ。
!place_nothing
!place_greeting
let decorated_binding = 1

print("unreachable")
