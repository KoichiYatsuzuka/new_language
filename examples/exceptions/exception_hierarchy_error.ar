# exception_hierarchy_error.ar — 親の例外を子の型へは入れられない（python_builtins_plan.md のタスク 4-1）
#
# 対になる正常系: exception_hierarchy.ar
#
# 期待されるエラー（静的）:
#   StaticTypeError: 'e' is declared 'KeyError' but initialized with 'LookupError'
#
# ⚠ 逆向き（let e: LookupError = KeyError("k")）は通る。KeyError は LookupError の派生なので。

let e: KeyError = LookupError("not every lookup error is a key error")   # ⛔ 親は子ではない
print(e.message)
