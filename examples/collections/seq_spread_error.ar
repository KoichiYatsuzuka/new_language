# seq_spread_error.ar — 列リテラルの展開が**型検査で止まる**形。
#
# 期待されるエラー:
#   StaticTypeError: `*` expects an iterable, not 'int'
#
# ⚠ 他の形:
#   let c: list[int] = [*a, "s"]   要素型が合わない（a が list[int] のとき）
#     -> 'c' is declared 'list[int]' but initialized with 'list[Union[int,str]]'
#
# ⚠ **型が判らないときは通す**（`Any` / `Unresolved`）。実行時に
#   `TypeError: 'int' object is not iterable` になる。
#
# ⚠ **通る形**は `seq_spread.ar`。

let n = 5
mut c = [*n]
print(c)
