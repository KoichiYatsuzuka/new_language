# store_copy_semantics.ar — コンテナ・フィールドへの格納は複製される（bug_fix.md B8/B9/B11 系統・L4）。
#
# Arrow の束縛の規則:
#   **参照を共有するのは `let → let` のときだけ。それ以外は必ずディープコピーする。**
#   ⇒ 共有している 2 つの束縛は必ず両方 `let` ＝ どちらからも変更できない。
#
# この例題は、その規則が**代入だけでなく「格納」にも及ぶ**ことを固定する。
#
# ⚠⚠ 以前は格納が共有だったため、`let a` をコンテナに入れると
#   `lst[0].append(9)` で **`let` の `a` が変わった**（実測）。
#
# ⚠⚠ **帰結: 循環した構造が作れなくなった。** 格納時に複製されるので、自分自身を
#   入れても「追加時点のスナップショット」が入る。詳しくは
#   [equality_depth_limit_error.ar](equality_depth_limit_error.ar)。

# ⚠ タスク 8.1（案 A）で素の `list` 注釈は書けなくなった。この例題は同じフィールドへ
#   `list[int]` も `list[N]` も入れて「格納時に複製される」ことを見せるので、
#   要素型を `Any` と**明示する**。素の `list` と違い、`Any` は「何でも入る」ことを
#   綴りで宣言する（要素へ演算を掛けた瞬間に静的エラーになるので黙って通らない）。
class N:
    mut f: list[Any]
    fn __init__(mut self, let f: list[Any]) -> None:
        self.f = f

print("=== list への append ===")
# ⚠ タスク 4.1 以降、**注釈なしの空リテラルは `list[Any]`** になる（D-11 / U-6）。
#   `lst[0]` は `Any` になり、`Any` への属性アクセスには明示ダウンキャストが要る
#   （既存の規則）。⇒ 要素型を注釈で与えるのが素直。
let a = [1]
mut lst: list[list[int]] = []
lst.append(a)
lst[0].append(9)
print(a)                 # [1]        let の a は変わらない
print(lst)               # [[1, 9]]

print("=== dict への格納 ===")
let b = [1]
mut d: dict[str, list[int]] = {}
d["k"] = b
d["k"].append(9)
print(b)                 # [1]
print(d)                 # {'k': [1, 9]}

print("=== set への add ===")
# ⚠ ここも要素型を注釈で与える（`append` と同じ理由・タスク 5.2c）。
let c = [1]
mut s: set[list[int]] = {[0]}
s.add(c)
print(c)                 # [1]

print("=== 添字代入 ===")
# ⚠ ここも要素型を注釈で与える（上の `append` と同じ理由）。タスク 5.2b で
#   **添字代入の値も要素型と照合される**ようになったので、`mut lst2 = [0]`
#   （＝ `list[int]`）に `list[int]` を入れるのは静的エラーになる。
let e = [1]
mut lst2: list[list[int]] = [[0]]
lst2[0] = e
lst2[0].append(9)
print(e)                 # [1]

print("=== フィールドへの代入 ===")
mut src = [1]
mut o = N([])
o.f = src
src.append(9)
print(o.f)               # [1]        格納時のスナップショット
print(src)               # [1, 9]

print("=== 循環は作れない ===")
# ⚠ タスク 5.2c で **`append` の引数も要素型と照合される**ようになった。`mut z = [1]`
#   は `list[int]` に推論されるので、そこへ `z`（`list[int]`）は入らない。
#   ⇒ ここで見せたいのは「要素型を問わないリストへ自分を入れても循環しない」ことなので
#     **要素型を `Any` と書く**（`equality_depth_limit_error.ar` と同じ形）。
# ⚠ タスク 8.1（案 A）で**素の `list` 注釈は書けなくなった**。代わりが `list[Any]`。
#   `Any` は「何でも入る」ことを**明示**する綴りで、素の `list` と違って
#   要素へ演算を掛けた瞬間に静的エラーになる（黙って通らない）。
mut z: list[Any] = [1]
z.append(z)
print(z)                 # [1, [1]]   自己参照にならない

mut p = N([])
p.f = [p]
# ⚠ 要素型が `Any` なので、要素へ演算を掛けるには**明示ダウンキャスト**が要る
#   （タスク 8.1・案 A の帰結）。素の `list` のときは無検査で通っていた箇所。
print((p.f[0] mustbe N) === p)   # False      フィールド経由でも循環しない

print("=== 対照: let → let だけが共有する ===")
let g = [1]
let h = g
print(h === g)           # True
