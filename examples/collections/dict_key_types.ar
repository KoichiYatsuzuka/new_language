# dict_key_types.ar — 辞書のキーとして使える型（B1-c で**ほぼすべての型**に広がった）。
#
# 経緯:
#   - B1-a まで … `DictKey` が int / str / bool の 3 種しか持たず、他の型は
#                  **黙って捨てられていた**（サイレントなデータ消失）。
#   - B1-a      … 捨てるのをやめて `TypeError` にした。
#   - B1-c      … コンテナを `IndexMap<HKey, Value>` に差し替え、ハッシュを自分で計算して
#                  等値判定をクロージャで渡す方式にした。⇒ 型の制限が無くなった。
#
# ⚠ 禁止が残っているものは [dict_key_types_error.ar](dict_key_types_error.ar) を参照。

class P:
    let x: int
    fn __init__(mut self, let x: int) -> None:
        self.x = x

fn f() -> int:
    return 1

print("=== あらゆる型がキーになる ===")
mut d = {}
d[(1, 2)]  = "tuple"
d[[3, 4]]  = "list"
d[{5, 6}]  = "set"
d[P(7)]    = "instance"
d[f]       = "function"
d[P]       = "class"
d[int]     = "type"
d[uint(8)] = "uint"
d[3.5]     = "float"
d[1+2j]    = "complex"
d["s"]     = "str"
d[9]       = "int"
d[True]    = "bool"
print(len(d))                # 13

print("=== 構造が同じなら引ける（値の同一性で照合する）===")
print(d[(1, 2)])             # tuple
print(d[[3, 4]])             # list
print(d[P(7)])               # instance   別オブジェクトでも全フィールドが等しい
let same = (1, 2)
print(d[same])               # tuple

print("=== キーの照合は型厳密（B2-b）===")
# ⚠ 式としての `3 == 3.0` は True（数値の昇格ラティス）だが、**キーの同一性は型厳密**。
#   辞書はハッシュで束ねるので、ここが厳密でないとハッシュと規則が食い違う。
mut e = {}
e[3]   = "int key"
e[3.0] = "float key"
print(len(e), e[3], e[3.0])  # 2 int key float key

mut g = {}
g[1]    = "int"
g[True] = "bool"
print(len(g))                # 2   bool は数値の昇格ラティスに入っていない

print("=== キーは挿入時に複製される ===")
# ⚠ 参照を共有したままだと、あとで中身を書き換えられてハッシュと食い違い、
#   「入れたのに引けない」辞書になる。⇒ 属性の境界で複製する規則の一適用。
mut k = [1]
mut h = {}
h[k] = "v"
k.append(2)                  # 元の変数を変えても…
print(len(h), h[[1]], k)     # 1 v [1, 2]   辞書側は [1] のまま

print("=== 読み・包含・更新 ===")
mut m = {"a": 1}
m["a"] = 2
print(m["a"], "a" in m, "b" in m, "b" not in m)
print((1, 2) in d, (9, 9) in d)
