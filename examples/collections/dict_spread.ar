# dict_spread.ar — 辞書リテラルの合成 `{**other, key: value}`。
#
# ⚠ **型検査を通るときだけ合成できる**。展開元の要素型を持ち込んで合成するので、
#   キー・値の型が食い違えば代入時に捕まる:
#
#     let b = {"a": 1}
#     let a: dict[str, int] = {**b, "x": 2}     ✅
#     let a: dict[str, int] = {**b, 3.0: 2}     ⛔ キー型が合わない
#
# ⚠ **後から来たキーが勝つ**（Python と同じ）。順序は AST に残し、合成の意味は
#   評価側（`DictEntry::Spread` / `Op::DictMerge`）が決める。
#
# ⚠ 展開元が辞書でなければ**静的エラー**（実行時 `TypeError` と同じ意味を静的に見る）。
# ⚠ 型が判らないとき（`Any` / 素の `dict`）は `Any` として通す。
#   **`Unresolved` にはしない** —— `Unresolved` は下流で万能受容体になり、
#   キー型の食い違いを素通しさせてしまうため。

let b = {"a": 1}

# ── ① 展開 + 追加 ───────────────────────────────────────────────────────
let a: dict[str, int] = {**b, "x": 2}
print(a)
# {'a': 1, 'x': 2}

# ── ② 追加 + 展開（順序どおり） ─────────────────────────────────────────
let c: dict[str, int] = {"z": 0, **b}
print(c)
# {'z': 0, 'a': 1}

# ── ③ 展開が 2 つ ───────────────────────────────────────────────────────
let d: dict[str, int] = {**b, **c}
print(d)
# {'a': 1, 'z': 0}

# ── ④ 展開だけ（複製） ──────────────────────────────────────────────────
let e: dict[str, int] = {**b}
print(e)
# {'a': 1}

# ── ⑤ 後から来たキーが勝つ ──────────────────────────────────────────────
let f: dict[str, int] = {**b, "a": 99}
print(f)
# {'a': 99}

# ── ⑥ 先に書いたほうが負ける ────────────────────────────────────────────
let g: dict[str, int] = {"a": 99, **b}
print(g)
# {'a': 1}

# ── ⑦ 注釈なしでも要素型が推論される ────────────────────────────────────
mut h = {**b, "x": 2}
print(h)
# {'a': 1, 'x': 2}
