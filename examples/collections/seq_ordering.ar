# seq_ordering.ar — list 同士・tuple 同士の大小比較（python_builtins_plan.md のタスク 1-3）
#
# 対になる誤りの例: seq_ordering_error.ar
#
# CPython の list_richcompare / tuplerichcompare と同じ 2 段構え:
#   1. `==` で最初に違う要素を探す
#   2. あればその要素だけを、求められた演算子で比べる
#   3. 無ければ（短い方が尽きたら）長さで決める
# ⚠ 以前は静的にも実行時にも誤り（`cannot compare 'tuple[int, int]' ...` / `unsupported operand types for 'Lt'`）だった。
#   sorted / min / max でタプルを鍵にする形（python_builtins_plan.md の 3-2）の前提。

print("=== 1. the first differing element decides ===")
print([1, 2] < [1, 3], (2, 1) > (1, 9))         # True True
print((1, "b") < (1, "a"))                       # False

print("=== 2. a shorter prefix is smaller ===")
print((1, 2) < (1, 2, 0), [1, 2] <= [1, 2])     # True True
print([] < [0])                                  # True

print("=== 3. nested and mixed numbers ===")
print([[1, 2], [3]] < [[1, 2], [4]])             # True
print([1, 2.5] > [1, 2])                         # True

print("=== 4. pick the latest (year, month) ===")
let rows: list[tuple[int, int]] = [(2024, 3), (2025, 1), (2025, 2)]
mut best = rows[0]
for r in rows:
    if r > best:
        best = r
print(best)                                      # (2025, 2)
