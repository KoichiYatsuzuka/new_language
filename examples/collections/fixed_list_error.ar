# fixed_list_error.ar — error example for fixed_list.
#
# Appending an instance of the wrong class raises a TypeError.

class Foo:
    mut x: float
    fn __init__(mut self, x: float) -> None:
        self.x = x

class Bar:
    mut y: float
    fn __init__(mut self, y: float) -> None:
        self.y = y

mut pts: list[Foo] = [Foo(1.0), Foo(2.0)]
mut fl = pts => fixed_list[Foo]
# ⚠⚠ タスク 5.2c で**実行時 → 静的へ昇格した**。以前は
#   `TypeError: fixed_list.append(): expected instance of 'Foo', got 'Bar'` という
#   実行時エラーだったが、`append` の引数を要素型と照合するようになったので
#   **実行前に**弾かれる。実行時検査は残してある。
fl.append(Bar(3.0))   # StaticTypeError: argument of `fixed_list[Foo].append()` expects 'Foo' 
