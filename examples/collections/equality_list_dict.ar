# equality_list_dict.ar — `list` / `dict` の `==` 比較（B2）。
#
# ⚠ 以前は `values_eq` に `List` / `Dict` の腕が無く `_ => false` に落ちていたため、
#   `[1,2] == [1,2]` はもちろん **`a == a`（同一オブジェクト）すら False** だった。
#   参照比較になっていたのではなく純粋な抜けで、**エラーにならないので気付けなかった**。
#   この形の例題が 1 本も無かったことが、全ゲートを素通りしていた理由。

print("=== list ===")
print([1, 2] == [1, 2])          # True
print([1, 2] == [1, 3])          # False
print([1, 2] == [1])             # False   長さ違い
print([] == [])                  # True

mut a = [1, 2]
print(a == a)                    # True    同一オブジェクト
print(a != a)                    # False   `!=` は `==` の否定

print("=== dict ===")
print({"a": 1} == {"a": 1})      # True
print({"a": 1} == {"a": 2})      # False   値違い
print({"a": 1} == {"b": 1})      # False   キー違い
print({"a": 1, "b": 2} == {"b": 2, "a": 1})   # True   順序は無関係

print("=== 入れ子 ===")
print([[1], [2]] == [[1], [2]])              # True
print({"k": [1, 2]} == {"k": [1, 2]})        # True
print([{"k": 1}] == [{"k": 1}])              # True

print("=== 他のコレクションは元から正しい（対照） ===")
print((1, 2) == (1, 2))          # True
print({1, 2} == {1, 2})          # True

print("=== `===`（参照同一性）は別物 ===")
# ⚠ `==` は構造比較、`===` は `Rc::ptr_eq`。混ぜないこと。
print([1] === [1])               # False   構造は同じでも別オブジェクト
print(a === a)                   # True

print("=== 包含検査も `==` を使う ===")
print([1, 2] in [[1, 2], [3]])   # True
print([9] in [[1, 2], [3]])      # False
