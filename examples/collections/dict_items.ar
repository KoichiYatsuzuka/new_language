# dict_items.ar — `dict.items()`（`(キー, 値)` タプルのリスト）。
#
# 多ターゲット `for` と組み合わせる形が主目的:
#   for k, v in d.items():
#
# ⚠ 既存の `keys()` / `values()` と揃えて**リストを返す**（CPython のビューではない）。
#   ＝ **スナップショット**なので、走査中に元の辞書を変更してもこの列は変わらない
#   （CPython は走査中の変更を `RuntimeError` にする）。
# ⚠ 別名は無い。`keys()` には `key()`、`values()` には `item()` という別名があるが、
#   `items()` は `item()` が既に `values()` の別名として埋まっているため 1 つだけ。

mut d = {"a": 1, "b": 2, "c": 3}

# ── ① そのまま表示 ──────────────────────────────────────────────────────
print(d.items())
# [('a', 1), ('b', 2), ('c', 3)]

# ── ② 多ターゲット for で分解する（主目的の形） ─────────────────────────
mut total = 0
for k, v in d.items():
    print(k + "=" + str(v))
    total = total + v
print(total)
# a=1
# b=2
# c=3
# 6

# ── ③ 挿入順が保たれる ──────────────────────────────────────────────────
mut order = {"z": 1, "a": 2}
print(order.items())
# [('z', 1), ('a', 2)]

# ── ④ 空の辞書 ──────────────────────────────────────────────────────────
mut empty: dict[str, int] = {}
print(empty.items())
# []

# ── ⑤ keys() / values() と同じ並び ──────────────────────────────────────
print(d.keys())
print(d.values())
# ['a', 'b', 'c']
# [1, 2, 3]

# ── ⑥ スナップショットである（走査前に取った列は変更に影響されない） ────
mut snap = d.items()
d["d"] = 4
print(len(snap))
print(len(d.items()))
# 3
# 4
