# dxlib_string.ar — pass strings to DxLib's `const TCHAR*` parameters.
#
# Calls SetWindowText (sets the window title bar) and DrawString (renders
# text on screen). A C string parameter takes bytes (ffi_value_exchange_plan.md
# 4-3 / D-13): encode the str in the library's encoding — DxLib uses Shift-JIS
# (cp932) unless SetUseCharCodeFormat says otherwise. Passing a str used to be
# converted to UTF-8 silently, which garbles Japanese text in DxLib.
# `TCHAR` comes from the Windows SDK headers listed in ar_config.json (`cpp.system_headers`):
# without UNICODE it is `char`, so `const TCHAR*` takes bytes (ffi_value_exchange_plan.md 7-13).

# the DxLib SDK is in examples/DxLib (two levels up: `...`)
import[cpp-lib] ...DxLib.DxLib as dx

dx.ChangeWindowMode(1)
dx.SetAlwaysRunFlag(1)          # keep running while the window is inactive (DxLib pauses it by default)
dx.SetGraphMode(640, 480, 32, 60)
dx.SetWaitVSyncFlag(0)

if dx.DxLib_Init() == -1:
    raise RuntimeError("DxLib_Init failed")

# Pass a tl string to a const char* parameter
dx.SetWindowTextDX("Arrow - string test".encode("cp932"))

const FPS      = 60
const FRAME_MS = 1000 // FPS

let white  = dx.GetColor(255, 255, 255)
let yellow = dx.GetColor(255, 255,   0)
let cyan   = dx.GetColor(  0, 255, 255)

mut frame_count = 0
mut running     = 1

while running == 1:
    if dx.ProcessMessage() != 0:
        running = 0
        continue

    dx.ClearDrawScreen()

    # Draw several strings — each passes a tl str as const char*
    dx.DrawString(20,  40, "Hello from Arrow!".encode("cp932"),            white)
    dx.DrawString(20,  70, "日本語も Shift-JIS で渡す".encode("cp932"),     yellow)
    dx.DrawString(20, 100, "str -> bytes with an explicit encoding".encode("cp932"), cyan)

    dx.ScreenFlip()
    dx.WaitTimer(FRAME_MS)

    frame_count += 1
    if frame_count >= 300:   # run for 5 seconds at 60 fps
        running = 0

dx.DxLib_End()
