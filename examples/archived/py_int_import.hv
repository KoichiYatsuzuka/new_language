import[py-int] py_calculator as calc

# PyO3 経由で Python 関数を呼び出す
let r1 = calc.add(3, 7)
print(r1)

let r2 = calc.multiply(4, 5)
print(r2)

let r3 = calc.subtract(10, 3)
print(r3)

# Python クラスのインスタンス化とメソッド呼び出し
let c = calc.Calculator("my_calc")
let result = c.compute("add", 10, 20)
print(result)

# 定数アクセス
let pi = calc.PI
print(pi)
