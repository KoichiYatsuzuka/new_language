# swd_nested.hv — SWD nested class module for native compilation test
# Compile with: cargo run --release -- --compile examples/test_modules/swd_nested.hv

class Vec2:
    mut x: int
    mut y: int

    fn __init__(mut self, x: int, y: int) -> None:
        self.x = x
        self.y = y

class Particle:
    mut pos: Vec2
    mut vel: Vec2

    fn __init__(mut self, pos: Vec2, vel: Vec2) -> None:
        self.pos = pos
        self.vel = vel

# Sum kinetic energy proxy: vx^2 + vy^2 for each particle.
fn sum_ksq(particles: fixed_list[Particle]) -> int:
    mut total: int = 0
    for p in particles:
        total += p.vel.x * p.vel.x + p.vel.y * p.vel.y
    return total

# Count particles moving in positive x direction.
fn count_moving_right(particles: fixed_list[Particle]) -> int:
    mut n: int = 0
    for p in particles:
        if p.vel.x > 0:
            n += 1
    return n
