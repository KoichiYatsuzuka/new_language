# template_module_error.ar — import したモジュールのテンプレートの具体化も型検査される（タスク 2-15）
#
# 対になる正常系: template_module.ar
#
# Section 1 — StaticTypeError: モジュール名つきの具体化のメソッド引数の型違い
#   Expected error (StaticTypeError):
#     argument 0 of 'Box[int].set' expects 'int' but got 'str'
#
# Section 2 — StaticTypeError: from import した名前での具体化のコンストラクタの型違い
#   Expected error (StaticTypeError):
#     argument 0 of 'Box[str]' expects 'str' but got 'int'
#
# Section 3 — StaticTypeError: import したテンプレート関数の戻り値の型違い
#   Expected error (StaticTypeError):
#     'n' is declared 'str' but initialized with 'int'
#
# Section 4 — StaticTypeError: 具体化した本体の誤り（型引数を選んだ側の誤り）
#   `Counter[str]` の `reset` は `str` のフィールドに `0` を入れる。
#   ⚠ モジュールの本体の誤りは import 側には出さない（モジュールを直接実行したときに出る）が、
#     **型引数が原因の誤り**は import 側の誤りなので出す。
#   Expected error (StaticTypeError):
#     field 'v' of class 'Counter[str]' is declared 'str' but got 'int'

import template_modules.containers as c
from template_modules.containers import Box, first

mut b = c.Box[int](1)
b.set("wrong")

let s = Box[str](0)

let n: str = first[int]([1])

let k = c.Counter[str]("x")
