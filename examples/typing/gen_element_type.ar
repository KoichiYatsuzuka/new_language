# gen_element_type.ar — ジェネレータの要素型は呼び出しの先まで伝わる（フェーズ10 10-7）
#
# 対になる誤りの例: gen_element_type_error.ar
#
# ⚠ 以前は `gen` の呼び出しの結果に型が付かず（`gen` の名前が型なしで宣言されていた）、
#   `for s in each(xs):` の `s` の型が分からなかった。`let z: str = s` のような誤りが
#   静的にも実行時にも止まらなかった。
# ⚠ `gen f() -> T` を呼んだ結果は `generator[T]`（産出型ではなくジェネレータ）。
#   `for` の変数・`next()` の結果の型はこの `T` になる。
#   注釈にも `generator[T]` と書ける。要素型を書かない `generator` はどの `generator[T]` も受ける。

gen each(let items: list[int]) -> int:
    for x in items:
        yield x

# 1. 最上位の gen: 要素は int
mut total = 0
for s in each([1, 2, 3]):
    let z: int = s
    total += z
print(total)                      # 6

# next() の結果も要素の型
let g = each([5, 6])
let head: int = g.next()
print(head)                       # 5

# 2. 入れ子の gen
fn doubled(let xs: list[int]) -> list[int]:
    gen inner() -> int:
        for x in xs:
            yield x * 2
    mut out: list[int] = []
    for v in inner():
        out.append(v)
    return out

print(doubled([1, 2]))            # [2, 4]

# 3. gen メソッド
class Bag:
    mut items: list[str]

    gen each(self) -> str:
        for it in self.items:
            yield it

let b = Bag(["a", "b"])
for it in b.each():
    let t: str = it
    print(t.upper())              # A / B

# 4. 注釈 `generator[T]` と素の `generator`
fn evens(let n: int) -> generator[int]:
    gen g() -> int:
        mut i = 0
        while i < n:
            yield i * 2
            i += 1
    return g()

fn anything(let n: int) -> generator:
    return each([n])

for e in evens(3):
    let k: int = e
    print(k)                      # 0 / 2 / 4
for a in anything(7):
    print(a)                      # 7

fn first(let g: generator[int]) -> int:
    for v in g:
        return v
    return -1

print(first(each([9, 8])))        # 9
