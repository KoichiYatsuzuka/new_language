# bytes_basics.ar — 組み込み型 bytes（不変のバイト列・ffi_value_exchange_plan.md 3-1・D-9）
#
# C の `char*` などを文字列に変換する前のまま扱うための型。`str` とは別の型で、変換は文字コードを書いて
# 明示的に行う（`s.encode(enc)` / `b.decode(enc)`）。黙って UTF-8 とみなさない（Shift-JIS のライブラリで
# 文字化けが黙って起きるのを防ぐ・D-13）。
# ⚠ 以前の `str.encode()` は文字コードの引数を無視して UTF-8 の `list[int]` を返していた。
#
# ⚠ ゲートの多くは exit code しか見ないので、期待値と違えば raise する。

fn check(let label: str, let ok: bool) -> None:
    if not ok:
        raise ValueError(label + ": unexpected value")
    print(label + " OK")

# ── 作る・表示する ────────────────────────────────────────────────────────────
let raw = bytes([104, 105, 255])
print(raw)
check("bytes(list[int])", raw == bytes([104, 105, 255]) and raw is bytes)
check("empty", len(bytes()) == 0 and not bytes())
let utf8: bytes = "héllo".encode()
check("str.encode() is UTF-8 by default", len(utf8) == 6 and utf8[1] == 195)

# ── 添字・スライス・反復・連結・比較・in ───────────────────────────────────────
check("index is int", raw[0] == 104 and raw[-1] == 255)
check("slice is bytes", raw[0:2] == "hi".encode())
mut total = 0
for x in raw:
    total += x
check("iteration yields int", total == 464)
check("concatenation", raw[0:2] + bytes([33]) == "hi!".encode())
check("ordering", bytes([1, 2]) < bytes([1, 3]) and bytes([2]) > bytes([1, 9]))
check("in: a sub-sequence or a byte", "hi".encode() in raw and 255 in raw and not (7 in raw))
check("dict key / set element", {raw: 1}[bytes([104, 105, 255])] == 1 and len({raw, bytes(raw)}) == 1)

# ── 文字コード ────────────────────────────────────────────────────────────────
let sjis = "日本語".encode("shift_jis")
print(sjis)
check("Shift_JIS round trip", len(sjis) == 6 and sjis.decode("cp932") == "日本語")
check("UTF-16LE (wchar_t on Windows)", "aé".encode("utf-16-le") == bytes([97, 0, 233, 0]))
check("latin-1 maps bytes to U+0000..U+00FF", bytes([233]).decode("latin-1") == "é")

# ── 変換できないものは ValueError（置き換え文字にしない）───────────────────────
mut errors = 0
try:
    let s = raw.decode("utf-8")
    print("unreachable:", s)
except ValueError as e:
    errors += 1
    print("invalid UTF-8: " + e.message)
try:
    let b = "😀".encode("shift_jis")
    print("unreachable:", b)
except ValueError as e:
    errors += 1
    print("not in Shift_JIS: " + e.message)
try:
    let b = bytes([300])
    print("unreachable:", b)
except ValueError as e:
    errors += 1
    print("byte out of range: " + e.message)
check("three ValueErrors", errors == 3)

# ── 関数の中から ──────────────────────────────────────────────────────────────
fn checksum(let data: bytes) -> int:
    mut acc = 0
    for x in data:
        acc = (acc + x) % 256
    return acc

check("bytes in a function", checksum("abc".encode()) == 38)
