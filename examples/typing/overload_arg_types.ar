# overload_arg_types.ar — オーバーロードを実引数の型で解決する（タスク 5.7）
#
# ## 何が壊れていたか
#
# オーバーロードの絞り込みは**引数の個数だけ**で行われ、個数の合う候補が 2 つ以上あると
# 検査を**丸ごと諦めて**いた（`count_matching.len() != 1` で `return`）。
#
#     class C:
#         fn m(self, let v: int) -> int: ...
#         fn m(self, let v: str) -> int: ...
#     c.m(1.5)        # ⇒ 素通り。実測では 1.5 を出していた
#
# ⚠⚠ つまり**オーバーロードを書いた瞬間に、その呼び出しの型検査が消えて**いた。
# 引数が 1 本しかない関数より、オーバーロードした関数の方が**緩い**という逆転。
#
# ## 絞り込みの規則
#
# | 残った候補 | 動作 |
# |---|---|
# | ちょうど 1 つ | それを使う（以降の引数検査が普通に走る） |
# | 0 個 | `no overload of ... accepts argument types (...)` |
# | 2 つ以上 | **絞り込まない**（どれを選んでも嘘になりうる） |
#
# ⚠ 安全側に倒す条件（いずれかに当たれば絞り込まない）:
# キーワード引数・可変長引数が混ざっている／候補に可変長パラメータがある／
# 実引数に判定材料の無い型（`Unresolved` / `Any`）がある。
#
# 弾かれる例は overload_arg_types_error.ar

print("=== メソッドのオーバーロード ===")

class Formatter:
    mut prefix: str

    fn fmt(self, let v: int) -> str:
        return self.prefix + "int:" + str(v)

    fn fmt(self, let v: str) -> str:
        return self.prefix + "str:" + v

let f = Formatter("> ")
print(f.fmt(42))                    # > int:42
print(f.fmt("hi"))                  # > str:hi

print("=== 自由関数のオーバーロード ===")

fn describe(let v: int) -> str:
    return "int " + str(v)

fn describe(let v: bool) -> str:
    return "bool " + str(v)

print(describe(7))                  # int 7
print(describe(True))               # bool True

print("=== 絞り込めた候補の引数検査は普通に走る ===")

class Box2:
    mut n: int

    fn put(self, let v: list[int]) -> int:
        return len(v)

    fn put(self, let v: str) -> int:
        return len(v)

let b = Box2(0)
print(b.put([1, 2, 3]))             # 3
print(b.put("abcd"))                # 4

print("=== Any の実引数は絞り込まない（どの候補も通りうる） ===")

let anything: Any = 5
print(f.fmt(anything))              # > int:5

print("done")
