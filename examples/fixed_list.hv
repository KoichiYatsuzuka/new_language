# fixed_list.hv — demonstrates the mutable fixed_list type and list_like trait.
#
# fixed_list[T] is a flat-memory list created by casting list[T].
# When declared as `mut`, supports append with automatic growth (doubles capacity).
# freeze trims unused allocation back to len.
# Both list and fixed_list implement the list_like trait (including append).

class Vec2:
    mut x: float
    mut y: float

    fn __init__(mut self, x: float, y: float) -> None:
        self.x = x
        self.y = y

# A function that accepts either list or fixed_list via list_like trait
fn sum_x(items: list_like[Vec2]) -> float:
    mut total = 0.0
    for v in items:
        total += v.x
    return total

# Build a mutable list and append to it
mut lst: list[Vec2] = [Vec2(1.0, 2.0)]
lst.append(Vec2(3.0, 4.0))
lst.append(Vec2(5.0, 6.0))
print("sum_x(lst) =", sum_x(lst))   # 9.0

# Cast list => fixed_list (flat conversion: fields alphabetical x, y)
mut fl: fixed_list[Vec2] = lst => fixed_list[Vec2]
print("len(fl) =", len(fl))                    # 3
print("allocated_size =", fl.allocated_size())  # 3

# Append to mutable fixed_list (triggers capacity growth)
fl.append(Vec2(7.0, 8.0))
print("after append: len =", len(fl))               # 4
print("after append: allocated_size =", fl.allocated_size())  # 6 (doubled from 3)
print("sum_x(fl) =", sum_x(fl))     # 16.0

# Subscript access works as before
let first = fl[0]
print("fl[0].x =", first.x)         # 1.0
print("fl[3].y =", fl[3].y)         # 8.0

# freeze trims unused allocation to exactly len
freeze fl
print("after freeze: len =", len(fl))               # 4
print("after freeze: allocated_size =", fl.allocated_size())  # 4

# Cast back fixed_list => list
let back: list[Vec2] = fl => list[Vec2]
print("len(back) =", len(back))      # 4

# Iteration
for p in fl:
    print(p.x, p.y)
