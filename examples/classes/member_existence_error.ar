# member_existence_error.ar — 存在しないメンバー（タスク 7.5）
#
# 正常系は member_existence.ar
#
# ⚠ 以前は**実行時まで判らなかった**（検体 `M1` / `M2`）。Arrow は
# 「すべてのフィールドはクラス本体で宣言しなければならない」ので、
# メンバー集合は静的に確定する。
#
# 期待されるエラー:
#   StaticTypeError  'C' has no member 'nope'
#   StaticTypeError  'C' has no member 'missing'

class C:
    mut n: int

let c = C(1)

print(c.nope)                       # ⛔ 存在しないフィールド

print(c.missing())                  # ⛔ 存在しないメソッド
