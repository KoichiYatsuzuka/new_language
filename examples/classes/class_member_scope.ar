# class_member_scope.ar — クラスのメンバーは `self.x` / `C.K` で読む（name_scope_plan.md の 1-3）
#
# エラー系は class_member_scope_error.ar
#
# メンバー（フィールド・`const`・`static mut`・メソッド）は変数ではないので、メソッドの中でも
# 裸の名前では見えない。読むときは `self.x`（インスタンスのメンバー）か `C.K`（`const` / `static mut`）と書く。
# ⇒ メンバーと同じ名前のローカル・最上位の変数は、メンバーとぶつからない（以前は型検査が
#   メンバーをクラスのスコープの変数として扱い、`let font = ..` が再宣言の誤りになっていた）。

let size = 100                       # メンバーの `size` とは別の、最上位の変数

class EditorConfig:
    let font: str
    mut size: int
    const DEFAULT: int = 12
    static mut opened: int = 0

    fn __init__(mut self, font: str) -> None:   # 引数とフィールドが同じ名前でもよい
        self.font = font
        self.size = EditorConfig.DEFAULT
        EditorConfig.opened += 1

    fn describe(self) -> str:
        let font = "(" + self.font + ")"        # フィールドと同じ名前のローカル
        return font + " " + str(self.size)

    fn helper(self) -> int:
        return 1

    fn outer_size(self) -> int:
        return size + self.helper()               # 裸の `size` は最上位の変数（前方参照ではなく既に束縛済み）

    fn later(self) -> int:
        return LATER                              # 後で束縛する最上位の名前（呼ぶ時点では束縛済み）

let LATER = 7

let c = EditorConfig("mono")
print(c.describe())
print(c.outer_size())
print(c.later())
print(EditorConfig.opened)
