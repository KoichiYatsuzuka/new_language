# definition_context_expr.ar — 定義文脈で使う制御フロー式（#33 で発見）
#
# クラスのフィールド既定値や enum の値は**定義文の一部**なので、インタプリタが
# `eval()` で評価する（VM の Chunk には載らない）。そこに `block:` / `if` / `for` 式を
# 書くと、**その中身はツリーウォークで実行される**（本体の `for` 文や `continue` も含む）。
#
# ⚠ この形の例題が 1 本も無かったため、`AR_TW_STATS` の `tw_control_flow` が 0 になり
#    「制御フローを持つツリーウォークは残っていない」という判断が例題依存になっていた（#33）。
#    ここを削るとその穴が再発する。

print("=== 1. class field default: block expression ===")
class Boxed:
    const v: int = block ->int:
        block_return 3

let b = Boxed()
print(b.v)                        # 3

print("=== 2. class field default: if expression ===")
class Picked:
    const w: int = if True ->int:
        block_return 4
    else:
        block_return 9

let p = Picked()
print(p.w)                        # 4

print("=== 3. class field default: for expression (loop_yield) ===")
class Listed:
    const xs: list[int] = for i in range(3) ->list[int]:
        loop_yield i

let l = Listed()
print(l.xs)                       # [0, 1, 2]

print("=== 4. statements inside a definition-context block expression ===")
# ブロック式の**中の文**（for / if / continue / block_return）もツリーウォークが実行する
class Summed:
    const total: int = block ->int:
        mut s = 0
        for i in range(4):
            if i == 2:
                continue
            s = s + i
        block_return s

let s = Summed()
print(s.total)                    # 4  (0 + 1 + 3)

print("=== 5. enum value from a block expression ===")
enum Code:
    Ok = block ->int:
        block_return 200
    NotFound = 404

print(Code.NotFound.value)        # 404
