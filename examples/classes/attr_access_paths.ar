# attr_access_paths.ar — 属性アクセスの各経路を網羅する（#16 段階(b)(i)）
#
# VM は `local.attr` を超命令 `GetAttrLocal` へ融合し、レシーバを frame から
# **参照で**読む（`Value` の clone ＝ Rc refcount 増減を省く）。フォールバックは
# 従来どおり R3 インラインキャッシュ経由の `GetAttr`。
#
# この例題はその両経路と、キャッシュが外れる場合を通す:
#   - 局所変数レシーバ（融合対象）／ネスト属性 `o.inner.v`（外側は非局所）
#   - public / private フィールド（アクセス制御）
#   - 同じ命令に別クラスが流れる場合（テンプレート経由 → IC ミス→再解決）
#   - 存在しない属性（AttributeError）
#
# 検証: .\compare_vm_modes.ps1 -Filter attr_access_paths

trait HasPub:
    mut pub_f: int

class Inner:
    mut v: int
    fn __init__(mut self, let v: int) -> None:
        self.v = v

class Outer:
    mut inner: Inner
    mut tag: str
    fn __init__(mut self, let inner: Inner, let tag: str) -> None:
        self.inner = inner
        self.tag = tag

# ⚠ `pub_f` は trait `HasPub` が宣言しているので**クラス側で再宣言しない**（再宣言は禁止）。
#   無修飾 `self.pub_f` / `b.pub_f` でそのまま読み書きできる。
class Base(HasPub):
    private:
    mut priv_f: int

    fn __init__(mut self) -> None:
        self.pub_f = 1
        self.priv_f = 2

    fn read_priv(self) -> int:
        return self.priv_f

class Other(HasPub):
    fn __init__(mut self) -> None:
        self.pub_f = 30

fn read_local(let o: Outer) -> None:
    print(o.tag)
    print(o.inner.v)
    print(o.inner.v + 1)

fn read_base(let b: Base) -> None:
    print(b.pub_f)
    print(b.read_priv())

fn write_read(mut o: Outer) -> None:
    o.tag = "changed"
    print(o.tag)
    o.inner.v = 99
    print(o.inner.v)

# 同じ op に別クラスが流れる（IC ミス→再解決を強制）
fn show_pub[T: HasPub](let it: T) -> None:
    print(it.pub_f)

# ⚠⚠ **タスク 7.5 で `o.nope` が静的エラーになった**（メンバーの存在検査）。
#   この節の意図は「**実行時**に `AttributeError` を捕まえる」ことなので、
#   **メンバー集合が閉じていない型**から同じアクセスへ到達させる。
#
# ⚠⚠ 以前は「素の `list` の要素」で型を隠していたが、タスク 8.1（案 A）で
#   素の容器型注釈が禁止されたので使えない（`list[Any]` は `Any` への
#   メンバーアクセス自体が静的エラーなので代わりにならない）。
#   ⇒ 受け手を `complex` にした。組み込み型のうち**メンバー集合を静的に持たない**ので
#     `z.nope` は静的検査を通り、実行時に `AttributeError` になる
#     （`examples/basics/complex_error.ar` が同じ経路を捕まえずに見せている）。
fn missing() -> None:
    let z: complex = 1 + 2j
    try:
        print(z.nope)
    except AttributeError as e:
        print("caught missing attr")

let inner = Inner(7)
let o = Outer(inner, "hello")
read_local(o)
read_base(Base())
write_read(Outer(Inner(1), "orig"))
show_pub[Base](Base())
show_pub[Other](Other())
show_pub[Base](Base())
missing()
