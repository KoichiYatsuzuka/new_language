# const_member_assign_error.ar — `const` なメンバーは、代入も中身の書き換えも静的エラー
#
# 計画: implementation_plans/enum_member_type_plan.md（5-2・5-3）
# 正常系（`static mut` は書ける）は static_mut_assign.ar
# モジュールの `const` は examples/basics/module_const_assign_error.ar
#
# `const` なメンバーはクラスの `const`・trait の `const`・enum のメンバー（暗黙に `const`）で、
# どれも同じ規則で弾く:
#   - メンバーへの代入（`C.K = ..` / `c.K = ..` / `self.K = ..`・`__init__` の中も）→ AssignToConst
#   - 中身の書き換え（`C.L[0] = ..` / `C.L.append(..)` / `C.O.x = ..`・インスタンス経由も）→ ModifyConst
#
# ⚠ 以前はインスタンス経由の代入だけが静的に弾かれ、ほかは実行時の `TypeError` まで通るか、
#   **完走してクラスで共有する `const` を書き換えていた**（`c.L.append(2)` など）。
#
# 期待されるエラー:
#   StaticTypeError  cannot assign to const 'Counter.LIMIT'
#   StaticTypeError  cannot assign to const 'Counter.LIMIT'
#   StaticTypeError  cannot assign to const 'Counter.LIMIT'
#   StaticTypeError  cannot assign to const 'Counter.LIMIT'
#   StaticTypeError  cannot modify the contents of const 'Counter.NAMES'
#   StaticTypeError  cannot modify the contents of const 'Counter.NAMES'
#   StaticTypeError  cannot modify the contents of const 'Counter.ORIGIN'
#   StaticTypeError  cannot assign to const 'Counter.UNIT'
#   StaticTypeError  cannot assign to const 'Color.BLUE'

class Point:
    mut x: int

trait Measured:
    const UNIT: str = "cm"

class Counter(Measured):
    const LIMIT: int = 100
    const NAMES: list[str] = ["a"]
    const ORIGIN: Point = Point(0)
    static mut total: int = 0
    mut own: int

    fn __init__(mut self, n: int) -> None:
        self.own = n
        self.LIMIT = n                  # ⛔ __init__ の中でも const には代入できない

enum Color:
    PLANE
    BLUE

Counter.LIMIT = 5                       # ⛔ クラス名経由

Counter.LIMIT += 1                      # ⛔ 複合代入も同じ

mut c = Counter(1)
c.LIMIT = 5                             # ⛔ インスタンス経由

Counter.NAMES[0] = "b"                  # ⛔ const の要素

c.NAMES.append("c")                     # ⛔ インスタンス経由でも const の中身は書き換えられない

c.ORIGIN.x = 3                          # ⛔ const のオブジェクトのフィールド

c.UNIT = "mm"                           # ⛔ trait の const

Counter.total = 5                       # ✅ static mut は代入できる

Color.BLUE = Color.PLANE                # ⛔ enum のメンバーは暗黙に const

print("ここには到達しない")
