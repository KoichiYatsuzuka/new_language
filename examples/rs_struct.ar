# rs_struct.ar — demonstrate Rust struct support via import[rs].
#
# `vec2` is a local crate under examples/rs_crates/vec2/.
# ar_config.json must list "examples/rs_crates" in rust.crates_path.
#
# What is proved here:
#   - `pub struct Vec2 { pub x: f64, pub y: f64 }` becomes a Arrow class
#   - `pub fn new(x, y) -> Self`   maps to __init__
#   - `pub fn length(&self)`       maps to an instance method
#   - `pub fn dot(&self, ox, oy)`  maps to an instance method with extra args
#   - `pub fn scale(&mut self, f)` maps to a mutable instance method
#   - `pub x: f64`                 cached as field `v.x` on the HV instance
#   - `get_x(self)` / `set_x(mut self, val)` generated as explicit accessors
#   - `pub fn distance(...)`       maps to a free function

import[rs] vec2

# ── Construction ──────────────────────────────────────────────────────────────

let v = vec2.Vec2(3.0, 4.0)

print("=== Rust struct: Vec2 ===")
print("v.x =", v.x, "  v.y =", v.y)   # fields cached by __init__

# ── Instance methods ──────────────────────────────────────────────────────────

let L = v.length()
print("length() =", L)             # 5.0  (sqrt(9+16))

let lsq = v.length_sq()
print("length_sq() =", lsq)        # 25.0

let d = v.dot(1.0, 0.0)
print("dot((1,0)) =", d)           # 3.0

# ── Mutable method: scale ─────────────────────────────────────────────────────

mut v2 = vec2.Vec2(1.0, 2.0)
v2.scale(3.0)
print("after scale(3): get_x()=", v2.get_x(), " get_y()=", v2.get_y())  # 3.0, 6.0

# ── Mutable method: normalize ─────────────────────────────────────────────────

mut v3 = vec2.Vec2(3.0, 4.0)
v3.normalize()
let nx = v3.get_x()
let ny = v3.get_y()
print("after normalize: (", nx, ",", ny, ")")   # (0.6, 0.8)
print("length after normalize =", v3.length())  # 1.0

# ── Explicit field setters ────────────────────────────────────────────────────

mut v4 = vec2.Vec2(0.0, 0.0)
v4.set_x(5.0)
v4.set_y(12.0)
print("after set_x(5), set_y(12): length =", v4.length())  # 13.0

# ── Free function ─────────────────────────────────────────────────────────────

let dist = vec2.distance(0.0, 0.0, 3.0, 4.0)
print("distance(0,0 → 3,4) =", dist)   # 5.0

# ── Methods that return a struct ─────────────────────────────────────────────
#
# `add` and `scaled` each return a new Vec2 instance.
# The DLL extracts the result's fields, then calls cb_call_fn(Vec2_class, [x,y])
# which triggers Vec2.__init__ natively — a full round-trip through the HV
# interpreter and back into the DLL arena.

let v5 = vec2.Vec2(1.0, 2.0)
let v6 = v5.add(4.0, 5.0)          # returns new Vec2(5.0, 7.0)
print("v5.add(4,5): x =", v6.get_x(), " y =", v6.get_y())   # 5.0, 7.0
print("v6 length =", v6.length())                             # sqrt(74) ≈ 8.602

let v7 = v5.scaled(3.0)            # returns new Vec2(3.0, 6.0)
print("v5.scaled(3): x =", v7.get_x(), " y =", v7.get_y())  # 3.0, 6.0

# Original v5 is unchanged
print("v5 unchanged: x =", v5.get_x(), " y =", v5.get_y())  # 1.0, 2.0

# Chain: (v5 + (1,0)).scaled(2) = Vec2(2,2) * 2 = Vec2(4,4)
let v8 = v5.add(1.0, 0.0).scaled(2.0)
print("chain add+scaled: x =", v8.get_x(), " y =", v8.get_y())  # 4.0, 4.0

# ── Explicit drop ─────────────────────────────────────────────────────────────

v2.drop()
print("v2 dropped (arena entry freed)")
