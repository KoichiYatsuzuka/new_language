# sim_core.ar — speed study core, mode 3: the same classes as interp/sim_core.ar, but the numeric
# work of each method is done by C++ kernels in sim_kernels.dll (import[cpp-dll]).
#
# V3 is the Arrow class the cpp bridge generates from `typedef struct { double x, y, z; } V3;`
# (exact C layout, so V3 instances are passed to `V3*` / `const V3*` without copying).
# The classes still mix composite types: str, list[float], nested V3 instances, list[Body].

import[cpp-dll] sim_kernels as sk

class Body:
    mut name: str
    mut pos: V3
    mut vel: V3
    mut mass: float
    mut trail: list[float]
    mut hits: int

    fn kinetic(let self) -> float:
        return sk.sk_kinetic(self.mass, self.vel)

    fn step(mut self, let dt: float, let lim: float) -> None:
        sk.sk_add_scaled(self.pos, self.vel, dt)
        self.hits += sk.sk_bounce(self.pos, self.vel, lim)

    fn record(mut self) -> None:
        self.trail.append(self.kinetic())

    fn trail_sum(let self) -> float:
        return sk.sk_sum_f64(self.trail)

    fn label(let self) -> str:
        let raw = sk.sk_label(self.name.encode(), self.hits)
        return (raw mustbe bytes).decode("utf-8")

class World:
    mut bodies: list[Body]
    mut tick: int

    fn step_all(mut self, let dt: float, let lim: float) -> None:
        for b in self.bodies:
            b.step(dt, lim)
        self.tick += 1

    fn total_energy(let self) -> float:
        mut e = 0.0
        for b in self.bodies:
            e += b.kinetic()
        return e

    fn record_all(mut self) -> None:
        for b in self.bodies:
            b.record()

    fn trail_total(let self) -> float:
        mut s = 0.0
        for b in self.bodies:
            s += b.trail_sum()
        return s

    fn total_hits(let self) -> int:
        mut h = 0
        for b in self.bodies:
            h += b.hits
        return h

# ── setup (deterministic LCG; identical in every mode) ─────────────────────────

fn lcg(let s: int) -> int:
    return (s * 1103515245 + 12345) % 2147483648

fn unit(let s: int) -> float:
    return float(s % 2000) / 100.0 - 10.0

fn make_world(let n: int) -> World:
    mut bodies: list[Body] = []
    mut seed = 12345
    mut i = 0
    while i < n:
        seed = lcg(seed)
        let px = unit(seed)
        seed = lcg(seed)
        let py = unit(seed)
        seed = lcg(seed)
        let pz = unit(seed)
        seed = lcg(seed)
        let vx = unit(seed)
        seed = lcg(seed)
        let vy = unit(seed)
        seed = lcg(seed)
        let vz = unit(seed)
        mut tr: list[float] = []
        bodies.append(Body("body-" + str(i), V3(px, py, pz), V3(vx, vy, vz), 1.0 + float(i % 7), tr, 0))
        i += 1
    return World(bodies, 0)

# ── kernels (each METRIC calls exactly one of these once) ──────────────────────

fn run_step(mut w: World, let ticks: int, let dt: float, let lim: float) -> int:
    mut t = 0
    while t < ticks:
        w.step_all(dt, lim)
        t += 1
    return w.total_hits()

fn run_energy(mut w: World, let reps: int) -> float:
    mut e = 0.0
    mut r = 0
    while r < reps:
        e += w.total_energy()
        r += 1
    return e

fn run_record(mut w: World, let reps: int) -> float:
    mut r = 0
    while r < reps:
        w.record_all()
        r += 1
    return w.trail_total()

fn run_labels(mut w: World, let reps: int) -> int:
    mut total = 0
    mut r = 0
    while r < reps:
        for b in w.bodies:
            total += len(b.label())
        r += 1
    return total

fn run_spawn(let n: int) -> float:
    mut xs: list[Body] = []
    mut i = 0
    while i < n:
        mut tr: list[float] = []
        let p = sk.sk_make(float(i % 100), 1.0, 2.0) mustbe V3
        xs.append(Body("s" + str(i), p, V3(0.5, 0.25, 0.125), 2.0, tr, 0))
        i += 1
    mut s = 0.0
    for b in xs:
        s += b.kinetic() + b.pos.x
    return s
