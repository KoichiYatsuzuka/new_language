# bench_name_vs_global.ar — 最上位からの関数呼び出しの単価（B6 / #11 R2-c の判断材料）。
#
# ⚠⚠ **このベンチは「旧バイナリとの A/B」でしか意味を持たない。** 単体の絶対値ではなく、
#   B6 の修正で被呼び出し側のロードが `LoadGlobal` → `LoadName` に変わった代償を測る。
#
#   LoadGlobal … `scopes[0]` を索引キャッシュ付きで読む（#11 の既実装分）
#   LoadName   … `get_val` でスコープ鎖を名前ハッシュで辿る（**キャッシュなし**）
#
# ⚠ モジュール本体の宣言は `exec_module` の `push_scope()` で `scopes[0]` に入らないので、
#   `LoadGlobal` では必ず外れる（それが B6 のバグ）。#11 R2-c（ファイルごとのグローバル
#   配列）が入れば索引アクセスへ戻せる。**回収見込みの上限がこのベンチの A/B 差**。
#
# 何を測るか:
#   最上位のホットループから引数なし関数を呼ぶ、それだけ。**壁時計の差 ÷ N = ns/call**。
#   ⚠ 他の作業を混ぜないこと。呼び出し 1 回は約 150-300ns あり、ロード命令 1 個の差
#     （数十 ns）は他の作業を足すとすぐ埋もれる（最初にそれで測って符号を間違えた）。
#
# ⚠ 対照は fn 内の同じループ（**A/B で変わらない**）。ノイズ帯の把握に使う。
#
# Run: ./scripts/ab_bench.ps1 -A <旧> -B <新> -Scripts examples/bench/bench_name_vs_global.ar -Reps 7
#      ⚠ 使う前に同一 exe 同士で負の対照を取ること。

import[py-int] time

let N = 4_000_000

fn noop() -> int:
    return 0

# ── 対照: fn 内から呼ぶ（被呼び出しは常に LoadGlobal）─────────
fn loop_call_in_fn(let n: int) -> int:
    mut i = 0
    while i < n:
        noop()
        i += 1
    return i

let t0 = time.time()
let r = loop_call_in_fn(N)
let t1 = time.time()

# ── 本題: 最上位から呼ぶ（B6 で LoadGlobal → LoadName）────────
mut i = 0
while i < N:
    noop()
    i += 1
let t2 = time.time()

let fn_ns = (t1 - t0) / float(N) * 1000000000.0
let tl_ns = (t2 - t1) / float(N) * 1000000000.0

print("call from fn       : " + str(fn_ns) + " ns/call")
print("call from toplevel : " + str(tl_ns) + " ns/call")
print("METRIC call_in_fn_ns " + str(fn_ns))
print("METRIC call_toplevel_ns " + str(tl_ns))
