# V-C ベンチ: ブロック式（block:/if 式 + block_return、for 式 + loop_yield）。
# これらは V-C 第2増分まで丸ごとフォールバックしていた。

fn classify(n: int) -> int:
    let r: int = block:
        if n % 15 == 0:
            block_return 4
        elif n % 3 == 0:
            block_return 3
        elif n % 5 == 0:
            block_return 5
        else:
            block_return 1
    return r

fn sum_squares(n: int) -> int:
    let sqs: list[int] = for i in range(n) -> list[int]:
        loop_yield i * i
    mut total: int = 0
    for s in sqs:
        total += s
    return total

fn main() -> None:
    mut acc: int = 0
    mut k: int = 0
    while k < 200000:
        acc += classify(k)
        acc += sum_squares(20)
        k += 1
    print(acc)

main()
