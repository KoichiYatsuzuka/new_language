# タスク#5 ベンチ: 添字・コレクションリテラル。V-D まで丸ごとフォールバックしていた。
fn dot(a: list[int], b: list[int], n: int) -> int:
    mut s: int = 0
    mut k: int = 0
    while k < n:
        s += a[k] * b[k]
        k += 1
    return s

fn build_pairs(n: int) -> int:
    mut total: int = 0
    mut k: int = 0
    while k < n:
        let pair: tuple[int, int] = (k, k * 2)
        total += pair[0] + pair[1]
        k += 1
    return total

fn main() -> None:
    let a: list[int] = [1, 2, 3, 4, 5, 6, 7, 8]
    let b: list[int] = [8, 7, 6, 5, 4, 3, 2, 1]
    mut acc: int = 0
    mut i: int = 0
    while i < 1000000:
        acc += dot(a, b, 8)
        acc += build_pairs(8)
        i += 1
    print(acc)
main()
