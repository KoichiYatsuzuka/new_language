# @id: O11
# @obligation: 演算子オーバーロードの右辺（__add__ は Money を取るのに int）
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。
# ⚠ フェーズ10 10-13。以前は RUNTIME（`__add__` の中の `other.cents` で AttributeError）。

class Money:
    mut cents: int

    fn __add__(self, let other: Money) -> Money:
        return Money(self.cents + other.cents)

let m = Money(100) + 5
print(m.cents)
