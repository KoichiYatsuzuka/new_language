# @id: K26
# @obligation: 具体化を値として使った静的メソッドの結果（Stack[int].empty() を Stack[str] へ）
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。
# ⚠ フェーズ10 10-9。以前は RUNTIME（`Stack[int]` が添字として読まれ `'template' object is not subscriptable`）。

class Stack[T]:
    mut items: list[T]

    static fn empty() -> Stack[T]:
        return Stack[T]([])

let x: Stack[str] = Stack[int].empty()
print(len(x.items))
