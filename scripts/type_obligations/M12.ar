# @id: M12
# @obligation: __init__ の中の const への代入
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。

class C:
    const K: int = 1
    mut n: int
    fn __init__(mut self, n: int) -> None:
        self.n = n
        self.K = 2
let c = C(1)
print(c.K)
