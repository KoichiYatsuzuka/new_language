# @id: X7
# @obligation: is の絞り込み（match 式）
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。

class Dog:
    mut n: int
    mut t: str
mut xs: list = [Dog(1,"a"), 2]
let v = xs[0]
let r = match v ->int:
    is Dog:
        let s: str = v.n
        block_return 1
print(r)
