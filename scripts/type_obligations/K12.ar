# @id: K12
# @obligation: フィールド list[protocol] に非適合クラス
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。

protocol Pr:
    mut n: int
class No:
    mut m: int
class Holder:
    mut items: list[Pr]
    mut tag: str
mut h = Holder([], "t")
h.items = [No(1)]
print("reached")
