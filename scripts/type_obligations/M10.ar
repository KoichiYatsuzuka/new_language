# @id: M10
# @obligation: int の属性アクセス（x.name）
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。
# ⚠ フェーズ10 10-14。以前は RUNTIME（`label` の中の AttributeError）。

fn label(let x: int) -> str:
    return x.name

print(label(1))
