#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。

class C:
    mut d: int
    fn m(self, let v: int) -> int:
        return v
    fn m(self, let v: str) -> int:
        return 0
mut c = C(1)
print(c.m(1.5))
