# @id: M7
# @obligation: private メソッドの外部からの呼び出し
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。
# ⚠ フェーズ10 10-6。以前は NONE（静的にも実行時にも止まらなかった）。

class Account:
    mut balance: int
    private:
    fn audit(self, let n: int) -> None:
        print("audit", n)

let a = Account(0)
a.audit(5)
