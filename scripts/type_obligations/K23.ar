# @id: K23
# @obligation: 制約付きテンプレートのメソッドの引数（Holder[Cat].put に str）
# @baseline: STATIC
#
# ⚠ この検体は**意図的に型エラーを 1 つだけ**含む。type_obligations.ps1 が実行して
#    STATIC / RUNTIME / NONE のどれになるかを測り、@baseline と比べる。
#    baseline より弱くなったら退行。強くなったら @baseline を更新すること。
# ⚠ テンプレートの検体（フェーズ10 10-5）。具体化した本体・メソッドは単相化して検査する（2-13 / 10-4）。

trait Named:
    fn label(self) -> str:
        ...

class Cat(Named):
    mut n: int
    fn label(self) -> str:
        return "cat"

class Holder[T: Named]:
    mut item: T
    fn put(mut self, let x: T) -> None:
        self.item = x

mut h = Holder[Cat](Cat(1))
h.put("wrong")
print(h.item.label())
