fn bench_cast_dict(mut p: py_dict[str, int]) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        let ys = p => dict[str, int]
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_for_int(mut p: py_list[int]) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut s = 0
        for x in p:
            s = s + x
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_for_arrow(p: list[int]) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut s = 0
        for x in p:
            s = s + x
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_index_int(mut p: py_list[int], n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut s = 0
        mut i = 0
        while i < n:
            s = s + p[i]
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_index_arrow(p: list[int], n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut s = 0
        mut i = 0
        while i < n:
            s = s + p[i]
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_to_py(p: list[int]) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut ys = p => py_list[int]
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

