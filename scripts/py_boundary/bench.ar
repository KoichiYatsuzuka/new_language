# Python <-> Arrow boundary measurement (pandas plan 4-1 / 4-2 / 4-3). Prints ns per element (minimum of the rounds).
import[py] pbmod as pb
import[py] numpy as np

const N: int = 100000
const CALLS: int = 200000
const ROUNDS: int = 7

fn report(name: str, best: float, n: int) -> None:
    print(name + "\t" + str(round(best * 1000000000.0 / n, 1)))

mut xi = pb.ints(N)
mut xf = pb.floats(N)
mut xs = pb.strs(N)
mut xb = pb.bools(N)
mut xa = pb.anys(N)
mut xp = pb.pairs(N)
mut xd = pb.strdict(N)
mut xn = pb.nested(N // 3)

fn bench_cast_int(mut p: py_list[int]) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        let ys = p => list[int]
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_cast_float(mut p: py_list[float]) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        let ys = p => list[float]
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

