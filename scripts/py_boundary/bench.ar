fn bench_loop_only(n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut i = 0
        while i < n:
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_call_noop(n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut i = 0
        while i < n:
            pb.noop()
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_call_int(n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut s = 0
        mut i = 0
        while i < n:
            s = s + pb.one_int()
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_call_float(n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut s = 0.0
        mut i = 0
        while i < n:
            s = s + pb.one_float()
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_call_str(n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut i = 0
        while i < n:
            let s = pb.one_str()
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
    return best

fn bench_call_pair(n: int) -> float:
    mut best = 1000000.0
    for r in range(ROUNDS):
        let t0 = pb.now() mustbe float
        mut i = 0
        while i < n:
            let s = pb.one_pair()
            i = i + 1
        let t1 = pb.now() mustbe float
        if t1 - t0 < best:
            best = t1 - t0
