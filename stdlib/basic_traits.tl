trait Generatable[T]:
    fn __next__(self) -> T:
        ...


trait Iterable[T]
    fn __iter__(self) -> Generatable[T]:
        ...

trait Comparable:
    fn __eq__(self, other: Self) -> bool:
        ...
    fn __ne__(self, other: Self) -> bool:
        ...
    fn __lt__(self, other: Self) -> bool:
        ...
    fn __le__(self, other: Self) -> bool:
        ...
    fn __gt__(self, other: Self) -> bool:
        ...
    fn __ge__(self, other: Self) -> bool:
        ...
    
trait Numerical:
    fn __add__(self, other: Self) -> Self:
        ...
    fn __sub__(self, other: Self) -> Self:
        ...
    
    fn __mul__(self, other: Self) -> Self:
        ...
    fn __mul__(self, other: float) -> float:
        ...
    fn __mul__(self, other: int) -> Self:
        ...
    
    fn __truediv__(self, other: Self) -> Self:
        ...
    fn __truediv__(self, other: float) -> float:
        ...
    fn __truediv__(self, other: int) -> Self:
        ...

    fn __floordiv__(self, other: Self) -> Self:
        ...
    fn __floordiv__(self, other: float) -> float:
        ...
    fn __floordiv__(self, other: int) -> Self:
        ...

    fn __iadd__(mut self, other: Self) -> None:
        ...
    fn __isub__(mut self, other: Self) -> None:
        ...
    
    fn __imul__(mut self, other: Self) -> None:
        ...
    fn __imul__(mut self, other: float) -> None:
        ...
    fn __imul__(mut self, other: int) -> None:
        ...
    
    fn __itruediv__(mut self, other: Self) -> None:
        ...
    fn __itruediv__(mut self, other: float) -> None:
        ...
    fn __itruediv__(mut self, other: int) -> None:
        ...
    
    fn __ifloordiv__(mut self, other: Self) -> None:
        ...
    fn __ifloordiv__(mut self, other: float) -> None:
        ...
    fn __ifloordiv__(mut self, other: int) -> None:
        ...