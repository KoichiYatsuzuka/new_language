{
  "name": "Arrow",
  "scopeName": "source.ar",
  "fileTypes": ["ar", "ars"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#modifier-member-def" },
    { "include": "#function-def" },
    { "include": "#class-def" },
    { "include": "#new-type-def" },
    { "include": "#import-decl" },
    { "include": "#mustbe-assertion" },
    { "include": "#meta-decorator" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#builtin-type" },
    { "include": "#builtin-func" },
    { "include": "#constructor-call" },
    { "include": "#function-call" },
    { "include": "#operator" },
    { "include": "#variable" }
  ],
  "repository": {
    "meta-decorator": {
      "patterns": [
        {
          "comment": "`!decorator` at the start of a line — compile-time decorator (design 1.6). `@` stays the runtime one.",
          "match": "^\\s*(!)([\\p{L}_]\\w*)",
          "captures": {
            "1": { "name": "keyword.operator.metafn.decorator.ar" },
            "2": { "name": "entity.name.function.decorator.ar" }
          }
        }
      ]
    },
    "modifier-member-def": {
      "patterns": [
        {
          "comment": "static fn/gen or class_method fn/gen — method definition with a modifier",
          "match": "\\b(static|class_method)\\s+(fn|gen)\\s+([\\p{L}_]\\w*)",
          "captures": {
            "1": { "name": "keyword.other.ar" },
            "2": { "name": "storage.type.function.ar" },
            "3": { "name": "entity.name.function.ar" }
          }
        },
        {
          "comment": "static mut/let/const — static field declaration",
          "match": "\\b(static)\\s+(mut|let|const)\\s+([\\p{L}_]\\w*)",
          "captures": {
            "1": { "name": "keyword.other.ar" },
            "2": { "name": "storage.modifier.ar" },
            "3": { "name": "entity.name.field.ar" }
          }
        }
      ]
    },
    "import-decl": {
      "comment": "Handles all import variants: bare import plus any bracketed tag (import[py], import[py-int], import[ar], import[arc], import[rs], import[hv], import[hvc], import[cpp-lib], import[cpp-dll], import[cs-dll], import[cs-proc], import[js-proc], ...). The whole `import[tag]` — brackets and tag included — is scoped as the import keyword so it renders in the keyword color.",
      "match": "\\b(import(?:\\[[\\w-]+\\])?)\\s+([\\w.]+)(?:\\s+(with)\\s+(\\w+))?(?:\\s+(as)\\s+([\\p{L}_]\\w*))?",
      "captures": {
        "1": { "name": "keyword.control.import.ar" },
        "2": { "name": "entity.name.namespace.ar" },
        "3": { "name": "keyword.control.import.ar" },
        "4": { "name": "entity.name.namespace.ar" },
        "5": { "name": "keyword.control.import.ar" },
        "6": { "name": "entity.name.type.class.ar" }
      }
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.ar"
    },
    "string-interpolation": {
      "comment": "`{expr}` of an f-string. lex_fstring reads up to the matching `}` counting nested braces and NOTHING else: a quote or `#` inside does not end it, so strings / comments are not included here.",
      "name": "meta.template.expression.ar",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.ar" } },
      "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.ar" } },
      "patterns": [{ "include": "#fstring-expr" }]
    },
    "fstring-expr": {
      "patterns": [
        {
          "comment": "nested braces (`{ {1: 2}[1] }`) — counted like lex_fstring's depth",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#fstring-expr" }]
        },
        {
          "comment": "`!r` / `:spec` right before the closing `}`. Only when the spec has no brackets, so `a[1:2]` is not taken for one.",
          "match": "(?:![rsa](?::[^{}\\[\\]()'\"]*)?|:[^{}\\[\\]()'\"]*)(?=\\})",
          "name": "constant.other.format-spec.ar"
        },
        { "include": "#keyword" },
        { "include": "#constant" },
        { "include": "#number" },
        { "include": "#builtin-type" },
        { "include": "#builtin-func" },
        { "include": "#constructor-call" },
        { "include": "#function-call" },
        { "include": "#operator" },
        { "include": "#variable" }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.ar",
          "begin": "(?<![\\w])(fr|rf)(\"\"\")",
          "end": "(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-raw-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.single.ar",
          "begin": "(?<![\\w])(fr|rf)(''')",
          "end": "(''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-raw-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.ar",
          "begin": "(?<![\\w])(fr|rf)(\"(?!\"\"))",
          "end": "(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-raw-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.ar",
          "begin": "(?<![\\w])(fr|rf)('(?!''))",
          "end": "(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-raw-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.double.ar",
          "begin": "(?<![\\w])(f)(\"\"\")",
          "end": "(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.single.ar",
          "begin": "(?<![\\w])(f)(''')",
          "end": "(''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.ar",
          "begin": "(?<![\\w])(f)(\"(?!\"\"))",
          "end": "(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.ar",
          "begin": "(?<![\\w])(f)('(?!''))",
          "end": "(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#fstring-brace-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.double.ar",
          "begin": "(?<![\\w])(m)(\"\"\")",
          "end": "(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#math-command" }, { "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.triple.single.ar",
          "begin": "(?<![\\w])(m)(''')",
          "end": "(''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#math-command" }, { "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.double.ar",
          "begin": "(?<![\\w])(m)(\"(?!\"\"))",
          "end": "(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#math-command" }, { "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.single.ar",
          "begin": "(?<![\\w])(m)('(?!''))",
          "end": "(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#math-command" }, { "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.triple.double.ar",
          "begin": "(?<![\\w])(r)(\"\"\")",
          "end": "(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.triple.single.ar",
          "begin": "(?<![\\w])(r)(''')",
          "end": "(''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.double.ar",
          "begin": "(?<![\\w])(r)(\"(?!\"\"))",
          "end": "(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.single.ar",
          "begin": "(?<![\\w])(r)('(?!''))",
          "end": "(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-raw-escape" }]
        },
        {
          "name": "string.quoted.triple.double.ar",
          "begin": "(?<![\\w])(b)(\"\"\")",
          "end": "(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "name": "string.quoted.triple.single.ar",
          "begin": "(?<![\\w])(b)(''')",
          "end": "(''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "name": "string.quoted.double.ar",
          "begin": "(?<![\\w])(b)(\"(?!\"\"))",
          "end": "(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "name": "string.quoted.single.ar",
          "begin": "(?<![\\w])(b)('(?!''))",
          "end": "(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.ar" },
            "2": { "name": "punctuation.definition.string.begin.ar" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "name": "string.quoted.triple.double.ar",
          "begin": "(\"\"\")",
          "end": "(\"\"\")",
          "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.ar" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "name": "string.quoted.triple.single.ar",
          "begin": "(''')",
          "end": "(''')",
          "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.ar" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "name": "string.quoted.double.ar",
          "begin": "(\"(?!\"\"))",
          "end": "(\")",
          "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.ar" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "name": "string.quoted.single.ar",
          "begin": "('(?!''))",
          "end": "(')",
          "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.ar" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "comment": "`$…$` math string (scan.rs `Some('$')`): everything up to the next `$`, across lines, no escapes",
          "name": "string.other.math.ar",
          "begin": "(\\$)",
          "end": "(\\$)",
          "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.ar" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ar" } },
          "patterns": [{ "include": "#math-command" }]
        }
      ]
    },
    "string-escape": {
      "comment": "Non-raw strings. lex_string_inner translates only these; any other `\\x` is kept as is, but still consumes the next character (so `\\\"` never ends the string).",
      "patterns": [{ "match": "\\\\[ntr\\\\'\"0]", "name": "constant.character.escape.ar" }, { "match": "\\\\." }]
    },
    "string-raw-escape": {
      "comment": "Raw strings: `\\` keeps the next character (lex_string_inner(raw=true)), so `r\"\\\"\"` does not end at the second quote. Nothing is coloured as an escape.",
      "match": "\\\\."
    },
    "fstring-brace-escape": {
      "comment": "`{{` / `}}` are a literal brace in an f-string (lex_fstring)",
      "match": "\\{\\{|\\}\\}",
      "name": "constant.character.escape.ar"
    },
    "math-command": {
      "comment": "LaTeX-like command in a math string (`\\alpha`, render_math_str)",
      "match": "\\\\[A-Za-z]+",
      "name": "constant.character.math.ar"
    },
    "number": {
      "patterns": [
        { "match": "\\b0[xX][0-9a-fA-F_]+\\b", "name": "constant.numeric.hex.ar" },
        { "match": "\\b0[oO][0-7_]+\\b", "name": "constant.numeric.octal.ar" },
        { "match": "\\b0[bB][01_]+\\b", "name": "constant.numeric.binary.ar" },
        {
          "match": "\\b[0-9][0-9_]*\\.([0-9_]+([eE][+-]?[0-9_]+)?|[eE][+-]?[0-9_]+)j?\\b",
          "name": "constant.numeric.float.ar"
        },
        { "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9]+j?\\b", "name": "constant.numeric.float.ar" },
        { "match": "\\b[0-9][0-9_]*j?\\b", "name": "constant.numeric.integer.ar" }
      ]
    },
    "function-def": {
      "match": "\\b(fn|gen)\\s+([\\p{L}_]\\w*)",
      "captures": {
        "1": { "name": "storage.type.function.ar" },
        "2": { "name": "entity.name.function.ar" }
      }
    },
    "class-def": {
      "match": "\\b(class|trait|protocol|template|enum)\\s+([\\p{L}_]\\w*)",
      "captures": {
        "1": { "name": "storage.type.class.ar" },
        "2": { "name": "entity.name.type.class.ar" }
      }
    },
    "new-type-def": {
      "match": "\\b(new_type|alias)\\s+([\\p{L}_]\\w*)",
      "captures": {
        "1": { "name": "storage.type.newtype.ar" },
        "2": { "name": "entity.name.type.ar" }
      }
    },
    "mustbe-assertion": {
      "comment": "mustbe type assertion — expr mustbe TypeExpr. The type is names joined by `[` `]` `,` `|` `->` only, so it always stops at `#`, a quote or `)` (where the type ends is the parser's business). ⚠ The old class `[\\w\\[\\], ->]` read ` ->` as the RANGE space..`>`, which swallowed `#`, quotes and parentheses.",
      "match": "\\b(mustbe)\\s+([\\p{L}_][\\w.]*(?:(?:\\[|\\]|\\s*,\\s*|\\s*\\|\\s*|\\s*->\\s*)[\\w.]*)*)",
      "captures": {
        "1": { "name": "storage.modifier.ar" },
        "2": { "name": "entity.name.type.ar" }
      }
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(const)\\s+([\\p{L}_]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier.ar" },
            "2": { "name": "variable.other.constant.ar" }
          }
        },
        {
          "match": "\\b(let|mut|freeze)\\b",
          "name": "storage.modifier.ar"
        },
        {
          "match": "\\b(yield from|yield|return|block_return|loop_yield|pass|break|continue|break_point)\\b",
          "name": "keyword.control.flow.ar"
        },
        {
          "comment": "metafunction keywords (compile-time expansion) — implementation_logs/comptime_metafn_design.md",
          "match": "\\b(exprconst|quote|code)\\b",
          "name": "keyword.other.metafn.ar"
        },
        {
          "match": "\\b(if|elif|else|match|case|for|while|block)\\b",
          "name": "keyword.control.ar"
        },
        {
          "match": "\\b(try|except|finally|raise)\\b",
          "name": "keyword.control.exception.ar"
        },
        {
          "match": "\\b(import|from|as)\\b",
          "name": "keyword.control.import.ar"
        },
        {
          "match": "\\b(async|await)\\b",
          "name": "keyword.control.async.ar"
        },
        {
          "match": "\\b(public|private|protected)\\b",
          "name": "keyword.other.access.ar"
        },
        {
          "match": "\\b(del|global|nonlocal|with|assert|lambda|new_type|alias|static|class_method|on|once|off)\\b",
          "name": "keyword.other.ar"
        },
        {
          "match": "\\bnot in\\b",
          "name": "keyword.control.ar"
        },
        {
          "match": "\\bis not\\b",
          "name": "keyword.control.ar"
        },
        {
          "match": "\\bin\\b",
          "name": "keyword.control.ar"
        },
        {
          "match": "\\bis\\b",
          "name": "keyword.control.ar"
        },
        {
          "match": "\\bnot\\b",
          "name": "keyword.control.ar"
        },
        {
          "match": "\\b(and|or)\\b",
          "name": "keyword.operator.logical.ar"
        }
      ]
    },
    "constant": {
      "match": "\\b(True|False|None|Undefined)\\b",
      "name": "constant.language.ar"
    },
    "builtin-type": {
      "match": "\\b(int|uint|float|str|bool|list|dict|set|tuple|bytes|bytearray|complex|frozenset|object|type|any|Self|Any|Union|Intersection|Option|Optional|pointer|Ptr|Path|slice|Code|meta_instance|meta_function|meta_class|meta_member)\\b",
      "name": "support.type.builtin.ar"
    },
    "builtin-func": {
      "patterns": [
        {
          "match": "\\b(enumerate|zip)\\b",
          "name": "support.function.builtin.ar"
        },
        {
          "match": "\\b(print|len|range|map|filter|abs|round|pow|divmod|max|min|sum|all|any|sorted|reversed|isinstance|issubclass|callable|getattr|setattr|hasattr|delattr|repr|input|open|chr|ord|hex|oct|bin|id|hash|dir|vars|globals|locals|iter|next|eval|exec|help|format|super|staticmethod|classmethod|property|slice)\\b",
          "name": "support.function.builtin.ar"
        }
      ]
    },
    "constructor-call": {
      "match": "(?<!\\.)\\b([A-Z][A-Za-z_0-9]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.type.class.ar" }
      }
    },
    "function-call": {
      "match": "\\b([\\p{L}_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.ar" }
      }
    },
    "variable": {
      "match": "\\b([\\p{L}_]\\w*)\\b",
      "name": "variable.other.readwrite.ar"
    },
    "operator": {
      "patterns": [
        {
          "match": "\\*\\*=|//=|<<=|>>=|[+\\-*/%@&|^]=|:=",
          "name": "keyword.operator.assignment.augmented.ar"
        },
        {
          "comment": "splice delimiters — must precede the comparison rule so `<!` is not eaten as `<`",
          "match": "<!|!>",
          "name": "keyword.operator.splice.ar"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.ar"
        },
        {
          "match": "=(?!=)",
          "name": "keyword.operator.assignment.ar"
        },
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.ar"
        },
        {
          "match": "\\*\\*|//|<<|>>",
          "name": "keyword.operator.arithmetic.ar"
        },
        {
          "match": "[+\\-*/%@&|^~]",
          "name": "keyword.operator.arithmetic.ar"
        }
      ]
    }
  }
}
