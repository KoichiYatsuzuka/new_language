# tm_grammar_cases.ar — TextMate 文法と lexer の食い違いを確かめる例（VSIX_update_plan.md 1-2）。
#
# scripts/compare_tm_grammar.ps1 が全例題と一緒に読む。実行はしない（文字列・コメントの範囲だけを比べる）。
# 1 ケースで文法が暴走すると後ろが全部巻き込まれるので、各ケースの直後に括弧つきの行（`let z… = (1)`）を
# 置き、どのケースから暴走したかが SPILL の行番号で分かるようにしてある。
# 番号は計画書の表の番号。

let x = 1
let a = [1, 2, 3]

# 1: f 文字列以外の `{`
let c1 = "x{y"
let z1 = (1)
let c1r = r"[{]"
let z1r = (1)
let c1b = b"a{"
let z1b = (1)
let c1m = m"^{ab"
let z1m = (1)
let c1t = """{"""
let z1t = (1)

# 2: f 文字列以外の `{{`
let c2 = "{{"
let z2 = (1)

# 3: f 文字列の `\{`（`{` そのもの）
let c3 = f"\{x"
let z3 = (1)

# 4, 5: `$…$`（数学文字列）。中の `"` / `#` は文字列の中身
let c4 = $a"b$
let z4 = (1)
let c5 = $a#b$
let z5 = (1)
let c4ml = $a
b$
let z4ml = (1)

# 7: raw の `\` はエスケープではない
let c7 = r"\frac"
let z7 = (1)
let c7m = m"\alpha"
let z7m = (1)

# 9: 埋め込み式の中の `{}` の入れ子
let c9 = f"{ {1: 2}[1] }"
let z9 = (1)

# 10: 埋め込み式の中の `:`
let c10 = f"{a[1:2]}"
let z10 = (1)

# 11: `mustbe` の後ろのコメント・文字列（型の範囲に食われない）
let c11 = (x mustbe int)  # コメント
let z11 = (1)
let c11s = (x mustbe int) == "s"
let z11s = (1)
