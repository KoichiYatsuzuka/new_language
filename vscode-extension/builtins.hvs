# Built-in function stubs for Havakyrie
# Loaded by the VS Code extension to power hover, completion, and signature help.
# Format: fn name(params) -> ReturnType:
#             """Single-line docstring."""
#             ...

fn print(args: any, sep: str = " ", end: str = "\n") -> None:
    """Print values to stdout, separated by sep and followed by end."""
    ...

fn len(x: any) -> int:
    """Return the number of items in a collection (list, str, tuple, dict, set)."""
    ...

fn id(x: any) -> pointer:
    """Return the identity of an object as a pointer wrapping a uint value."""
    ...

fn str(x: any) -> str:
    """Convert a value to its string representation."""
    ...

fn int(x: any) -> int:
    """Convert a value to int (truncates floats, parses strings)."""
    ...

fn uint(x: any) -> uint:
    """Convert a value to uint."""
    ...

fn float(x: any) -> float:
    """Convert a value to float."""
    ...

fn bool(x: any) -> bool:
    """Convert a value to bool."""
    ...

fn ord(x: str) -> int:
    """Return the Unicode code point of a single character."""
    ...

fn chr(x: int) -> str:
    """Return the character corresponding to a Unicode code point."""
    ...

fn hex(x: int) -> str:
    """Return the hexadecimal string representation of an integer."""
    ...

fn oct(x: int) -> str:
    """Return the octal string representation of an integer."""
    ...

fn bin(x: int) -> str:
    """Return the binary string representation of an integer."""
    ...

fn abs(x: any) -> any:
    """Return the absolute value of a number."""
    ...

fn round(x: float, ndigits: int = 0) -> int:
    """Round a float to ndigits decimal places (default: nearest integer)."""
    ...

fn hash(x: any) -> int:
    """Return the hash value of an object."""
    ...

fn repr(x: any) -> str:
    """Return a developer-friendly string representation of an object."""
    ...

fn input(prompt: str = "") -> str:
    """Read a line from stdin, optionally printing prompt first."""
    ...

fn format(value: any, spec: str = "") -> str:
    """Format a value using an optional format specification string."""
    ...

fn max(args: any) -> any:
    """Return the largest of the given values or items in a collection."""
    ...

fn min(args: any) -> any:
    """Return the smallest of the given values or items in a collection."""
    ...

fn sum(x: any, start: int = 0) -> any:
    """Return the sum of items in a collection, starting from start."""
    ...

fn range(start: int, stop: int, step: int = 1) -> any:
    """Generate integers from start up to (not including) stop, incrementing by step."""
    ...

fn enumerate(x: any, start: int = 0) -> any:
    """Yield (index, value) tuples for each element, starting index at start."""
    ...

fn zip(a: any, b: any) -> any:
    """Yield tuples pairing elements of two or more iterables; stops at shortest."""
    ...

fn sorted(x: any, key: any = None, reverse: bool = False) -> list:
    """Return a new sorted list from x."""
    ...

fn reversed(x: any) -> any:
    """Return an iterator over x in reverse order."""
    ...

fn isinstance(x: any, t: any) -> bool:
    """Return True if x is an instance of type t or a tuple of types."""
    ...

fn callable(x: any) -> bool:
    """Return True if x appears callable (has __call__)."""
    ...

fn hasattr(x: any, name: str) -> bool:
    """Return True if x has an attribute named name."""
    ...

fn getattr(x: any, name: str, default: any = None) -> any:
    """Return the value of attribute name on x, or default if absent."""
    ...

fn type(x: any) -> any:
    """Return the type of x."""
    ...

fn path(value: str) -> path:
    """Construct a path value from a string."""
    ...

fn open(p: path, mode: any, start: any = None, byte_mode: any = None) -> any:
    """Open a file and return a file handle."""
    ...

fn close(f: any) -> None:
    """Close an open file handle."""
    ...

fn set(x: any = None) -> set:
    """Construct a set from an iterable, or an empty set."""
    ...

fn slice(begin: any, end: any, step: int = None) -> slice:
    """Construct a slice value with begin, end, and optional step."""
    ...

fn exec(code: str) -> None:
    """Execute a string of Havakyrie code."""
    ...
