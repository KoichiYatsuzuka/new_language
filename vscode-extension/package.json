{
  "name": "havakyrie",
  "displayName": "Havakyrie",
  "description": "Type inference inlay hints for Havakyrie (.hv files)",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/placeholder/havakyrie"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:havakyrie"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "havakyrie.sendToRepl",
        "title": "Send to REPL",
        "category": "Havakyrie"
      }
    ],
    "keybindings": [
      {
        "command": "havakyrie.sendToRepl",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == havakyrie"
      }
    ],
    "languages": [
      {
        "id": "havakyrie",
        "aliases": [
          "Havakyrie",
          "hv"
        ],
        "extensions": [
          ".hv",
          ".hvs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "havakyrie",
        "scopeName": "source.hv",
        "path": "./syntaxes/havakyrie.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^4.9.5",
    "vsce": "^1.103.1"
  }
}
