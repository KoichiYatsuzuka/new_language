{
  "name": "test-lang",
  "displayName": "test_lang",
  "description": "Type inference inlay hints for test_lang (.tl files)",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/placeholder/test_lang"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:test_lang"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "test_lang",
        "aliases": [
          "test_lang",
          "tl"
        ],
        "extensions": [
          ".tl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "test_lang",
        "scopeName": "source.tl",
        "path": "./syntaxes/tl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^4.9.5",
    "vsce": "^1.103.1"
  }
}
