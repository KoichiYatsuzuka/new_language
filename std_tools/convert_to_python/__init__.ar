# convert_to_python/__init__.ar — entry point for the .ar → .py code generator.
#
# Standalone: requires only the Arrow runtime (no Python dependency).
#
# Usage:
#   cargo run -- std_tools/convert_to_python/__init__.ar
#
# Reads HV_INPUT (default: examples/functions.ar) and writes to HV_OUTPUT
# (default: <input stem>.py).  Set these environment variables before running:
#
#   $env:HV_INPUT  = "examples/class_trait.ar"
#   $env:HV_OUTPUT = "examples/class_trait.py"
#   cargo run -- std_tools/convert_to_python/__init__.ar

import converter as conv_mod

let default_input: str = "examples/functions.ar"
let input_path: str = getenv("HV_INPUT", default_input)

let stem_end: int = len(input_path) - 3   # strip ".ar"
let default_output: str = input_path[0:stem_end] + ".py"
let output_path: str = getenv("HV_OUTPUT", default_output)

print("Converting:", input_path, "->", output_path)

let py_code: str = conv_mod.convert_file(input_path)

let f = open(output_path, FileOpenMode.rewrite)
f.write(py_code)

print("Done.")
print("--- preview (first 40 lines) ---")
let preview_lines = py_code.split("\n")
mut shown: int = 0
for line in preview_lines:
    if shown >= 40:
        break
    print(line)
    shown += 1
