# node_utils.hv — AST helper utilities for the .hv → .py converter.
#
# All functions accept Havakyrie namespace objects produced by parse_hv().
# The __type__ field is the node-type discriminator (set by ast_value.rs).

# Return the type name of any AST node, e.g. "StmtLet", "ExprInt".
fn get_type_name(node) -> str:
    return node.__type__

# Return the operator string for a BinOp — the value IS already the string.
fn get_binop_str(op) -> str:
    return op

# Return the operator prefix string for a UnaryOp name ("NEG", "NOT", "BIT_NOT").
fn get_unary_str(op) -> str:
    if op == "NEG":
        return "-"
    elif op == "NOT":
        return "not "
    elif op == "BIT_NOT":
        return "~"
    return ""

# Return "let", "mut", "bare", or "wildcard" for a TupleTarget node.
fn tuple_target_kind(target) -> str:
    let t: str = target.__type__
    if t == "TupleTargetLet":
        return "let"
    elif t == "TupleTargetMut":
        return "mut"
    elif t == "TupleTargetBare":
        return "bare"
    elif t == "TupleTargetWildcard":
        return "wildcard"
    return "bare"

# Return True if any statement in *stmts* (recursively) is StmtLoopYield.
# Does NOT recurse into nested fn / class / trait definitions.
fn has_loop_yield(stmts) -> bool:
    for stmt in stmts:
        let t: str = stmt.__type__
        if t == "StmtLoopYield":
            return True
        if t == "StmtFnDef" or t == "StmtGenDef" or t == "StmtClassDef" or t == "StmtTraitDef":
            continue
        if t == "StmtIf":
            for branch in stmt.branches:
                if has_loop_yield(branch[1]):
                    return True
            let eb = stmt.else_body
            if eb != None:
                if has_loop_yield(eb):
                    return True
        elif t == "StmtFor" or t == "StmtWhile":
            if has_loop_yield(stmt.body):
                return True
        elif t == "StmtBlock":
            if has_loop_yield(stmt.stmts):
                return True
        elif t == "StmtMatch":
            for arm in stmt.arms:
                if has_loop_yield(arm.body):
                    return True
        elif t == "StmtTry":
            if has_loop_yield(stmt.body):
                return True
            for handler in stmt.handlers:
                if has_loop_yield(handler.body):
                    return True
            let fb = stmt.finally_body
            if fb != None:
                if has_loop_yield(fb):
                    return True
    return False

# Return True when an IfExpr can be emitted as a Python ternary:
#   exactly one branch with a single block_return, and an else with a single block_return.
fn is_simple_if_expr(expr) -> bool:
    let t: str = expr.__type__
    if t != "ExprIfExpr":
        return False
    let branches = expr.branches
    mut branch_count: int = 0
    for _ in branches:
        branch_count += 1
    if branch_count != 1:
        return False
    let branch = branches[0]
    let body = branch[1]
    mut body_len: int = 0
    for _ in body:
        body_len += 1
    if body_len != 1:
        return False
    let st = body[0]
    if st.__type__ != "StmtBlockReturn":
        return False
    let eb = expr.else_body
    if eb == None:
        return False
    mut eb_len: int = 0
    for _ in eb:
        eb_len += 1
    if eb_len != 1:
        return False
    let est = eb[0]
    if est.__type__ != "StmtBlockReturn":
        return False
    return True
