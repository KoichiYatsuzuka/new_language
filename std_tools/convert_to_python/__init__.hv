# convert_to_python/__init__.hv — entry point for the .hv → .py code generator.
#
# Usage:
#   cargo run -- convert_to_python/__init__.hv
#
# Reads HV_INPUT (default: examples/functions.hv) and writes to HV_OUTPUT
# (default: <input stem>.py).  Set these environment variables before running:
#
#   $env:HV_INPUT  = "examples/class_trait.hv"
#   $env:HV_OUTPUT = "examples/class_trait.py"
#   cargo run -- convert_to_python/__init__.hv

# ── 1. Extend Python's module search path so impl_python is findable ──────────
import[py-int] sys as py_sys
import[py-int] os as py_os

# Add the repository root (current working directory) to Python's sys.path so
# that `import[py-int] impl_python.*` in converter.hv resolves correctly.
py_sys.path.insert(0, py_os.getcwd())

# ── 2. Import the converter (its impl_python imports now resolve) ─────────────
import converter as conv_mod

# ── 3. Read input / output paths from environment variables ──────────────────
let default_input: str = "examples/functions.hv"
let input_path: str = py_os.environ.get("HV_INPUT", default_input)

let stem_end: int = len(input_path) - 3   # strip ".hv"
let default_output: str = input_path[0:stem_end] + ".py"
let output_path: str = py_os.environ.get("HV_OUTPUT", default_output)

# ── 4. Run the converter ──────────────────────────────────────────────────────
print("Converting:", input_path, "->", output_path)

let py_code: str = conv_mod.convert_file(input_path)

let f = open(output_path, FileOpenMode.rewrite)
f.write(py_code)

print("Done.")
print("--- preview (first 40 lines) ---")
let preview_lines = py_code.split("\n")
mut shown: int = 0
for line in preview_lines:
    if shown >= 40:
        break
    print(line)
    shown += 1
