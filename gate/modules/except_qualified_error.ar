# 期待されるエラー（静的）:
#   StaticTypeError: 'ae.NoSuchError' in `except` is not a known type; the handler can never match
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/exceptions/except_qualified_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

import exc_modules.app_errors as ae

try:   # expect: static ExceptNotError
    ae.fail("boom")
except ae.NoSuchError as e:                               # ⛔ app_errors に NoSuchError は無い
    print(e.message)
