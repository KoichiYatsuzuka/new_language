# module_class_identity.ar — モジュールのクラスと、本体の同じ名前のクラスは別のクラス（known_bugs.md #30）
#
# 実行時の `x is V` / `isinstance(x, V)` / `match` の `is V:` の腕 / `x mustbe V` / `except E:` は、その名前を
# 今の場所で引いたクラスと同じクラスかで決まる（`class_id` で比べる・`ar_method_guard` と同じ）。
# ⚠ 以前は名前の文字列で比べていたので、モジュールの中の照合が本体の `V` を通し、本体の `except E:` がモジュールの
#   `E` を捕まえていた。組み込みのクラス（`ValueError`・enum）はどのモジュールでも同じクラスのまま。
# 例題は examples/basics/module_class_identity.ar（gate/ のテストは examples/ を参照しない）。
from ..lib.check import check_eq

import namespace_modules.same_name as m

class V:
    mut x: float

class E(Error):
    fn __init__(mut self, message: str) -> None:
        self.message = message

fn raise_main() -> None:
    raise E("main E")

# モジュールの中の照合
check_eq(m.probe(V(2.0)), ["is False", "isinstance False", "other arm", "mustbe refused"], "module probe, the main program's V")
check_eq(m.probe(m.make()), ["is True", "isinstance True", "is V arm", "mustbe ok"], "module probe, the module's V")

# 本体の照合
let mv: Any = m.make()
check_eq(mv is V, False, "module V is V")
check_eq(isinstance(mv, V), False, "isinstance(module V, V)")
check_eq(mv is m.V, True, "module V is m.V")
check_eq(V(3.0) is V, True, "main V is V")
check_eq(isinstance(V(3.0), V), True, "isinstance(main V, V)")
check_eq(V(3.0) is m.V, False, "main V is m.V")
mut arm = "other arm"
match (mv):
    is V:
        arm = "is V arm"
check_eq(arm, "other arm", "match is V with the module's V")

# mustbe の誤りは、どこで定義したクラスかを添える（クラスの名前は修飾しない）
mut msg = ""
try:
    let v = mv mustbe V
except TypeError as e:
    msg = str(e)
check_eq(msg.endswith("expected `V`, got `V` (another class of the same name, defined in module `namespace_modules.same_name`)"),
    True, "mustbe message: " + msg)

# except
check_eq(m.catch(raise_main), "another exception", "module except E, the main program's E")
check_eq(m.catch(m.raise_e), "caught as this module's E", "module except E, the module's E")
mut caught = ""
try:
    m.raise_e()
except E:
    caught = "main E"
except m.E as e:
    caught = "m.E " + e.message
check_eq(caught, "m.E module E", "main except E / m.E")

# 組み込みのクラスはどのモジュールでも同じクラス
mut builtin = ""
try:
    m.raise_value()
except ValueError as e:
    builtin = str(e is ValueError) + " " + str(isinstance(e, ValueError))
check_eq(builtin, "True True", "a ValueError raised in the module")
builtin = ""
try:
    m.parse_bad()
except ValueError as e:
    builtin = str(e is ValueError)
check_eq(builtin, "True", "an internal ValueError raised in the module")
check_eq(m.is_level(m.Level.High), True, "enum member is Level in the module")

# 非同期タスクの中でも同じ（ワーカーにも各大域のモジュールの名前を送る・`TaskEnv::module_names`）
mut mng = AsyncManager(num_thread=2)
mng <- async->list[str]:
    block_return m.probe(V(2.0)) + m.probe(m.make())
mng.wait_for_finish()
check_eq(mng.error_list[0], None, "the task did not fail")
check_eq(mng.results[0], ["is False", "isinstance False", "other arm", "mustbe refused",
    "is True", "isinstance True", "is V arm", "mustbe ok"], "module probe in a task")
