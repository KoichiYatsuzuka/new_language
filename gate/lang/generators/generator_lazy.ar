# generator_lazy.ar — ジェネレータは遅延評価される（bug_fix.md B13・コルーチン化）
#
# ⚠⚠ **以前は先行評価だった。** 本体を最後まで走らせて全 `yield` 値を `Vec` に集めてから
#    ジェネレータを作っていたので:
#      - `while True: yield i` は**永久にハング**した（出力が 1 つも出ない）
#      - 副作用が**全て消費前**に起きた（`break` しても後続の produce は走り済み）
#      - メモリが yield の総数に比例した
#    今は CPython と同じく「次の `yield` まで走って中断」する。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/generator_lazy.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 1. 生成と消費が交互になる ===")])
gen noisy(let n: int) -> int:
    mut i = 0
    while i < n:
        emit([str("  produce"), str(i)])
        yield i
        i += 1

for v in noisy(5):
    emit([str("consume"), str(v)])
    if v == 1:
        break
# produce 0 / consume 0 / produce 1 / consume 1
# ⚠ produce 2..4 は**起きない**。break が本体に届く。

emit([str("=== 2. 無限ジェネレータが書ける ===")])
# ⚠⚠ これが先行評価では不可能だった形。
gen naturals() -> int:
    mut i = 0
    while True:
        yield i
        i += 1

mut taken = []
for v in naturals():
    taken.append(v)
    if len(taken) == 5:
        break
emit([str(taken)])                      # [0, 1, 2, 3, 4]

emit([str("=== 3. 消費しなければ本体は 1 行も走らない ===")])
gen never_runs() -> int:
    emit([str("  この行は出ない")])
    yield 1

let unused = never_runs()
emit([str("作っただけ")])

emit([str("=== 4. 消費し切ると finally が走る ===")])
# ⚠ 以前は**生成時**に走っていた（消費より前に "cleanup" が出た）。
gen with_cleanup() -> int:
    try:
        yield 1
        yield 2
    finally:
        emit([str("  cleanup")])

mut got = []
for v in with_cleanup():
    got.append(v)
emit([str(got)])                        # cleanup のあとに [1, 2]

emit([str("=== 5. close() で明示的に閉じる ===")])
# ⚠ 中断点へ `GeneratorExit` を投げ込むので、囲む `try` の `finally` が走る。
let half = with_cleanup()
emit([str(half.next())])                # 1
emit([str("closing")])
half.close()                      # ここで cleanup が出る
emit([str("closed")])

emit([str("=== 6. finally が走る条件（まとめ）===")])
# ⚠⚠ **`Drop` から Arrow のコードは呼べない**（`&mut Interpreter` を持てず、エラーも
#    返せず、VM が借用中に再入する危険がある）。そのため後始末の走り方は 4 通りに分かれる:
#
#   | 形 | `finally` |
#   |---|---|
#   | 消費し切った | ✅ その場で走る |
#   | `close()` を呼んだ | ✅ その場で走る |
#   | 変数に持ったままプログラム終了 | ✅ **終了時のスイープ**で走る |
#   | 途中で捨てた（一時値・再代入で消えた）| ❌ **走らない** |
#
# ⚠ 最後の 1 つが Python との既知の差。⇒ **後始末が要るなら `close()` を呼ぶこと。**
mut kept = []
for v in with_cleanup():
    kept.append(v)
    break
emit([str(kept)])                       # [1]（この時点では cleanup は出ない）

emit([str("=== 7. 交互消費 ===")])
gen count_from(let s: int) -> int:
    mut i = s
    while i < s + 3:
        yield i
        i += 1

let a = count_from(0)
let b = count_from(10)
emit([str(a.next()), str(b.next()), str(a.next()), str(b.next())])   # 0 10 1 11

# ── 出力を照らす ──
check_output([
    "=== 1. 生成と消費が交互になる ===",
    "  produce 0",
    "consume 0",
    "  produce 1",
    "consume 1",
    "=== 2. 無限ジェネレータが書ける ===",
    "[0, 1, 2, 3, 4]",
    "=== 3. 消費しなければ本体は 1 行も走らない ===",
    "作っただけ",
    "=== 4. 消費し切ると finally が走る ===",
    "  cleanup",
    "[1, 2]",
    "=== 5. close() で明示的に閉じる ===",
    "1",
    "closing",
    "  cleanup",
    "closed",
    "=== 6. finally が走る条件（まとめ）===",
    "[1]",
    "=== 7. 交互消費 ===",
    "0 10 1 11",
    "",
], "generator_lazy")
