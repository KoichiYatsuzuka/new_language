# field_type.ar — フィールドの宣言型が代入時に守られること（0-2）
#
# ⚠ このバグの再現条件は「クラスのレイアウト」だった。
#   `store_field` は **raw レイアウトを持つクラスでだけ**値と slot 形式を突き合わせており、
#   raw レイアウトは「trait 継承なし・全フィールドが int/float 系プリミティブ」のときだけ付く。
#   つまり `str` フィールドが 1 つ混ざるか trait を 1 つ実装しただけで検査が消えていた。
#   ここでは**その両方の形**を正常系として通し、対になるエラー例で弾かれることを示す。
#
# 誤った代入は field_type_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/field_type.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 全フィールドがプリミティブ（raw レイアウト） ===")])

class Point:
    mut x: int
    mut y: int

mut p = Point(1, 2)
p.x = 10
p.y = 20
emit([str(p.x), str(p.y)])         # 10 20

emit([str("=== str が混ざる（boxed レイアウト・以前は無検査だった形） ===")])

class Tagged:
    mut n: int
    mut label: str

mut t = Tagged(1, "a")
t.n = 5
t.label = "updated"
emit([str(t.n), str(t.label)])     # 5 updated

emit([str("=== trait を実装する（boxed レイアウト・以前は無検査だった形） ===")])

trait Creature:
    mut hp: int
    mut name: str

class Wolf(Creature):
    mut pack: int

    fn hurt(mut self, d: int) -> None:
        self::Creature.hp = self::Creature.hp - d

    fn rename(mut self, n: str) -> None:
        self.name = n

mut w = Wolf(40, "Grey", 5)
w.hp = 30
w.name = "Silver"
w.pack = 7
w.hurt(5)
w.rename("Ghost")
emit([str(w.hp), str(w.name), str(w.pack)])   # 25 Ghost 7

emit([str("=== float フィールドへの int（拡大は許される） ===")])

class Physics:
    mut mass: float

mut ph = Physics(1.0)
ph.mass = float(3)              # int → float の拡大
emit([str(ph.mass)])           # 3.0

emit([str("=== コレクション型のフィールド ===")])

class Holder:
    mut items: list[int]

mut h = Holder([1])
h.items = [2, 3]
emit([str(h.items)])           # [2, 3]

emit([str("=== 複合代入（格納されるのは f <op> v の結果） ===")])

class Counter:
    mut n: int

mut c = Counter(1)
c.n += 5
emit([str(c.n)])               # 6

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== 全フィールドがプリミティブ（raw レイアウト） ===",
    "10 20",
    "=== str が混ざる（boxed レイアウト・以前は無検査だった形） ===",
    "5 updated",
    "=== trait を実装する（boxed レイアウト・以前は無検査だった形） ===",
    "25 Ghost 7",
    "=== float フィールドへの int（拡大は許される） ===",
    "3.0",
    "=== コレクション型のフィールド ===",
    "[2, 3]",
    "=== 複合代入（格納されるのは f <op> v の結果） ===",
    "6",
    "done",
    "",
], "field_type")
