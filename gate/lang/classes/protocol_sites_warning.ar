# protocol_sites.ar — protocol 適合検査が**すべての束縛点**で効くこと（0-7）
#
# ⚠⚠ protocol は**構造的適合**（`class C(Pr)` のように基底に書かない）。
#   そのため `type_matches` は protocol 期待型に対して**任意のクラスを通す**作りで、
#   適合の判定は `check_protocol_conformance` が別に担っている。
#   ⇒ その呼び出しが無い束縛点は**不適合が素通り**し、逆に protocol 名が
#     `NamedInstance` のまま残っていた束縛点は**適合するクラスまで弾いて**いた。
#
# 誤った型は protocol_sites_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/protocol_sites.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

protocol Drawable:
    mut size: int
    fn draw(self) -> str:
        ...

class Circle:
    mut size: int

    fn draw(self) -> str:
        return "circle"

class Square:
    mut size: int

    fn draw(self) -> str:
        return "square"

emit([str("=== let / mut の注釈 ===")])

let d: Drawable = Circle(1)
emit([str(d.draw())])             # circle

mut m: Drawable = Circle(2)
m = Square(3)               # 再代入も適合検査を通る
emit([str(m.draw())])             # square

emit([str("=== 自由関数の引数 ===")])

fn render(let x: Drawable) -> str:
    return x.draw()

emit([str(render(Circle(4)))])    # circle
emit([str(render(Square(5)))])    # square

emit([str("=== メソッドの引数 ===")])

class Canvas:
    mut n: int

    fn add(self, let x: Drawable) -> str:
        return x.draw()

emit([str(Canvas(0).add(Circle(6)))])     # circle

emit([str("=== コンストラクタの引数 / protocol 型のフィールド ===")])

class Slot:
    mut item: Drawable

mut s = Slot(Circle(7))
emit([str(s.item.draw())])        # circle
s.item = Square(8)          # フィールド書き込みも適合検査を通る
emit([str(s.item.draw())])        # square

emit([str("=== 戻り値 ===")])

# ⚠ protocol を戻り値型にすると警告が出る（言語側の方針・本変更とは無関係）:
#   Warning: function 'make' returns protocol type 'Drawable'; consider returning a concrete type

fn make(let which: int) -> Drawable:   # expect: warning ProtocolReturnType
    if which == 0:
        return Circle(9)
    return Square(10)

emit([str(make(0).draw())])       # circle
emit([str(make(1).draw())])       # square

emit([str("=== テンプレートの型引数 ===")])

class Box[T]:
    mut v: T

    fn get(self) -> T:
        return self.v

emit([str(Box[Drawable](Circle(11)).get().draw())])   # circle

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== let / mut の注釈 ===",
    "circle",
    "square",
    "=== 自由関数の引数 ===",
    "circle",
    "square",
    "=== メソッドの引数 ===",
    "circle",
    "=== コンストラクタの引数 / protocol 型のフィールド ===",
    "circle",
    "square",
    "=== 戻り値 ===",
    "circle",
    "square",
    "=== テンプレートの型引数 ===",
    "circle",
    "done",
    "",
], "protocol_sites_warning")
