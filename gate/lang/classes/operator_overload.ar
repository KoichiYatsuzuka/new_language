# operator_overload.ar — 演算子オーバーロードのデモ

# ── 1. 算術演算子 (__add__, __sub__, __mul__) ─────────────────────────────────
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/operator_overload.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

class Vec2:
    mut x: int
    mut y: int
    fn __init__(mut self, let x: int, let y: int) -> None:
        self.x = x
        self.y = y

    fn __add__(self, let other: Vec2) -> Vec2:
        return Vec2(self.x + other.x, self.y + other.y)

    fn __sub__(self, let other: Vec2) -> Vec2:
        return Vec2(self.x - other.x, self.y - other.y)

    fn __mul__(self, let s: int) -> Vec2:
        return Vec2(self.x * s, self.y * s)

    fn __neg__(self) -> Vec2:
        return Vec2(-self.x, -self.y)

    fn __eq__(self, let other: Vec2) -> bool:
        return self.x == other.x and self.y == other.y

    fn __str__(self) -> str:
        return "Vec2(" + str(self.x) + ", " + str(self.y) + ")"

let a = Vec2(1, 2)
let b = Vec2(3, 4)

let c = a + b
emit([str(str(c))])          # Vec2(4, 6)

let d = b - a
emit([str(str(d))])          # Vec2(2, 2)

let e = a * 3
emit([str(str(e))])          # Vec2(3, 6)

let f = -a
emit([str(str(f))])          # Vec2(-1, -2)

emit([str(a == Vec2(1, 2))]) # True
emit([str(a == b)])          # False

# ── 2. 比較演算子 (__lt__, __le__) ──────────────────────────────────────────
class Score:
    mut val: int
    fn __init__(mut self, let val: int) -> None:
        self.val = val

    fn __lt__(self, let other: Score) -> bool:
        return self.val < other.val

    fn __le__(self, let other: Score) -> bool:
        return self.val <= other.val

    fn __str__(self) -> str:
        return "Score(" + str(self.val) + ")"

let s1 = Score(10)
let s2 = Score(20)
emit([str(s1 < s2)])   # True
emit([str(s2 < s1)])   # False
emit([str(s1 <= s1)])  # True

# ── 3. __len__ / __bool__ ────────────────────────────────────────────────────
class Bag:
    mut items: list[int]
    fn __init__(mut self, let items: list[int]) -> None:
        self.items = items

    fn __len__(self) -> int:
        return len(self.items)

    fn __bool__(self) -> bool:
        return len(self.items) > 0

    fn __str__(self) -> str:
        return "Bag(" + str(self.items) + ")"

let bag = Bag([1, 2, 3])
emit([str(len(bag))])      # 3

# ⚠⚠ **条件は `bool` でなければならない**（決定 D-12・タスク 5.5）。Arrow は真偽性を
#   使わないので `if empty:` とは書けず、`__bool__()` を**明示的に呼ぶ**。
#   設計書は移行対象としてこの 1 箇所を名指ししていた。
# ⚠ `__bool__` が死ぬわけではない。`not` / `and` / `or` は今も `__bool__` を経由する
#   （下の `not empty` がその実演）。
let empty = Bag([])
if empty.__bool__():
    emit([str("not empty")])
else:
    emit([str("empty")])   # empty

emit([str(not empty)])     # True    ← not は __bool__ を呼ぶ

if bag.__bool__():
    emit([str("has items")]) # has items

# ── 4. __next__ (イテレータプロトコル) ───────────────────────────────────────
class Counter:
    mut current: int
    mut stop: int
    fn __init__(mut self, let start: int, let stop: int) -> None:
        self.current = start
        self.stop = stop

    fn __next__(mut self) -> int:
        if self.current >= self.stop:
            raise ValueError("StopIteration")
        let val = self.current
        self.current = self.current + 1
        return val

mut counter = Counter(0, 3)
emit([str(next(counter))])  # 0
emit([str(next(counter))])  # 1
emit([str(next(counter))])  # 2

# ── 5. ビット演算子 (__and__, __or__, __xor__, __invert__) ────────────────────
class Flags:
    mut bits: int
    fn __init__(mut self, let bits: int) -> None:
        self.bits = bits

    fn __and__(self, let other: Flags) -> Flags:
        return Flags(self.bits & other.bits)

    fn __or__(self, let other: Flags) -> Flags:
        return Flags(self.bits | other.bits)

    fn __xor__(self, let other: Flags) -> Flags:
        return Flags(self.bits ^ other.bits)

    fn __invert__(self) -> Flags:
        return Flags(~self.bits)

    fn __str__(self) -> str:
        return "Flags(" + str(self.bits) + ")"

let fa = Flags(0b1010)
let fb = Flags(0b1100)
emit([str(str(fa & fb))])   # Flags(8)   = 0b1000
emit([str(str(fa | fb))])   # Flags(14)  = 0b1110
emit([str(str(fa ^ fb))])   # Flags(6)   = 0b0110
emit([str(str(~fa))])       # Flags(-11)

# ── 出力を照らす ──
check_output([
    "Vec2(4, 6)",
    "Vec2(2, 2)",
    "Vec2(3, 6)",
    "Vec2(-1, -2)",
    "True",
    "False",
    "True",
    "False",
    "True",
    "3",
    "empty",
    "True",
    "has items",
    "0",
    "1",
    "2",
    "Flags(8)",
    "Flags(14)",
    "Flags(6)",
    "Flags(-11)",
    "",
], "operator_overload")
