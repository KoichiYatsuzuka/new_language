# trait_template_args.ar — テンプレート trait の型引数が効く（タスク 9.9）
#
# ## 何が壊れていたか
#
#     trait Holder[T]:
#         let item: T
#
#     class IntBox(Holder[int]):
#         fn __init__(mut self, v: int) -> None:
#             self.item = v          # 旧: field 'item' is declared 'T' but got 'int'
#
#     let h: Holder[int] = IntBox(3) # 旧: declared 'Holder[int]' but initialized with 'IntBox'
#
# 症状は 2 つあったが**根は 1 つ**だった。パーサは `class IntBox(Holder[int])` の
# `["int"]` を集めて自動 `__init__` の引数型に使っていたのに、**AST へ載せずに捨てて**
# いたので型検査へ届いていなかった。
#
# ⇒ `Stmt::ClassDef` に `base_args` を足し（`bases` と同じ並び）、
#   レジストリが `クラス → 基底 → 型引数` を持つようにした。これで
#
#   1. 継承したフィールド・メソッドの型が `T` → 具体型に**置換**される
#   2. `Holder[int]` という**注釈**にクラスが適合するか判定できる
#
# ⚠ 2 つ目は**タスク 9.7 が露見させた**穴。それ以前は注釈の `[int]` がパーサで
#   捨てられて `Holder` になっていたので、型引数を見ないまま通っていた。
#
# ⚠ 型引数を書かない `class C(Holder)` は**従来どおり照合しない**（判らないものを通す）。
#   「書かなかった」を不一致に倒すと既存のコードを一律に弾いてしまう。
#
# 弾かれる例は trait_template_args_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/trait_template_args.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 継承したフィールドの型が具体型に解決される ===")])

trait Holder[T]:
    mut item: T

class IntBox(Holder[int]):
    mut tag: str

let b = IntBox(5, "b")
emit([str(b.item)])                   # 5
emit([str(b.tag)])                    # b

emit([str("=== 注釈として書ける ===")])

let h: Holder[int] = b
emit([str(h.item)])                   # 5

fn read(h: Holder[int]) -> int:
    return h.item

emit([str(read(b))])                  # 5

emit([str("=== メソッドの戻り値型も置換される ===")])

trait Sized[T]:
    fn size(self) -> T:
        ...

class Counter(Sized[int]):
    mut n: int

    fn size(self) -> int:
        return self.n

let c = Counter(7)
emit([str(c.size())])                 # 7

emit([str("=== trait 修飾アクセスも同じ ===")])

trait Counted[T]:
    mut count: T

class Bag(Counted[int]):
    fn __init__(mut self) -> None:
        self.count = 0

mut bag = Bag()
bag::Counted.count = 7
emit([str(bag::Counted.count)])       # 7
bag::Counted.count += 5
emit([str(bag.count)])                # 12

emit([str("=== 型引数を書かない基底は従来どおり ===")])

trait Plain:
    mut n: int

class Simple(Plain):
    fn __init__(mut self) -> None:
        self.n = 1

let p: Plain = Simple()
emit([str(p.n)])                      # 1

# ── 出力を照らす ──
check_output([
    "=== 継承したフィールドの型が具体型に解決される ===",
    "5",
    "b",
    "=== 注釈として書ける ===",
    "5",
    "5",
    "=== メソッドの戻り値型も置換される ===",
    "7",
    "=== trait 修飾アクセスも同じ ===",
    "7",
    "12",
    "=== 型引数を書かない基底は従来どおり ===",
    "1",
    "",
], "trait_template_args")
