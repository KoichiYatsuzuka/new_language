# static_mut_assign.ar — `static mut` クラス変数はインスタンス経由でも代入できる（タスク 1.2）
#
# ## 何が壊れていたか
#
# `FieldKind::StaticMut` の仕様は
#
#   「静的可変クラス変数（`static mut name: Type [= default]`）。すべてのインスタンスで
#     共有される可変セル。**インスタンス経由・クラス名経由どちらでもアクセス・代入可能**」
#                                                          （`src/ast.rs` の doc）
#
# ところが型検査が可変性を `matches!(kind, FieldKind::Mut)` で判定していたため
# **`StaticMut` が不変として扱われ**、インスタンス経由の代入が
#
#   StaticTypeError  cannot assign to immutable field 'n' of class 'C'
#
# で塞がれていた。⚠ **実行時は実装済み**（`attrs.rs` が `inst_class.static_vars` を更新する）
# ＝静的検査だけが塞いでいる**層の食い違い**だった。
#
# ⚠ 露見しなかったのは、既存例題（`class_trait.ar` の `Registry.entry_count`）が
#   **クラス名経由でしか代入しておらず**、インスタンス経由を書いた例題が 1 本も
#   無かったため。⇒ この例題がその穴を埋める。
#
# ⚠ 同じ式が `registry/builder.rs` と `stmt/check.rs` の **2 箇所**にある。
#   片方だけ直すとずれるので両方を直した。
#
# 誤った型を入れる例は static_mut_assign_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/static_mut_assign.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== クラス名経由の代入（従来から通っていた） ===")])

class Counter:
    static mut total: int = 0
    mut own: int

Counter.total = 10
emit([str(Counter.total)])                # 10

emit([str("=== インスタンス経由の代入（タスク 1.2 で通るようになった） ===")])

mut a = Counter(1)
a.total = 20
emit([str(a.total), str(Counter.total)])       # 20 20   ← 同じセルを共有している

emit([str("=== 全インスタンスで共有されている ===")])

mut b = Counter(2)
emit([str(b.total)])                      # 20   ← b も同じセルを見る
b.total = 30
emit([str(a.total), str(b.total), str(Counter.total)])   # 30 30 30

emit([str("=== インスタンス変数とは独立 ===")])

a.own = 100
b.own = 200
emit([str(a.own), str(b.own)])                 # 100 200   ← own は共有されない
emit([str(a.total), str(b.total)])             # 30 30     ← total は共有される

emit([str("=== メソッドの中からも書ける ===")])

class Registry2:
    static mut count: int = 0
    mut tag: str

    fn bump(mut self) -> int:
        self.count = self.count + 1     # インスタンス経由（self）で代入
        return self.count

mut r1 = Registry2("a")
mut r2 = Registry2("b")
emit([str(r1.bump())])                    # 1
emit([str(r2.bump())])                    # 2   ← r1 と同じセル
emit([str(Registry2.count)])              # 2

emit([str("=== static mut の中身はクラス名経由でも書き換えられる ===")])

# ⚠ 以前は経路の根のクラス名（`Log`）の束縛が不変なので、`Log.lines.append(..)` が
#   `cannot call 'append' on 'Log' — it is immutable` で誤って弾かれていた（実行時は通る）。
#   型の値は「値の束縛」ではない。書き換えられないのは `const` の中身だけ（const_member_assign_error.ar）。
class Log:
    static mut lines: list[str] = []
    mut level: int

Log.lines.append("start")
Log.lines[0] = "boot"
emit([str(Log.lines)])                    # ['boot']

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== クラス名経由の代入（従来から通っていた） ===",
    "10",
    "=== インスタンス経由の代入（タスク 1.2 で通るようになった） ===",
    "20 20",
    "=== 全インスタンスで共有されている ===",
    "20",
    "30 30 30",
    "=== インスタンス変数とは独立 ===",
    "100 200",
    "30 30",
    "=== メソッドの中からも書ける ===",
    "1",
    "2",
    "2",
    "=== static mut の中身はクラス名経由でも書き換えられる ===",
    "['boot']",
    "done",
    "",
], "static_mut_assign")
