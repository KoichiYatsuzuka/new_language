# protocol_generic_constraint_error.ar — protocol の型引数に制約は書けない（pandas_import_plan.md の 6-5）
#
# 適合の照合は型引数を置き換えた要求と構造で見るだけで、制約（`T: Trait`）を使わない。書いても効かないので誤りにする。
#
# 期待されるエラー（構文解析）:
#   ParseError: the type parameter `T` of protocol `Holder` cannot have a constraint
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/classes/protocol_generic_constraint_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

trait Named:
    fn name(self) -> str:
        ...

protocol Holder[T: Named]:   # expect: parse - "ParseError: the type parameter `T` of protocol `Holder` cann"
    fn get(self) -> T:
        ...
