# static_mut_class_assign.ar — クラス名経由の `static mut` 代入も検査する（タスク 5.3）
#
# ## 何が壊れていたか
#
# **同じフィールドなのに経路で扱いが割れていた**（実測）:
#
# | 書き方 | 以前 |
# |---|---|
# | `c.n = "s"`（インスタンス経由） | ⛔ 静的に弾かれる |
# | `C.n = "s"`（クラス名経由） | ✅ **黙って通り `s` を出す** |
#
# 原因は受け手の解決。`class_and_subst` は `NamedInstance` / `GenericInstance` しか
# 知らず、クラス名そのものの型（`TypeValOf(NamedInstance(C))`）を渡すと `None` を返す。
# 呼び出し側はそこで `return` していたので、**照合に到達する前に抜けていた**。
#
# ⚠ 期待型（`infer(target)`）は**正しく `int` を返していた**。`let x: str = C.n` は
#   以前からちゃんと弾かれていたので、読みは合っていて書きだけ穴だった。
#
# ⚠ `static let` は存在しない（`ParseError: expected 'fn' or 'mut' after 'static'`）ので、
#   可変性の心配は無い。
#
# 弾かれる例は static_mut_class_assign_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/static_mut_class_assign.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== クラス名経由の代入 ===")])

class Counter:
    static mut total: int = 0
    mut step: int

    fn bump(mut self) -> None:
        Counter.total += self.step

mut a = Counter(2)
mut b = Counter(5)
a.bump()
b.bump()
emit([str(Counter.total)])                # 7

Counter.total = 100
emit([str(Counter.total)])                # 100

emit([str("=== インスタンス経由でも同じ宣言型が効く ===")])

mut c = Counter(1)
c.step = 3
emit([str(c.step)])                       # 3

emit([str("=== 文字列の static mut ===")])

class Registry:
    static mut last: str = ""
    mut id: int

Registry.last = "hello"
emit([str(Registry.last)])                # hello

emit([str("=== クラス名を値として持つ変数からも同じ ===")])

# ⚠ `let K = Counter` は `TypeValOf(NamedInstance(Counter))` を束縛する。
#   受け手の解決はこの形も剥がす。
let K = Counter
K.total = 42
emit([str(Counter.total)])                # 42

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== クラス名経由の代入 ===",
    "7",
    "100",
    "=== インスタンス経由でも同じ宣言型が効く ===",
    "3",
    "=== 文字列の static mut ===",
    "hello",
    "=== クラス名を値として持つ変数からも同じ ===",
    "42",
    "done",
    "",
], "static_mut_class_assign")
