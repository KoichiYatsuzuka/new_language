# eq_dunder_consistency.ar — ユーザー定義 `__eq__` が `==` 以外にも効くこと（B2-b）。
#
# ⚠⚠ 以前は `__eq__` が **`==` 演算子でしか呼ばれていなかった**。`in` / `not in` /
#   set の包含は構造比較（`values_eq`）を直接呼んでいたため、
#   **`a == b` は True なのに `a in [b]` は False** という食い違いが起きていた。
#   エラーにならないので気付けない形。
#
# 実装は `apply_binop` / `apply_binop_dyn` と同じ二層構造:
#   - `values_eq`      … `&self` の構造比較。FFI 経路や集合演算が使う
#   - `values_eq_dyn`  … `__eq__` を呼ぶ（インタプリタを回すので `&mut self`）
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/eq_dunder_consistency.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

class Q:
    let x: int
    fn __init__(mut self, let x: int) -> None:
        self.x = x
    # x の偶奇だけで等しいとみなす（構造比較とは違う答えを返す）
    fn __eq__(let self, let other: Q) -> bool:
        return self.x % 2 == other.x % 2

let a = Q(1)
let b = Q(3)
let c = Q(2)

emit([str("=== `==` ===")])
emit([str(a == b)])              # True    どちらも奇数
emit([str(a == c)])              # False

emit([str("=== `in` / `not in` も同じ答えになる ===")])
emit([str(a in [b])])            # True
emit([str(a in [c])])            # False
emit([str(a not in [c])])        # True
emit([str(a in (b,))])           # True
emit([str(a in {b})])            # True

emit([str("=== set のメソッドも同じ規則 ===")])
mut s = {b}
s.add(a)                   # __eq__ が True なので重複として弾かれる
emit([str(len(s))])              # 1
s.add(c)                   # 偶数なので別物
emit([str(len(s))])              # 2
s.remove(a)                # b が __eq__ で一致して消える
emit([str(len(s))])              # 1

emit([str("=== 構造比較との対照（__eq__ が無いクラス）===")])
class P:
    let x: int
    fn __init__(mut self, let x: int) -> None:
        self.x = x
emit([str(P(1) == P(1))])        # True    全フィールドが等しい
emit([str(P(1) in [P(1)])])      # True
emit([str(P(1) == P(2))])        # False

# ── 出力を照らす ──
check_output([
    "=== `==` ===",
    "True",
    "False",
    "=== `in` / `not in` も同じ答えになる ===",
    "True",
    "False",
    "True",
    "True",
    "True",
    "=== set のメソッドも同じ規則 ===",
    "1",
    "2",
    "1",
    "=== 構造比較との対照（__eq__ が無いクラス）===",
    "True",
    "True",
    "False",
    "",
], "eq_dunder_consistency")
