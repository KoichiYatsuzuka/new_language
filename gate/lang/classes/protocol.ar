# Protocol example: structural typing demo
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/protocol.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

protocol Drawable:
    fn draw(self) -> None:
        ...
    fn area(self) -> float:
        ...

protocol Resizable:
    fn resize(self, factor: float) -> None:
        ...

class Circle:
    mut radius: float

    fn __init__(mut self, r: float) -> None:
        self.radius = r

    fn draw(self) -> None:
        emit([str("Drawing circle with radius"), str(self.radius)])

    fn area(self) -> float:
        return 3.14159 * self.radius * self.radius

    fn resize(mut self, factor: float) -> None:
        self.radius = self.radius * factor

class Square:
    mut side: float

    fn __init__(mut self, s: float) -> None:
        self.side = s

    fn draw(self) -> None:
        emit([str("Drawing square with side"), str(self.side)])

    fn area(self) -> float:
        return self.side * self.side

    fn resize(mut self, factor: float) -> None:
        self.side = self.side * factor

fn render(shape: Drawable) -> None:
    shape.draw()
    emit([str("Area:"), str(shape.area())])

fn make_bigger(mut shape: Resizable) -> None:
    shape.resize(2.0)

# Assign instances to protocol-typed variables
mut c = Circle(5.0)
mut s = Square(3.0)

let d1: Drawable = c
let d2: Drawable = s

render(d1)
render(d2)

# is Protocol runtime check
if c is Drawable:
    emit([str("Circle satisfies Drawable")])

if s is Drawable:
    emit([str("Square satisfies Drawable")])

make_bigger(c)
emit([str("Circle after resize:"), str(c.radius)])

# ── 出力を照らす ──
check_output([
    "Drawing circle with radius 5.0",
    "Area: 78.53975",
    "Drawing square with side 3.0",
    "Area: 9.0",
    "Circle satisfies Drawable",
    "Square satisfies Drawable",
    "Circle after resize: 10.0",
    "",
], "protocol")
