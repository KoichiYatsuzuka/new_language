# polymorphism.tl — templates, new_type, and trait-based polymorphism

# --- Trait definitions used for constraints ---
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/classes/polymorphism.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

trait Printable:
    fn to_str(self) -> str:
        ...

trait Comparable:
    fn less_than(self, other: Self) -> bool:
        ...

# --- Classes implementing traits ---
class MyInt(Printable, Comparable):
    mut value: int

    fn to_str(self) -> str:
        return "MyInt"

    fn less_than(self, other: Self) -> bool:
        return self.value < other.value

class MyStr(Printable):
    mut text: str

    fn to_str(self) -> str:
        return "MyStr(" + self.text + ")"

# --- Template function: single trait constraint ---
emit([str("=== template function ===")])

fn show[T: Printable](item: T) -> None:
    emit([str(item.to_str())])

let a = MyInt(42)
let b = MyStr("hello")
show[MyInt](a)   # MyInt
show[MyStr](b)   # MyStr(hello)

# --- Template function: multiple constraints (and) ---
emit([str("=== template with multiple constraints ===")])

fn min_of[T: Printable and Comparable](x: T, y: T) -> T:
    if x.less_than(y):
        return x
    return y

let x = MyInt(10)
let y = MyInt(30)
let smaller = min_of[MyInt](x, y)
emit([str(smaller.to_str())])  # MyInt(10)

# --- Template class ---
emit([str("=== template class ===")])

class Box[T: Printable]:
    mut item: T

    fn label(self) -> str:
        return "Box[" + self.item.to_str() + "]"

let box_int = Box[MyInt](a)
let box_str = Box[MyStr](b)
emit([str(box_int.label())])   # Box[MyInt(42)]
emit([str(box_str.label())])   # Box[MyStr(hello)]

# --- new_type from class: creates a distinct type sharing all methods ---
emit([str("=== new_type from class ===")])

class Meters:
    mut value: int

    fn get(self) -> int:
        return self.value

    fn add(self, other: Self) -> Self:
        return Self(self.value + other.value)

    fn double(self) -> Self:
        return Self(self.value * 2)

new_type Kilometers: Meters
new_type LightSeconds: Meters

let m  = Meters(100)
let km = Kilometers(5)
let ls = LightSeconds(3)

emit([str(m.get())])   # 100
emit([str(km.get())])  # 5
emit([str(ls.get())])  # 3

# Methods return the correct new_type, not Meters
let km2 = km.double()
emit([str(km2.get())])  # 10

# new_types of the same base cannot be mixed via add (Self-typed)
# km.add(m)   # TypeError: expected Kilometers, got Meters

# --- new_type from primitive ---
emit([str("=== new_type from primitive ===")])

new_type Celsius: int
new_type Fahrenheit: int

let c = Celsius(100)
let f = Fahrenheit(212)
emit([str(c.value)])   # 100
emit([str(f.value)])   # 212

# Celsius and Fahrenheit are distinct — cannot be mixed
# let bad = c.value + f.value  # allowed here since we extract int first
let c_int = c=>int
let f_int = f=>int
emit([str(c_int + f_int)])  # 312 (plain ints can be added)

# --- Trait-based polymorphism: dispatch via a common interface ---
emit([str("=== trait-based polymorphism ===")])

fn print_all[T: Printable](items: T) -> None:
    emit([str(items.to_str())])

print_all[MyInt](MyInt(1))
print_all[MyInt](MyInt(2))
print_all[MyStr](MyStr("a"))

# ── 出力を照らす ──
check_output([
    "=== template function ===",
    "MyInt",
    "MyStr(hello)",
    "=== template with multiple constraints ===",
    "MyInt",
    "=== template class ===",
    "Box[MyInt]",
    "Box[MyStr(hello)]",
    "=== new_type from class ===",
    "100",
    "5",
    "3",
    "10",
    "=== new_type from primitive ===",
    "100",
    "212",
    "312",
    "=== trait-based polymorphism ===",
    "MyInt",
    "MyInt",
    "MyStr(a)",
    "",
], "polymorphism")
