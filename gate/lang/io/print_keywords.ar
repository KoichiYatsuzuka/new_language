# print_keywords.ar — print の sep= / end= / flush=（python_builtins_plan.md のタスク 5-1）
#
# 対になる誤りの例: print_keywords_error.ar
#
# CPython と同じ: sep は値の間（既定は空白 1 つ）、end は最後（既定は改行）。どちらも None なら既定。
# flush=True は標準出力をその場で流す。
# ⚠ 以前はキーワード引数を受ける口が無く、print(x, end="") を含む関数・文が
#   VmForceError（バイトコードにできない）で止まっていた。
# ⚠ file= は None だけ（標準出力の外へ書く手段が無い）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/print_keywords.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("a"), str("b"), str("c")], sep=", ")                  # a, b, c
emit([str("no newline")], end="")
emit([str(" <- same line")])                          # no newline <- same line
emit([str(1), str(2)], sep="", end="!\n")                  # 12!
emit([str("x")], sep=None, end=None)                  # x

fn row(let xs: list[int]) -> None:
    for x in xs:
        emit([str(x)], end=" ")
    emit([])

row([1, 2, 3])                                  # 1 2 3（末尾に空白）
emit([str("flushed")])                    # flushed

# ── 出力を照らす ──
check_output([
    "a, b, c",
    "no newline <- same line",
    "12!",
    "x",
    "1 2 3 ",
    "flushed",
    "",
], "print_keywords")
