# let_immutability.ar — `let` の不変性が守られる 3 つの場面（bug_fix.md B8/B9/B11 系統）。
#
# Arrow の束縛の規則:
#   **参照を共有するのは `let → let` のときだけ。それ以外は必ずディープコピーする。**
#   ⇒ 共有している 2 つの束縛は必ず両方 `let` ＝ どちらからも変更できない。
#
# 関数の引数だけは別ルール:
#   `let` / `mut` は「**関数内で値を書き換えるか**」の宣言。`mut` パラメータに `mut` 変数を
#   渡して呼び出し元まで書き変わるのは**正しい仕様**だが、`let` 変数を渡すのは**エラー**。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/let_immutability.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== L2: 式から let へ束縛しても共有しない ===")])
# ⚠ 以前は「複製するかどうか」が**式の形**で決まっており、`let x = <変数名>` は複製するのに
#   添字や属性を挟むと共有していた。⇒ `let` のスナップショットが後から変わった。
mut xs = [[1]]
let item = xs[0]
xs[0].append(9)
emit([str(item)])              # [1]        let の item は変わらない
emit([str(xs)])                # [[1, 9]]

# 関数の中でも同じ。⚠ 以前は VM の関数本体の命令（StoreLocalFreezeInstance）だけが
#   `Instance` しか複製せず、ここが [1, 9] になった（native_object_access_plan.md 1-6）。
fn l2_in_fn() -> None:
    mut ys = [[1]]
    let it = ys[0]
    ys[0].append(9)
    if len(it) != 1:
        raise ValueError("let it = ys[0] shared ys[0] inside a function")
    emit([str(it)])            # [1]
l2_in_fn()

class K:
    mut f: list[int]
    fn __init__(mut self, let f: list[int]) -> None:
        self.f = f
mut o = K([1])
let snap = o.f
o.f.append(9)
emit([str(snap)])              # [1]        フィールドから取った snap も独立

emit([str("=== L3: for のループ変数はコンテナの属性を継ぐ ===")])
# ⚠ 以前はループ変数が無条件に `mut` 扱いで、`let` のコンテナの要素を書き換えられた。
#   今は規則 1（要素は再帰的に属性を引き継ぐ）どおり、コンテナが `let` ならループ変数も `let`。
mut ys = [[1]]
for it in ys:
    it.append(9)         # ys は mut なので通る
emit([str(ys)])                # [[1, 9]]

# ⚠ `let zs` に対する `for it in zs: it = ...` は
#   StaticTypeError: cannot assign to immutable variable 'it' になる。
# ⚠⚠ `range(n)` やリテラルのような**一時値**の反復対象も `let`（規則 3・B4）。
#   その場で作られて誰とも共有していないので、書き換える意味が無い:
#     for i in range(3):
#         i = i * 10    # StaticTypeError: cannot assign to immutable variable 'i'
for i in range(3):
    emit([str("range のループ変数も let:"), str(i)])

emit([str("=== B8: let の中身は変更メソッドでも書き換えられない ===")])
# ⚠⚠ 以前は**添字代入だけ**が弾かれ、メソッド経由は素通りだった。
#   `let a = [1]; a[0] = 9` はエラーなのに `a.append(9)` は通る、という食い違い。
#   今は同じ規則で弾く:
#     let a = [1]
#     a.append(9)   # StaticTypeError: cannot call 'append' on 'a' — it is immutable
#
# ⚠ **推移的にも効く**（規則 1: 要素は根の属性を引き継ぐ）:
#     let o = K([1]); o.f.append(9)      # 根の 'o' が let なので弾かれる
#     let w = [[1]]; w[0].append(9)      # 根の 'w' が let なので弾かれる
#     let zs = [[1]]; for it in zs: it.append(9)   # ループ変数も let を継ぐ
#
# ⚠ **ユーザー定義クラスは誤検出しない。** レシーバの型がコレクションのときだけ見るので、
#   `let` インスタンス自身の `remove()` のようなメソッドは通る（下の対照）。
mut ok = [1]
ok.append(9)             # mut なら通る
emit([str(ok)])                # [1, 9]

class Bag:
    mut n: int
    fn __init__(mut self, let n: int) -> None:
        self.n = n
    fn remove(let self) -> int:
        return self.n
let bag = Bag(5)
emit([str(bag.remove())])      # 5   同名でもユーザー定義メソッドは通る

emit([str("=== B11: let を mut パラメータへ渡せない ===")])
fn touch(mut v: list[int]) -> None:
    v.append(9)

mut m = [1]
touch(m)                 # mut なら通る（呼び出し元まで書き変わるのが仕様）
emit([str(m)])                 # [1, 9]

touch([1])               # リテラルは一時値なので通る
emit([str("リテラルは通る")])

# ⚠ `let a = [1]; touch(a)` は
#   StaticTypeError: parameter 'v' of 'touch' expects a mutable argument, but got an immutable value
#   ⚠ `let` の**要素**も同じ（`let b = [[1]]; touch(b[0])` も弾かれる）。規則 1 のとおり。

# ── 出力を照らす ──
check_output([
    "=== L2: 式から let へ束縛しても共有しない ===",
    "[1]",
    "[[1, 9]]",
    "[1]",
    "[1]",
    "=== L3: for のループ変数はコンテナの属性を継ぐ ===",
    "[[1, 9]]",
    "range のループ変数も let: 0",
    "range のループ変数も let: 1",
    "range のループ変数も let: 2",
    "=== B8: let の中身は変更メソッドでも書き換えられない ===",
    "[1, 9]",
    "5",
    "=== B11: let を mut パラメータへ渡せない ===",
    "[1, 9]",
    "リテラルは通る",
    "",
], "let_immutability")
