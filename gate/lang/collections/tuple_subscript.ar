# tuple_subscript.ar — 添字の中の `,` は組になる（`d[x, y]` は `d[(x, y)]`・Python と同じ）
#
# 対になる誤り: tuple_subscript_error.ar
#
# ⚠ 型の合成を展開時に `dict[k, v]` / `tuple[a, b]` と書くために足した構文（設計書 D23・タスク 4-2）。
#   以前は `,` で `expected ']'` の構文エラーだった。実行時の値にも同じく効く。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/collections/tuple_subscript.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

mut grid: dict[tuple[int, int], str] = {}
grid[(0, 0)] = "origin"
grid[(1, 2)] = "a"

emit([str(grid[0, 0])])                   # origin
emit([str(grid[1, 2])])                   # a
emit([str(grid[(1, 2)] == grid[1, 2])])   # True

# ── 出力を照らす ──
check_output([
    "origin",
    "a",
    "True",
    "",
], "tuple_subscript")
