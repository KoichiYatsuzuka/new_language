# bytes_literal.ar — バイト列のリテラル `b"..."`（Python と同じ・known_bugs.md の #18）
#
# `b"..."` / `b'...'` は `bytes` の値（`bytes([..])` と同じ）。エスケープは Python と同じ（`\xNN`・`\n` などと 8 進の `\101`）、
# `rb"..."` / `br"..."` はエスケープを読まない。ASCII でない字は書けない（`bytes_literal_error.ar`）。
# ⚠ 以前は `b` を読み捨てて `str` にしていた（`type(b"ab")` が `<class 'str'>`・`b"ab".count(97)` が `TypeError`）。
#
# 期待される出力:
#   <class 'bytes'> b'aba' 2 3 97
#   b'\x89PNG\r\n' b'\\x41' b'a\\n' b"it's" b'A\x00'
#   b'abcd' True True
#   ok
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/bytes_literal.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

let a = b"aba"
emit([str(type(a)), str(a), str(a.count(97)), str(len(a)), str(a[0])])
emit([str(b"\x89PNG\r\n"), str(rb"\x41"), str(br"a\n"), str(b'it\'s'), str(b"\101\0")])
emit([str(b"ab" + b"cd"), str(b"" == bytes([])), str(b"hi" == "hi".encode("utf-8"))])
emit([str("ok")])

# ── 出力を照らす ──
check_output([
    "<class 'bytes'> b'aba' 2 3 97",
    "b'\\x89PNG\\r\\n' b'\\\\x41' b'a\\\\n' b\"it's\" b'A\\x00'",
    "b'abcd' True True",
    "ok",
    "",
], "bytes_literal")
