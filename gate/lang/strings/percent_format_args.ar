# percent_format_args.ar — `%` の書式の引数の数と、途中で終わる書式（known_bugs.md の #13）
#
# CPython と同じ: 余った引数は `TypeError`、書式が `%` や幅の途中で終われば `ValueError`。右辺が `__getitem__` を持つ物
# （list・dict など。tuple と str は除く）なら、余っても誤りにしない（CPython の `PyMapping_Check`）。
# ⚠ 以前はどちらも黙って捨てていた（`"%d" % (1, 2)` が `'1'`・`"ab%" % ()` が `'ab'`）。
#
# 期待される出力:
#   "%d" % (1, 2) -> TypeError: not all arguments converted during string formatting
#   "x" % 5 -> TypeError: not all arguments converted during string formatting
#   "x" % () -> x
#   "ab%" % () -> ValueError: incomplete format
#   "%5" % (1,) -> ValueError: incomplete format
#   "x" % [1] -> x
#   "x" % {"a": 1} -> x
#   "%d%%" % 5 -> 5%
#   "%s" % "s" -> s
#   "x" % "s" -> TypeError: not all arguments converted during string formatting
#   "%s" % [1, 2] -> [1, 2]
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/percent_format_args.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

try:
    emit([str('"%d" % (1, 2)'), str("->"), str("%d" % (1, 2))])
except Exception as e:
    emit([str('"%d" % (1, 2)'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"x" % 5'), str("->"), str("x" % 5)])
except Exception as e:
    emit([str('"x" % 5'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"x" % ()'), str("->"), str("x" % ())])
except Exception as e:
    emit([str('"x" % ()'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"ab%" % ()'), str("->"), str("ab%" % ())])
except Exception as e:
    emit([str('"ab%" % ()'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"%5" % (1,)'), str("->"), str("%5" % (1,))])
except Exception as e:
    emit([str('"%5" % (1,)'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"x" % [1]'), str("->"), str("x" % [1])])
except Exception as e:
    emit([str('"x" % [1]'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"x" % {"a": 1}'), str("->"), str("x" % {"a": 1})])
except Exception as e:
    emit([str('"x" % {"a": 1}'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"%d%%" % 5'), str("->"), str("%d%%" % 5)])
except Exception as e:
    emit([str('"%d%%" % 5'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"%s" % "s"'), str("->"), str("%s" % "s")])
except Exception as e:
    emit([str('"%s" % "s"'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"x" % "s"'), str("->"), str("x" % "s")])
except Exception as e:
    emit([str('"x" % "s"'), str("->"), str(type(e).__name__ + ":"), str(str(e))])
try:
    emit([str('"%s" % [1, 2]'), str("->"), str("%s" % [1, 2])])
except Exception as e:
    emit([str('"%s" % [1, 2]'), str("->"), str(type(e).__name__ + ":"), str(str(e))])

# ── 出力を照らす ──
check_output([
    "\"%d\" % (1, 2) -> TypeError: not all arguments converted during string formatting",
    "\"x\" % 5 -> TypeError: not all arguments converted during string formatting",
    "\"x\" % () -> x",
    "\"ab%\" % () -> ValueError: incomplete format",
    "\"%5\" % (1,) -> ValueError: incomplete format",
    "\"x\" % [1] -> x",
    "\"x\" % {\"a\": 1} -> x",
    "\"%d%%\" % 5 -> 5%",
    "\"%s\" % \"s\" -> s",
    "\"x\" % \"s\" -> TypeError: not all arguments converted during string formatting",
    "\"%s\" % [1, 2] -> [1, 2]",
    "",
], "percent_format_args")
