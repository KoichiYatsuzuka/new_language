# format_spec.ar — 書式指定の小言語（format() / f-string の {x:spec} / str.format・python_builtins_plan.md のタスク 3-4）
#
# `[[fill]align][sign][z][#][0][width][grouping][.precision][type]` を CPython 3.12 と同じに解釈する。
# 入口は 3 つ（`format(v, spec)` / `f"{v:spec}"` / `"{:spec}".format(v)`）で、解釈は 1 つ（`ops::format_spec`）。
#   - f-string は Python と同じ `{式=}`（自己記述）・`!r` / `!s` / `!a`（変換）・`{x:{w}.{p}f}`（書式の中の置換）
#   - `str.format` は位置・キーワード・属性（`{0.name}`）・添字（`{0[1]}` / `{d[key]}`）・変換・入れ子の書式
#   - クラスは `fn __format__(self, spec: str) -> str` で自分の書式を決められる
# 出力は CPython と同じ（format_spec.py と同じ内容）。
# 対になる誤りの例: format_spec_error.ar（`format` は `str` を返す）
#
# ⚠ 以前は f-string の `:spec` / `!r` / `=` を**黙って捨てていた**（`f"{x:.2f}"` が `3.14159`）。
#   `str.format` の `,` / `#` も捨て、`e` / `g` の綴りが違った（`%e` も `1.234568e4`）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/format_spec.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

class Money:
    mut cents: int
    fn __init__(mut self, let cents: int) -> None:
        self.cents = cents
    fn __format__(self, spec: str) -> str:
        let units = format(self.cents / 100, ",.2f")
        if spec == "":
            return "$" + units
        return format("$" + units, spec)
    fn __repr__(self) -> str:
        return "Money(" + str(self.cents) + ")"

class Point:
    mut x: int
    mut y: int
    fn __init__(mut self, let x: int, let y: int) -> None:
        self.x = x
        self.y = y

# format()
emit([str(format(1234567, ",")), str(format(255, "#010x")), str(format(-42, "+08d")), str(format(65, "c"))])
emit([str(format(3.14159, ".2f")), str(format(12345.678, "e")), str(format(0.000012345, "g")), str(format(0.25, ".1%"))])
emit([str(format("abc", "*^9")), str(format("abcdef", ".3")), str(format(True, "")), str(format(True, ">3"))])
emit([str(format(1234567.891, "_.1f")), str(format(-0.0001, "z.2f")), str(format(1e16, "")), str(format(1.0, ".3"))])

# f-string
let pi = 3.14159
let name = "Arrow"
let n = 1234567
let w = 10
emit([str(f"{pi:.3f}|{name!r}|{name:>8}|{n:,}|{pi=}|{n = :_}|")])
emit([str(f"{pi:{w}.{2}f}|{name!r:^{w}}|{'é'!a}|{[1, 2]!r}|")])

# str.format
let p = Point(3, 4)
let d = {"k": 7}
emit([str("{} + {} = {}".format(1, 2, 3))])
emit([str("{1}-{0}-{1}".format("a", "b"))])
emit([str("{name}: {0:>6.2f}".format(2.5, name="x"))])
emit([str("({0.x}, {0.y}) {1[k]} {2[1]}".format(p, d, [10, 20]))])
emit([str("{0!r} {0!s} {1:{2}}|".format("q", 5, 4))])

# __format__
let m = Money(123456)
emit([str(f"{m}|{m:>14}|"), str("{:<14}|".format(m)), str(format(m))])

# % の e / g は CPython と同じ綴り
emit([str("%e %.2E %g %g" % (12345.678, 0.000123, 0.0001, 123456789.0))])

# 誤りの文言も CPython と同じ
fn show(let v: Any, let spec: str) -> None:
    try:
        emit([str(format(v, spec))])
    except Exception as e:
        emit([str(type(e).__name__ + ": " + str(e))])

show(1, ".2")
show("a", "+")
show(1.5, "d")
show(None, ">5")
show(1, ",x")

# ── 出力を照らす ──
check_output([
    "1,234,567 0x000000ff -0000042 A",
    "3.14 1.234568e+04 1.2345e-05 25.0%",
    "***abc*** abc True   1",
    "1_234_567.9 0.00 1e+16 1.0",
    "3.142|'Arrow'|   Arrow|1,234,567|pi=3.14159|n = 1_234_567|",
    "      3.14| 'Arrow'  |'\\xe9'|[1, 2]|",
    "1 + 2 = 3",
    "b-a-b",
    "x:   2.50",
    "(3, 4) 7 20",
    "'q' q    5|",
    "$1,234.56|     $1,234.56| $1,234.56     | $1,234.56",
    "1.234568e+04 1.23E-04 0.0001 1.23457e+08",
    "ValueError: Precision not allowed in integer format specifier",
    "ValueError: Sign not allowed in string format specifier",
    "ValueError: Unknown format code 'd' for object of type 'float'",
    "TypeError: unsupported format string passed to NoneType.__format__",
    "ValueError: Cannot specify ',' with 'x'.",
    "",
], "format_spec")
