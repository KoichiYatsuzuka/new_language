# percent_format.ar — `%` の書式の `%s` / `%r`（known_bugs.md の #4）
#
# `"..." % 値` の `%s` は `str(値)`、`%r` は `repr(値)`（CPython と同じ）。クラスの `__str__` / `__repr__` を呼び、
# コンテナの中の値は `repr` で並べる（`str([t])` と同じ）。幅・精度（`%5s` / `%-5s` / `%.2r`）も効く。
#
# ⚠ 以前は既定の表示しか使えず、インスタンスが `<Temp object at 0x..>` になり、`%r` は表示を Rust の書式で
#   引用していた（`"%r" % "ab"` が `"ab"`、`"%r" % 5` が `"5"`。CPython は `'ab'` / `5`）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/percent_format.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

class Temp:
    mut deg: int

    fn __str__(self) -> str:
        return f"{self.deg}C"

    fn __repr__(self) -> str:
        return f"Temp({self.deg})"

let t = Temp(21)
emit([str("%s | %r" % (t, t))])
# 21C | Temp(21)
emit([str("%r %r %r" % ("it's", 5, [1, "a"]))])
# "it's" 5 [1, 'a']
emit([str("%s" % [t, Temp(3)])])
# [Temp(21), Temp(3)]
emit([str("[%6s] [%-6s] [%.4r]" % (t, t, t))])
# [   21C] [21C   ] [Temp]

# ── 出力を照らす ──
check_output([
    "21C | Temp(21)",
    "\"it's\" 5 [1, 'a']",
    "[Temp(21), Temp(3)]",
    "[   21C] [21C   ] [Temp]",
    "",
], "percent_format")
