# bytes — 不変のバイト列（python_builtins_plan.md のタスク 3-1）
#
# `bytes(..)` / `"s".encode()` で作る（Arrow のソースに `b".."` のリテラルは無い。Python の bytes は境界で Arrow の
# bytes に写す）。添字は 1 バイトの int、スライス・`+` / `*` は bytes、表示は CPython と同じ `b'..'`。
# 出力は CPython と同じ。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/bytes.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

let data: bytes = "héllo".encode()
emit([str(data), str(len(data)), str(data[0]), str(data[-1]), str(data[1:3])])
emit([str(bytes([65, 66, 67])), str(bytes(3)), str(bytes("abc", "ascii")), str(bytes())])
emit([str(data.decode()), str(data.decode("utf-8")), str("é".encode("latin-1"))])

# 演算子
let ab: bytes = bytes([97, 98])
emit([str(ab + ab), str(ab * 3), str(98 in ab), str(ab in bytes([120, 97, 98])), str(ab < bytes([97, 99])), str(ab == bytes([97, 98]))])

# メソッド
let csv: bytes = "a,b,,c".encode()
emit([str(csv.split(",".encode())), str("x".encode().join([ab, ab])), str("  hi  ".encode().strip())])
emit([str(ab.hex()), str(ab.hex("-")), str(ab.upper()), str(csv.count(",".encode())), str(csv.find(98)), str(csv.replace(",".encode(), ";".encode()))])
emit([str(ab.startswith("a".encode())), str("123".encode().isdigit()), str(data.isascii())])

# 反復は int・辞書のキーにできる・型の判定
mut total = 0
for x in ab:
    total += x
let names: dict[bytes, str] = {ab: "ab"}
emit([str(total), str(list(ab)), str(names[bytes([97, 98])]), str(isinstance(ab, bytes)), str(type(ab).__name__)])

# 表示（引用符の選び方・エスケープは CPython と同じ）
emit([str(bytes([105, 116, 39, 115])), str(bytes([0, 9, 10, 255]))])

# 符号化・復号の誤りは CPython と同じ文言
try:
    let s = bytes([255]).decode()
except UnicodeDecodeError as e:
    emit([str(e)])
try:
    let b = "日本".encode("ascii")
except UnicodeEncodeError as e:
    emit([str(e)])
emit([str(bytes([97, 255, 98]).decode("utf-8", "replace")), str("aé".encode("ascii", "ignore"))])

# ── 出力を照らす ──
check_output([
    "b'h\\xc3\\xa9llo' 6 104 111 b'\\xc3\\xa9'",
    "b'ABC' b'\\x00\\x00\\x00' b'abc' b''",
    "héllo héllo b'\\xe9'",
    "b'abab' b'ababab' True True True True",
    "[b'a', b'b', b'', b'c'] b'abxab' b'hi'",
    "6162 61-62 b'AB' 3 2 b'a;b;;c'",
    "True True False",
    "195 [97, 98] ab True bytes",
    "b\"it's\" b'\\x00\\t\\n\\xff'",
    "'utf-8' codec can't decode byte 0xff in position 0: invalid start byte",
    "'ascii' codec can't encode characters in position 0-1: ordinal not in range(128)",
    "a�b b'a'",
    "",
], "bytes")
