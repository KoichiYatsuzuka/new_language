# traceback_frame_names.ar — トレースバックが関数名を出すこと（#15d）
#
# 例外のトレースバックは、各フレームの呼び先を名前で表示する。
# 以前は「リゾルバが解決していない呼び出し」だけ名前を出し、解決済み（＝関数本体からの
# 呼び出し）はすべて `<anonymous>` になっていた。VM 経路は名前を出していたため、
# 同じプログラムで `--vm=off` と `--vm=auto` の**出力が食い違っていた**。
#
# 期待: どのモードでも最深フレームが `in inner` と表示される。
#       （`compare_vm_modes.ps1` は stdout しか比較しないため、この食い違いは
#         検出されていなかった。トレースバックは stderr に出る。）
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/exceptions/traceback_frame_names.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

fn inner(let n: int) -> float:
    return n / 0

fn middle(let n: int) -> float:
    return inner(n)          # 関数本体からの呼び出し = リゾルバ解決済み

fn outer(let n: int) -> float:
    return middle(n)

try:
    let v = outer(3)
    emit([str("unreachable:"), str(v)])
except ZeroDivisionError as e:
    emit([str("caught:"), str(e)])

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "caught: division by zero",
    "done",
    "",
], "traceback_frame_names")
