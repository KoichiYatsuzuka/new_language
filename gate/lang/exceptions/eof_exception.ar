# eof_error.ar — Arrow のファイルの EOFError / BOFError を捕まえる（python_builtins_plan.md のタスク 4-5）
#
# Arrow の形で開いたファイルの `read()` / `read_line()` / `read_letter()` は終わりで `EOFError: EOF`、
# 逆向き（`backward=True`）で先頭に着くと `BOFError: BOF` を出す。
#   - `EOFError` は CPython と同じ組み込みの例外（`Exception` の子）。`BOFError` は Arrow 独自（`Exception` の子）
#   - `except EOFError` / `except Exception` / 素の `except:` で捕まえられる。`raise EOFError("..")` も書ける
# ⚠ 以前は表に無い名前だったので、`except EOFError` は静的な誤り、`except Exception` も素の `except:` も
#   捕まえず、プログラムが止まった。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/exceptions/eof_error.ar（名前は _error だが正常に終わる例題・README 1 節）。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

let fname = "_tmp_eof_error.txt"
let w = open(fname, FileOpenMode.rewrite)
w.write_line("one")
w.write_line("two")
w.close()

# 終わりまで 1 行ずつ読み、EOFError で抜ける（Arrow の read_line の書き方）
let r = open(fname, FileOpenMode.read)
mut lines: list[str] = []
try:
    while True:
        lines.append(r.read_line().strip())
except EOFError as e:
    emit([str(lines), str("/"), str(type(e).__name__), str(e), str(isinstance(e, Exception))])

# 逆向きに先頭まで読むと BOFError
try:
    while True:
        emit([str("back:"), str(r.read_line(backward=True).strip())])
except BOFError as e:
    emit([str(type(e).__name__), str(e)])
r.close()

# Exception でも捕まる。自分で送出もできる
fn first_char(let path: str) -> str:
    let f = open(path, FileOpenMode.read)
    let c = f.read_letter()
    f.close()
    return c

try:
    let empty = open("_tmp_eof_empty.txt", FileOpenMode.rewrite)
    empty.close()
    emit([str(first_char("_tmp_eof_empty.txt"))])
except Exception as e:
    emit([str("Exception caught:"), str(type(e).__name__)])

try:
    raise EOFError("no more input")
except EOFError as e:
    emit([str(e.args)])

# ── 出力を照らす ──
check_output([
    "['one', 'two'] / EOFError EOF True",
    "back: two",
    "back: one",
    "BOFError BOF",
    "Exception caught: EOFError",
    "('no more input',)",
    "",
], "eof_exception")
