# exception_args.ar — 例外の args と str(e) / repr(e)（python_builtins_plan.md のタスク 4-2）
#
# 対になる誤りの例: exception_args_error.ar
#
# 組み込みの例外は CPython と同じく位置引数をいくつでも受け、それを e.args（組）に持つ:
#   - str(e) / print(e) / e.message: 引数が無ければ ''、1 つならその str、2 つ以上なら args の repr
#     （KeyError だけは 1 つのとき repr。CPython の KeyError_str と同じ）
#   - repr(e): ValueError('bad', 42) の形
# ⚠ 以前は ValueError() も ValueError("a", 1) も TypeError で作れず、print(e) は <ValueError object at 0x..> だった。
# ⚠ 内部で起きた例外（辞書の引き損ないなど）の args は文言 1 つの組（CPython の KeyError ならキーそのもの）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/exceptions/exception_args.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== args ===")])
let a = ValueError()
let b = ValueError("bad value")
let c = ValueError("bad", 42)
let d = ValueError(5)
emit([str(a.args), str(b.args), str(c.args), str(d.args)])                     # () ('bad value',) ('bad', 42) (5,)

emit([str("=== str / repr ===")])
emit([str("[" + str(a) + "]"), str(str(b)), str(str(c)), str(str(d))])         # [] bad value ('bad', 42) 5
emit([str(repr(a)), str(repr(b)), str(repr(c)), str(repr(d))])                 # ValueError() ValueError('bad value') ValueError('bad', 42) ValueError(5)
emit([str(b)])                                                  # bad value
emit([str([b, d])])                                             # [ValueError('bad value'), ValueError(5)]
emit([str(c.message)])                                          # ('bad', 42)

emit([str("=== KeyError ===")])
let k = KeyError("missing")
emit([str(str(k)), str(repr(k))])                                    # 'missing' KeyError('missing')
let dd: dict[str, int] = {"a": 1}
try:
    emit([str(dd["zz"])])
except KeyError as e:
    emit([str(str(e))])                                         # 'zz'

emit([str("=== raise / except ===")])
try:
    raise ValueError("a", 1)
except ValueError as e:
    emit([str(e.args[1]), str(len(e.args))])                         # 1 2
try:
    raise RuntimeError()
except RuntimeError as e:
    emit([str("[" + e.message + "]"), str(e.args)])                  # [] ()

# ── 出力を照らす ──
check_output([
    "=== args ===",
    "() ('bad value',) ('bad', 42) (5,)",
    "=== str / repr ===",
    "[] bad value ('bad', 42) 5",
    "ValueError() ValueError('bad value') ValueError('bad', 42) ValueError(5)",
    "bad value",
    "[ValueError('bad value'), ValueError(5)]",
    "('bad', 42)",
    "=== KeyError ===",
    "'missing' KeyError('missing')",
    "'zz'",
    "=== raise / except ===",
    "1 2",
    "[] ()",
    "",
], "exception_args")
