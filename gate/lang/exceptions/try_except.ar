# try / except / finally — basic and internal-error examples

# ── 1. User-raised exception ──────────────────────────────────────────────────
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/exceptions/try_except.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== user raise ===")])
try:
    raise ValueError("bad input")
except ValueError as e:
    emit([str("caught:"), str(e.message)])

# ── 2. Internal TypeError (type mismatch) ─────────────────────────────────────
#
# ⚠⚠ **タスク 4.4 以降、`"hello" + 42` と直接書くと静的エラーになる**（算術演算の
#    被演算子の可否を静的に検査するようになった）。実行時の `TypeError` を捕まえる例題
#    なので、**静的には型が決まらない経路**から同じ演算に到達させる。
#
# ⚠⚠ **以前は素の `list` の要素（`Unresolved`）から到達させていた**が、
#    タスク 8.1（案 A）で素の容器型注釈が禁止されたので使えない
#    （`list[Any]` は `Any` どうしの演算が静的エラーなので代わりにならない）。
#    ⇒ **値によってしか決まらない失敗**へ移した。`dict[float, str]` のキーに `float` を
#      置くのは静的には正しく、`NaN` だけが実行時に弾かれる
#      （`examples/collections/dict_key_types_error.ar` が規則を持っている）。
emit([str("=== TypeError ===")])
mut result = ""
mut nan_keys: dict[float, str] = {}
try:
    nan_keys[0.0 / 0.0] = "x"
except TypeError as e:
    result = "caught TypeError: " + e.message
emit([str(result)])

# ── 3. Internal IndexError ────────────────────────────────────────────────────
emit([str("=== IndexError ===")])
let lst = [10, 20, 30]
try:
    let y = lst[99]
except IndexError as e:
    emit([str("caught IndexError:"), str(e.message)])

# ── 4. Internal KeyError ──────────────────────────────────────────────────────
emit([str("=== KeyError ===")])
let d = {"a": 1, "b": 2}
try:
    let z = d["missing"]
except KeyError as e:
    emit([str("caught KeyError:"), str(e.message)])

# ── 5. ZeroDivisionError ──────────────────────────────────────────────────────
emit([str("=== ZeroDivisionError ===")])
try:
    let q = 10 / 0
except ZeroDivisionError as e:
    emit([str("caught ZeroDivisionError:"), str(e.message)])

# ── 6. NameError ──────────────────────────────────────────────────────────────
emit([str("=== NameError ===")])
# ⚠ 未定義の名前を読むのは静的エラーになった（フェーズ10 10-12）ので、ここでは明示的に投げる。
try:
    raise NameError("'no_such_variable' is not defined")
except NameError as e:
    emit([str("caught NameError:"), str(e.message)])

# ── 7. Internal error propagating through a function call ────────────────────
emit([str("=== through function ===")])
fn risky_div(a: int, b: int) -> float:
    return a / b

try:
    risky_div(5, 0)
except ZeroDivisionError as e:
    emit([str("caught from function:"), str(e.message)])

# ── 8. Bare except catches any internal error ─────────────────────────────────
emit([str("=== bare except ===")])
try:
    let w = lst[100]
except:
    emit([str("bare except fired")])

# ── 9. finally always runs ────────────────────────────────────────────────────
emit([str("=== finally ===")])
mut fin = "not run"
try:
    let _ = 1 / 0
except ZeroDivisionError:
    emit([str("handler ran")])
finally:
    fin = "ran"
emit([str("finally:"), str(fin)])

# ── 10. Uncaught internal error propagates as a proper traceback ──────────────
emit([str("=== propagation (no handler) — next line raises ===")])
try:
    try:
        let _ = lst[50]
    except ValueError:
        emit([str("wrong handler — should not print")])
except IndexError as e:
    emit([str("outer caught IndexError:"), str(e.message)])

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== user raise ===",
    "caught: bad input",
    "=== TypeError ===",
    "caught TypeError: NaN cannot be used as a dict key",
    "=== IndexError ===",
    "caught IndexError: list index 99 out of range",
    "=== KeyError ===",
    "caught KeyError: 'missing'",
    "=== ZeroDivisionError ===",
    "caught ZeroDivisionError: division by zero",
    "=== NameError ===",
    "caught NameError: 'no_such_variable' is not defined",
    "=== through function ===",
    "caught from function: division by zero",
    "=== bare except ===",
    "bare except fired",
    "=== finally ===",
    "handler ran",
    "finally: ran",
    "=== propagation (no handler) — next line raises ===",
    "outer caught IndexError: list index 50 out of range",
    "done",
    "",
], "try_except")
