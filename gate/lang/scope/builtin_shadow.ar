# builtin_shadow.ar — 組み込み名をユーザー変数でシャドウできること（#15d）
#
# 組み込み（print/next/zip/enumerate/getenv/repr など）と同名の変数を宣言したら、
# **そのスコープでは組み込みではなくユーザーの束縛が呼ばれる**。
#
# 以前はモジュール最上位でこれが壊れていた。呼び先の振り分けが名前だけを見ていて、
# 「リゾルバが解決していない＝シャドウが無い」と誤って仮定していたため。
# リゾルバが処理するのはトップレベル関数の本体だけなので、最上位・テンプレート本体・
# 合成 AST は常に未解決であり、そこでは組み込みが横取りしていた。
#
# 注: 同じ名前を外側と内側の両方で宣言することはできない
#     （'X' is already declared in an accessible scope）。ここでは名前を分けている。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/builtin_shadow.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

fn tagged(let s: str) -> str:
    return "user:" + s

# ── 最上位でのシャドウ（以前壊れていた場所）────────────────────────────────
let repr = tagged
let zip = tagged
let getenv = tagged

emit([str("repr   ->"), str(repr("a"))])
emit([str("zip    ->"), str(zip("b"))])
emit([str("getenv ->"), str(getenv("c"))])

# 最上位の束縛は関数本体からも見える（＝組み込みではなく user 側が呼ばれる）
fn from_fn() -> str:
    return repr("from-fn")

emit([str("nested ->"), str(from_fn())])

# ── 関数本体でのシャドウ（以前から正しく動いていた側）──────────────────────
fn shadow_local() -> str:
    let enumerate = tagged
    return enumerate("in-fn")

emit([str("in-fn  ->"), str(shadow_local())])

# ── シャドウしていない組み込みは組み込みのまま ──────────────────────────────
emit([str("len    ->"), str(len("abcd"))])

# ── 出力を照らす ──
check_output([
    "repr   -> user:a",
    "zip    -> user:b",
    "getenv -> user:c",
    "nested -> user:from-fn",
    "in-fn  -> user:in-fn",
    "len    -> 4",
    "",
], "builtin_shadow")
