# name_resolution.ar — 名前は使う前に宣言されていなくてよい（前方参照）（フェーズ10 10-12）
#
# 対になる誤りの例: name_resolution_error.ar
#
# 型検査は**ここから見えない名前**を静的エラーにする（以前は実行時の NameError まで分からなかった）。
# 見えるのは、スコープにある名前・組み込みの名前（`print` / `range` / `Ok` …）・クラスの名前と、
# **後で実行される本体（関数・`gen`・メソッド）の中から読む、モジュールの最上位の名前**（後で束縛するものも。前方参照）。
# ⚠ 最上位の文そのものは順に実行されるので、後で束縛する名前（関数も）を先に読むのは誤り（name_resolution_error.ar）。
# ⚠ 規則は implementation_plans/name_scope_plan.md の §2（以前は「プログラムのどこかで束縛される名前」を全部通していた）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/name_resolution.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

fn total() -> int:
    # LIMIT と helper はこの関数より後で宣言される
    return LIMIT + helper()

fn helper() -> int:
    return 2

let LIMIT = 40

emit([str(total())])                    # 42

# 組み込みの名前
let r = Ok(1)
emit([str(r.is_OK())])                  # True
for i in range(2):
    emit([str(i)])                      # 0 / 1

# `case _:` の `_` はどれにも当たる腕（名前ではない）
match 3:
    case 1:
        emit([str("one")])
    case _:
        emit([str("other")])            # other

# メソッドの中からも、後で束縛する最上位の名前を読める
class Greeter:
    fn greet(self) -> str:
        return GREETING + NAME

let GREETING = "hello, "
let NAME = "arrow"
emit([str(Greeter().greet())])          # hello, arrow

# ── 出力を照らす ──
check_output([
    "42",
    "True",
    "0",
    "1",
    "other",
    "hello, arrow",
    "",
], "name_resolution")
