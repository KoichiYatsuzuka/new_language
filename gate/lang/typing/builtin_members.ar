# builtin_members.ar — 組み込みの値のメンバー（フェーズ10 10-14）
#
# 対になる誤りの例: builtin_members_error.ar
#
# 組み込みの値（`int` / `float` / `bool` / `str` / `list` / `dict` …）は**読める属性を持たない**。
# メソッドは呼び出しの形でだけ使える（`s.upper()` は書けるが `s.upper` だけを読むことはできない）。
# `int` / `float` / `bool` / `None` はメソッドも持たない。`complex` のメソッドは `real()` / `imag()` /
# `angle()` だけ。
# ⚠ 以前はどれも静的に通り、実行時の AttributeError になっていた。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/builtin_members.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

let s = "Arrow"
emit([str(s.upper())])                  # ARROW
emit([str(s.lower().startswith("ar"))]) # True

mut xs: list[int] = [3, 1]
xs.append(2)
emit([str(len(xs))])                    # 3

let d: dict[str, int] = {"a": 1, "b": 2}
emit([str(len(d.keys()))])              # 2

let z: complex = 3 + 4j
emit([str(z.real()), str(z.imag())])         # 3.0 4.0

# 数値の変換は組み込み関数で行う
let n: int = -5
emit([str(str(n)), str(float(n))])           # -5 -5.0

# ── 出力を照らす ──
check_output([
    "ARROW",
    "True",
    "3",
    "2",
    "3.0 4.0",
    "-5 -5.0",
    "",
], "builtin_members")
