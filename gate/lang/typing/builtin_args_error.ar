# builtin_args_error.ar — 組み込み関数の引数を守る
#
# 正常系は builtin_args.ar
#
# ⚠ 以前は `range` / `len` 以外の組み込みの引数を検査していなかったので、どれも実行時まで通っていた。
#
# 期待されるエラー:
#   StaticTypeError  argument 1 of 'open' expects 'FileOpenMode' but got 'int'
#   StaticTypeError  'open' has no parameter named 'mode'
#   StaticTypeError  argument 0 of 'close' expects 'FileObject' but got 'str'
#   StaticTypeError  'repr' takes 1 argument(s) but 2 were given
# ⚠ 写すときに外した（例題が古い・2026-11-23）: `open(path)`（今は open_mode を省ける）と `print(1, sep=" ")`
#   （print は sep= を受けるようになった・python_builtins_plan.md 5-1）。どちらも今は誤りにならない。
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/typing/builtin_args_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

let a = open("builtin_args_error.ar", 1)                        # ⛔ FileOpenMode ではない   # expect: static CallArgTypeMismatch
let c = open("builtin_args_error.ar", FileOpenMode.read, mode = 1)  # ⛔ そんな名前の引数は無い   # expect: static CallArgTypeMismatch
close("builtin_args_error.ar")                                  # ⛔ FileObject ではない   # expect: static CallArgTypeMismatch
print(repr(1, 2))                   # ⛔ 1 個だけ   # expect: static CallArgCountMismatch
