# template_contexts_error.ar — 入れ子の関数の中の具体化も型検査される（フェーズ10 10-5）
#
# 対になる正常系: template_contexts.ar
#
# Expected error (StaticTypeError):
#   argument 0 of 'Box[int].set' expects 'int' but got 'str'
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/typing/template_contexts_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

class Box[T]:
    mut v: T

    fn set(mut self, let x: T) -> None:
        self.v = x

fn outer() -> None:
    fn inner() -> None:
        mut b = Box[int](1)
        b.set("wrong")   # expect: static CallArgTypeMismatch
    inner()

outer()
