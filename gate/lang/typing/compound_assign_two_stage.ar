# compound_assign_two_stage.ar — `x <op>= v` は**二回**の型検査を経る（決定 D-8・タスク 5.1）
#
# ## 何が壊れていたか
#
# 複合代入は型検査を**一度も通っていなかった**。
#
#   - 変数への `x += v` は `check_binop` を呼んでいなかったので、`x + "s"` が
#     タスク 4.4 で静的エラーになった後も **`x += "s"` だけ実行時まで判らなかった**。
#   - フィールドへの `o.f += v` は「複合代入で格納されるのは `v` ではない」という
#     正しい理由で検査を**丸ごと省いて**いた（0-2）。理由は正しいが、
#     **代わりの検査を置いていなかった**。
#
# ## なぜ右辺を左辺型と直接照合してはいけないか
#
# 格納されるのは `v` ではなく `x <op> v` の**結果**なので、**両方向にずれる**:
#
# | コード | 右辺を直接照合すると | 正しい判定 |
# |---|---|---|
# | `mut t: str = "a"; t *= 3` | ⛔ 誤って弾く（右辺は `int`） | ✅ 通す（`str * int` → `str`） |
# | `__add__` が `str` を返すクラスに `v += V(2)` | ✅ 通してしまう（右辺は `V`） | ⛔ 弾く（結果が `str`） |
#
# ⇒ **検査 1**（Kind 3: `x <op> v` が可能か）→ 結果型 `R` → **検査 2**（`R` → `typeof(x)`）。
#
# 弾かれる例は compound_assign_two_stage_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/compound_assign_two_stage.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 右辺の型が左辺と違っても、結果型が合えば通る ===")])

mut t: str = "a"
t *= 3                          # 右辺は int。`str * int` → `str` なので OK
emit([str(t)])                        # aaa

mut fmt: str = "n=%d"
fmt %= 42                       # `str % 任意` は書式化。結果は `str`
emit([str(fmt)])                      # n=42

emit([str("=== 要素型まで見る ===")])

mut xs: list[int] = [1]
xs += [2, 3]                    # `list[int] + list[int]` → `list[int]`
emit([str(xs)])                       # [1, 2, 3]

emit([str("=== 数値 ===")])

mut f: float = 1.5
f += 1.5
emit([str(f)])                        # 3.0

mut i: int = 7
i //= 2                         # `int // int` → `int`
i <<= 2
emit([str(i)])                        # 12

emit([str("=== クラスは宣言された戻り値型で判定する（D-9） ===")])

# ⚠ 組み込みの表はクラスを見ても何も答えられないので、演算子メソッドの
#   **宣言戻り値型**を引く。`__add__` が `Vec` を返すのでフィールドへ戻せる。
class Vec:
    mut n: int

    fn __add__(self, let other: Vec) -> Vec:
        return Vec(self.n + other.n)

mut v = Vec(1)
v += Vec(2)
emit([str(v.n)])                      # 3

emit([str("=== フィールドへの複合代入 ===")])

class Counter:
    mut hits: int
    mut label: str

mut c = Counter(0, "c")
c.hits += 5
c.label += "!"
emit([str(c.hits), str(c.label)])          # 5 c!

emit([str("=== trait のフィールドも同じ経路を通る ===")])

trait Scored:
    mut score: int

class Player(Scored):
    mut name: str

mut p = Player(10, "ann")
p.score += 5
emit([str(p.score)])                  # 15

# ⚠ trait 名で修飾した形も同じ二段検査を通る。
#   （タスク 5.1 の時点では `p::Scored.score += 5` が **VmForceError** でバイトコードに
#   載らなかったため触れられなかった。タスク 9.1 で VM コンパイラに
#   `Expr::TraitAccess` のアームを足して直した。）
p::Scored.score += 5
emit([str(p::Scored.score)])          # 20

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== 右辺の型が左辺と違っても、結果型が合えば通る ===",
    "aaa",
    "n=42",
    "=== 要素型まで見る ===",
    "[1, 2, 3]",
    "=== 数値 ===",
    "3.0",
    "12",
    "=== クラスは宣言された戻り値型で判定する（D-9） ===",
    "3",
    "=== フィールドへの複合代入 ===",
    "5 c!",
    "=== trait のフィールドも同じ経路を通る ===",
    "15",
    "20",
    "done",
    "",
], "compound_assign_two_stage")
