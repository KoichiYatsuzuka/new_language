# and_or_result_type.ar — `and` / `or` の結果型は被演算子型の join（タスク 2.5 / 決定 D-10）
#
# ## 何が壊れていたか
#
# 型検査は `and` / `or` の結果を**無条件 `Bool`** と宣言していた（`infer_binop_result`）。
# ところが実行時は **被演算子をそのまま返す**（Python 流で `a and b` は a か b を返す）。
# そのため静的には `Bool` と言いながら実行時には非 bool が入る **嘘**になっていた:
#
#   let a: int = 1
#   let b: int = 2
#   let r: bool = a and b    # 静的に通っていた
#   print(r)                 # 2   ← bool 変数に int が入る
#
# `__cast__` に続く 2 件目の「**型検査が嘘をつく**」箇所だった。
#
# ⚠ **実行時の意味論は変えていない。** 結果型を正直にしただけ（案 (a)）。
#   `x = a or default` という定番が書けなくなる案 (b) は採らなかった。
#
# ⚠⚠ これは **`if` / `while` の条件を `bool` 厳密にする決定（D-12）の前提**。
#   結果型が `Bool` のままだと、条件を厳密にしても `if a and b:`（非 bool）が静的に通ってしまう。
#
# 弾かれる例は and_or_result_type_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/and_or_result_type.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 同じ型同士はその型になる ===")])

let a: int = 1
let b: int = 2
let n: int = a and b
emit([str(n)])                            # 2   ← a が真なので b を返す

let s1: str = "x"
let s2: str = "y"
let s: str = s1 or s2
emit([str(s)])                            # x   ← s1 が真なので s1 を返す

emit([str("=== bool 同士なら bool ===")])

let p: bool = True
let q: bool = False
let r: bool = p and q
emit([str(r)])                            # False

emit([str("=== 短絡評価は従来どおり ===")])

let zero: int = 0
emit([str(zero or 9)])                    # 9   ← zero は偽なので右辺
emit([str(zero and 9)])                   # 0   ← zero は偽なのでそのまま返す

emit([str("=== 比較演算子の結果は bool のまま ===")])

let cmp: bool = (a > 0) and (b > 0)
emit([str(cmp)])                          # True

emit([str("=== 既定値のイディオムも書ける ===")])

fn pick(let v: int) -> int:
    let fallback: int = 42
    return v or fallback

emit([str(pick(7))])                      # 7
emit([str(pick(0))])                      # 42

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== 同じ型同士はその型になる ===",
    "2",
    "x",
    "=== bool 同士なら bool ===",
    "False",
    "=== 短絡評価は従来どおり ===",
    "9",
    "0",
    "=== 比較演算子の結果は bool のまま ===",
    "True",
    "=== 既定値のイディオムも書ける ===",
    "7",
    "42",
    "done",
    "",
], "and_or_result_type")
