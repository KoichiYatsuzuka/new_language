# ptr_type_error.ar — Ptr[T] の型の誤り（負例・ffi_value_exchange_plan.md 3-3）
#
# - 要素は C の幅つきの型（Arrow の `int` は幅を持たないので `int32` / `int64` と書く）・構造体・void
# - 要素型を書かない `Ptr` は注釈に書けない（型テストの `x is Ptr` は書ける）
# - `Ptr[void]` を `Ptr[T]` へ黙っては渡せない（`p mustbe Ptr[T]` で変換する）。幅が違えば別の型
# - 要素型の分かっている Ptr どうしの `mustbe` は成功しえない
# 対になる正例: ptr_types.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/typing/ptr_type_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

fn takes_ints(let p: Ptr[int32]) -> None:
    return

fn wrong_elem(let p: Ptr[int]) -> None:   # expect: static PtrElemNotCType
    return

fn bare(let p: Ptr) -> None:   # expect: static BareContainerAnnotation
    return

fn from_void(let p: Ptr[void]) -> None:
    takes_ints(p)   # expect: static CallArgTypeMismatch

fn other_width(let p: Ptr[int64]) -> None:
    takes_ints(p)   # expect: static CallArgTypeMismatch
    let q = p mustbe Ptr[float64]   # expect: static MustBeCanNeverSucceed
