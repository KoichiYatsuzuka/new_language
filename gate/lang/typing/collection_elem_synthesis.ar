# collection_elem_synthesis.ar — コレクションの要素型を「捨てる」から「合成する」へ（タスク 2.7）
#
# ## 何が壊れていたか — 根本原因②
#
# 要素型の推論は「**全要素が同型でなければ素の `list` に落とす**」実装だった:
#
#   if 全部同じ型 { ListOf(その型) } else { List }   // ← 要素型を捨てる
#
# ところが素の `list` は `is_list_like` 規則で `list[任意]` と**適合する**。つまり
# **捨てることが「何でも通す」になっていた**。実測:
#
#   let xs: list[int]   = [1, "s"]   # 通っていた
#   let xs: list[str]   = [1, "s"]   # 通っていた
#   let xs: list[float] = [1, "s"]   # 通っていた
#   let d: dict[str, int] = {"a": 1, "b": "s"}   # 通っていた
#
# ⚠ 要素が 1 つでも `Unresolved` だと全体が崩れるのも同じ原因だった。
#
# ⇒ 混在は **`Union` へ合成する**。`[1, "s"]` は `list[Union[int, str]]` になり、
#   `list[int]` とは適合しない。
#
# ⚠ `Unresolved` になる場合も `list[Unresolved]` という**構造を保つ**形にした。
#   素の `list` と違い、タスク 4.1 で素の容器の双方向特例を撤去しても壊れない。
#
# 弾かれる例は collection_elem_synthesis_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/collection_elem_synthesis.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 同型のリテラルは従来どおり ===")])

let ints: list[int] = [1, 2, 3]
let strs: list[str] = ["a", "b"]
emit([str(ints), str(strs)])                   # [1, 2, 3] ['a', 'b']

emit([str("=== 混在は Union へ合成される ===")])

# ⚠ 明示的に Union を書けば通る（合成結果と一致する）。
let mixed: list[Union[int, str]] = [1, "s", 2]
emit([str(mixed)])                        # [1, 's', 2]

emit([str("=== list[Any] は要素型を問わない ===")])

# ⚠ タスク 8.1（案 A）で素の `list` 注釈は書けなくなった。要素型を問わないことは
#   `Any` と**明示**して書く。
let loose: list[Any] = [1, "s", 2.0]
emit([str(loose)])                        # [1, 's', 2.0]

emit([str("=== set / dict も同じ規則 ===")])

let si: set[int] = {1, 2}
emit([str(len(si))])                      # 2

let di: dict[str, int] = {"a": 1, "b": 2}
emit([str(di["a"]), str(di["b"])])             # 1 2

let dm: dict[str, Union[int, str]] = {"a": 1, "b": "s"}
emit([str(dm["a"]), str(dm["b"])])             # 1 s

emit([str("=== 入れ子も合成される ===")])

let nested: list[list[int]] = [[1, 2], [3]]
emit([str(nested)])                       # [[1, 2], [3]]

emit([str("=== tuple は位置ごとに持つので元から崩れない ===")])

let t: tuple[int, str] = (1, "a")
emit([str(t)])                            # (1, 'a')

emit([str("=== 空リテラルは当面そのまま（D-11 の ⊥ はタスク 4.1） ===")])

mut empty: list[int] = []
empty.append(1)
emit([str(empty)])                        # [1]

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== 同型のリテラルは従来どおり ===",
    "[1, 2, 3] ['a', 'b']",
    "=== 混在は Union へ合成される ===",
    "[1, 's', 2]",
    "=== list[Any] は要素型を問わない ===",
    "[1, 's', 2.0]",
    "=== set / dict も同じ規則 ===",
    "2",
    "1 2",
    "1 s",
    "=== 入れ子も合成される ===",
    "[[1, 2], [3]]",
    "=== tuple は位置ごとに持つので元から崩れない ===",
    "(1, 'a')",
    "=== 空リテラルは当面そのまま（D-11 の ⊥ はタスク 4.1） ===",
    "[1]",
    "done",
    "",
], "collection_elem_synthesis")
