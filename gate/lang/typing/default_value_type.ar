# default_value_type.ar — 既定値の型が宣言型と照合されること（0-12）
#
# ⚠⚠ **仮引数の既定値は推論すらされていなかった。** `check_fn_def` は注釈の有無しか見ず
#   `param.default` に触れず、`declare_param` も無視していたため
#   `fn f(let n: int = "wrong")` が静的にも実行時にも通っていた。
#   クラスの `const` / `static mut` の既定値は `infer` はされていたが**結果を捨てていた**
#   （0-2 のフィールド書き込みと同じ形の漏れ）。
#
# 誤った既定値は default_value_type_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/default_value_type.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 仮引数の既定値 ===")])

fn f(let a: int = 1, let b: str = "s", let c: bool = True) -> None:
    emit([str(a), str(b), str(c)])

f()                     # 1 s True
f(9, "x", False)        # 9 x False

fn with_list(let xs: list[int] = [1, 2]) -> int:
    return xs[0]

emit([str(with_list())])      # 1

emit([str("=== int → float の拡大は既定値でも効く ===")])

fn widen(let n: float = float(3)) -> float:
    return n

emit([str(widen())])          # 3.0 — 既定値も昇格する

emit([str("=== メソッド・コンストラクタ ===")])

class C:
    mut x: int

    fn m(self, let n: int = 5) -> int:
        return n

emit([str(C(1).m())])         # 5

class D:
    mut x: int

    fn __init__(mut self, let n: int = 7) -> None:
        self.x = n

emit([str(D().x)])            # 7

emit([str("=== const / static mut の既定値 ===")])

class E:
    mut x: int
    const K: int = 7
    const F: float = float(3)          # 拡大して昇格する
    static mut S: int = 0

emit([str(E(1).K), str(E(1).F), str(E.S)])      # 7 3.0 0

emit([str("=== テンプレート関数 ===")])

fn tmpl[T](let a: T, let n: int = 3) -> int:
    return n

emit([str(tmpl[int](1))])     # 3

emit([str("=== protocol 型の既定値（適合検査を通る） ===")])

protocol Drawable:
    mut size: int

    fn draw(self) -> str:
        ...

class Circle:
    mut size: int

    fn draw(self) -> str:
        return "circle"

fn render(let d: Drawable = Circle(1)) -> str:
    return d.draw()

emit([str(render())])         # circle

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== 仮引数の既定値 ===",
    "1 s True",
    "9 x False",
    "1",
    "=== int → float の拡大は既定値でも効く ===",
    "3.0",
    "=== メソッド・コンストラクタ ===",
    "5",
    "7",
    "=== const / static mut の既定値 ===",
    "7 3.0 0",
    "=== テンプレート関数 ===",
    "3",
    "=== protocol 型の既定値（適合検査を通る） ===",
    "circle",
    "done",
    "",
], "default_value_type")
