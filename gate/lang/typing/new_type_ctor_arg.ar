# new_type_ctor_arg.ar — `new_type` のコンストラクタ引数を基底型と照合する（タスク 5.6）
#
# ## 何が壊れていたか
#
# `new_type Meters: float` に `Meters("s")` が**黙って通っていた**（実測）。
# `new_type` は `known_class_names` と `new_type_originals` にしか登録されず、
# `__init__` のシグネチャを持たないので、引数の照合先が**そもそも無かった**。
# 実行時が見ているのは**個数だけ**（`function takes 1 argument(s), got 2`）。
#
# ## ⚠⚠ 基底が**クラス**のときは検査しない
#
# `new_type Kilometers: Meters` の `Meters` が**クラス**のとき、`Kilometers(5)` の `5` は
# 「`Meters` を包む値」ではなく **`Meters` のコンストラクタ引数**
# （レジストリが `class_method_sigs` を引き継いでいる）。
# 基底型と突き合わせると `expects 'Meters' but got 'int'` という**偽エラー**になる。
# ⇒ `new_type` の連鎖を根まで辿り、**根がプリミティブのときだけ**検査する。
#
# 弾かれる例は new_type_ctor_arg_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/new_type_ctor_arg.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== プリミティブを基底にする new_type ===")])

new_type Meters: float
new_type Count: int
new_type Label: str

let m = Meters(5.0)
let c = Count(3)
let l = Label("x")
emit([str(repr(m)), str(repr(c)), str(repr(l))])    # Meters(5.0) Count(3) Label('x')

emit([str("=== 連鎖は根まで辿る ===")])

# `Kg` の根は `float` なので `float` を要求する。
new_type Kg: Meters
let k = Kg(2.5)
emit([str(repr(k))])                      # Kg(2.5)

emit([str("=== ⚠ 暗黙の int → float は無い（D-5・タスク 4.2） ===")])

# `Meters(5)` は弾かれる。明示変換を書く。
let m2 = Meters(float(5))
emit([str(repr(m2))])                     # Meters(5.0)

emit([str("=== 基底がクラスなら、そのクラスのコンストラクタ引数 ===")])

class Vec:
    mut value: int

    fn get(self) -> int:
        return self.value

new_type Kilometers: Vec

# ⚠ `5` は `Vec` ではなく `Vec.__init__` の引数。ここを基底型（`Vec`）と
#   突き合わせると偽エラーになるので、検査を見送っている。
let km = Kilometers(5)
emit([str(km.get())])                     # 5

emit([str("=== キャスト経由 ===")])

let m3 = 7.0=>Meters
emit([str(repr(m3))])                     # Meters(7.0)

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== プリミティブを基底にする new_type ===",
    "Meters(5.0) Count(3) Label('x')",
    "=== 連鎖は根まで辿る ===",
    "Kg(2.5)",
    "=== ⚠ 暗黙の int → float は無い（D-5・タスク 4.2） ===",
    "Meters(5.0)",
    "=== 基底がクラスなら、そのクラスのコンストラクタ引数 ===",
    "5",
    "=== キャスト経由 ===",
    "Meters(7.0)",
    "done",
    "",
], "new_type_ctor_arg")
