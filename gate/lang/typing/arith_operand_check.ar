# arith_operand_check.ar — 算術・ビット演算の被演算子を静的に検査する（タスク 4.4 / Kind 3 / D-9）
#
# ## 何が壊れていたか
#
# `check_binop` は**順序比較（`<` `>` `<=` `>=`）だけ**を検査していた。そのため
# `1 + "s"` のような**最も頻出の型エラー**が静的に出ず、実行時の
# `unsupported operand types` まで判らなかった。
#
# ## 実装 — 可否と結果型を 1 つの表で決める（D-9）
#
# 判定は `infer_binop_result` が `Unresolved` を返すかどうかで行う。**2 つの表を持つと
# ずれる**ので 1 本に寄せた。
#
# ⚠⚠ **そのため表の取りこぼしは偽陽性に直結する。** 実行時の挙動を 1 つずつ実測して
# 表を作り直した。以前は:
#   - `Add` が list / tuple の連結を知らなかった（`[1] + [2]` が Unresolved）
#   - `Mul` が `str * int` / `list * int` を知らなかった
#   - `Mod` が `str % 任意`（書式化）を知らなかった
#   - `Div` が**無条件 `Float`**（`"a" / 2` を見逃す）
#   - ビット演算が**無条件 `Int`**（`1.5 & 2` / `"a" & 1` を見逃す）
#
# ⚠ set 同士の演算は専用分岐で処理する。タスク 2.7 で set リテラルが `SetOf(T)` に
#   なったため、素の `Set` だけを見ていた分岐が取りこぼして**偽エラー**になった
#   （`collections/collection.ar` が落ちて気づいた）。
#
# ⚠ **クラスは素通し。** `__add__` 等のダンダーメソッドで演算を定義できるので可否を
#   決められない（`ordered_comparable` が `NamedInstance` を常に許すのと同じ方針）。
#
# 弾かれる例は arith_operand_check_error.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/arith_operand_check.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 数値の演算 ===")])
emit([str(1 + 2), str(1.5 * 2), str(2 ** 3), str(7 // 2), str(7 % 2), str(1 / 2)])     # 3 3.0 8 3 1 0.5

emit([str("=== 文字列 ===")])
emit([str("a" + "b")])                    # ab
emit([str("ab" * 2)])                     # abab
emit([str(2 * "ab")])                     # abab
emit([str("a%d" % 2)])                    # a2     書式化（右辺の型は問わない）

emit([str("=== list / tuple の連結と繰り返し ===")])
emit([str([1] + [2])])                    # [1, 2]
emit([str([1] * 2)])                      # [1, 1]
emit([str((1,) + (2,))])                  # (1, 2)
emit([str((1,) * 2)])                     # (1, 1)

emit([str("=== set 演算（要素型を保つ） ===")])
let x: set[int] = {1, 2, 3}
let y: set[int] = {2, 3, 4}
emit([str(len(x | y)), str(len(x & y)), str(len(x - y)), str(len(x ^ y))])    # 4 2 1 2

emit([str("=== ビット演算は int 同士 ===")])
emit([str(1 & 2), str(1 | 2), str(1 ^ 2), str(1 << 2), str(8 >> 2)])              # 0 3 3 4 2

emit([str("=== クラスはダンダーメソッドで定義できるので素通し ===")])

class Vec:
    mut n: int

    fn __add__(self, let other: Vec) -> Vec:
        return Vec(self.n + other.n)

let v = Vec(1) + Vec(2)
emit([str(v.n)])                          # 3

emit([str("=== 異型の等値比較は静的エラー（タスク 7.6 で仕様変更） ===")])

# ⚠⚠ **この節は仕様変更で中身が入れ替わった。** タスク 4.4 の時点では
#   「`==` / `!=` / `in` の異型比較はエラーではなく `False`（仕様）」と書いていたが、
#   タスク 7.6 で**静的エラーにする**ことに決めた（決定 D-15）。
#   実測すると、その「仕様」を主張していたのは例題 1 ファイルだけで、
#   移行は全比較地点 237 のうち 10 箇所（4.2%）だった。
#
# ⚠ 実行時の答え（`False`）は変わっていない。型が決まらない経路から到達すれば
#   従来どおり `False` が返る（下記）。実行時の規則は
#   `examples/basics/equality_numeric_promotion.ar` が固定している。

# ⚠⚠ **実行時の答えは例題では確かめられなくなった**（タスク 8.1・案 A）。
#   型が決まらない値を作るには素の `list` 注釈で要素型を隠すしかなかったが、
#   その注釈が書けなくなったため。`list[Any]` は代わりにならない
#   （`Any` の要素へ `==` を掛けた時点で静的エラーになる＝黙って通らない）。
#
#   ⇒ **実行時規則は単体テストへ移した**:
#     `src/interpreter/ops/equality.rs` の `mod eq_expr_rules`
#     （異型は False / 数値族は昇格 / bool は対象外 / コンテナの中へは再帰しない）。

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "=== 数値の演算 ===",
    "3 3.0 8 3 1 0.5",
    "=== 文字列 ===",
    "ab",
    "abab",
    "abab",
    "a2",
    "=== list / tuple の連結と繰り返し ===",
    "[1, 2]",
    "[1, 1]",
    "(1, 2)",
    "(1, 1)",
    "=== set 演算（要素型を保つ） ===",
    "4 2 1 2",
    "=== ビット演算は int 同士 ===",
    "0 3 3 4 2",
    "=== クラスはダンダーメソッドで定義できるので素通し ===",
    "3",
    "=== 異型の等値比較は静的エラー（タスク 7.6 で仕様変更） ===",
    "done",
    "",
], "arith_operand_check")
