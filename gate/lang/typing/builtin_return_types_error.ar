# builtin_return_types_error.ar — 組み込み関数の戻り値の型を守る
#
# 正常系は builtin_return_types.ar
#
# ⚠ 以前は組み込みの結果が `Unresolved`（万能受容体）だったので、どれも黙って通っていた。
#
# 期待されるエラー:
#   StaticTypeError  'n' is declared 'int' but initialized with 'FileObject'
#   StaticTypeError  'r' is declared 'int' but initialized with 'str'
#   StaticTypeError  'e' is declared 'int' but initialized with 'str'
#   StaticTypeError  'FileOpenMode' has no member 'bogus'
#   StaticTypeError  'FileObject' has no member 'nope'
#   StaticTypeError  argument 0 of 'FileObject.write' expects 'Union[str, bytes]' but got 'int'
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/typing/builtin_return_types_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

let n: int = open("builtin_return_types_error.ar", FileOpenMode.read)   # ⛔ FileObject   # expect: static VarTypeMismatch
let r: int = repr(1)                # ⛔ str   # expect: static VarTypeMismatch
let e: int = getenv("HOME")         # ⛔ str   # expect: static VarTypeMismatch

print(FileOpenMode.bogus)           # ⛔ 無い要素   # expect: static NoSuchMember
let g = open("builtin_return_types_error.ar", FileOpenMode.read)
g.nope()                            # ⛔ 無いメソッド   # expect: static NoSuchMember
g.write(1)                          # ⛔ str か bytes   # expect: static CallArgTypeMismatch
