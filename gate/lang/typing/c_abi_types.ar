# c_abi_types.ar — C ABI 準拠型注釈（int32 / float64 など）の動作例
#
# C ABI 型は storage 型: クラスフィールドの格納幅・外部言語境界での変換幅を
# 規定する注釈で、Arrow 内部の実行時値は従来どおり int(i64) / float(f64) のまま。
# 詳細: .claude/skills/c-abi-interop/SKILL.md

# ── 変数・パラメータ注釈として使用可能（基底型 int/float として検査される） ──
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/c_abi_types.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

let a: int32 = 100
let b: int64 = 9_000_000_000
let c: float32 = 1.5
let d: float64 = 3.141592653589793
mut e: uint8 = 255

emit([str(a + 1)])        # 101   — 実行時値は通常の int
emit([str(b)])            # 9000000000
emit([str(c * 2.0)])      # 3.0   — 実行時値は通常の float
emit([str(d)])
e = 128
emit([str(e)])

# ── 関数シグネチャでも使用可能 ────────────────────────────────────────────────
fn scale(let v: int32, let factor: float64) -> float64:
    return float(v) * factor

emit([str(scale(10, 1.5))])    # 15.0

# ── クラスフィールド注釈（C 構造体対応レイアウトの記述） ──────────────────────
# フィールドは宣言順に配置される（C ABI 準拠）
class CPoint:
    mut x: int32
    mut y: int32
    mut weight: float64

    fn __init__(mut self, let x: int32, let y: int32, let w: float64) -> None:
        self.x = x
        self.y = y
        self.weight = w

let p = CPoint(3, 4, 2.5)
emit([str(p.x + p.y)])         # 7
emit([str(p.weight)])          # 2.5
emit([str("done")])

# ── 出力を照らす ──
check_output([
    "101",
    "9000000000",
    "3.0",
    "3.141592653589793",
    "128",
    "15.0",
    "7",
    "2.5",
    "done",
    "",
], "c_abi_types")
