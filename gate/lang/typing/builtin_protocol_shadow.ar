# builtin_protocol_shadow.ar — 組み込みの protocol と同じ名前の型を宣言したら、そちらが勝つ（pandas_import_plan.md の 6-7）
#
# `Sized` / `Container` などは組み込みの protocol だが、利用者が同じ名前のクラス・trait・enum・protocol を宣言したら、その名前は
# 利用者の宣言を指す（組み込みの enum・組み込み関数と同じ規則）。注釈・型テスト（`x is Sized`）・型の値のどれも同じ。
#
# 期待される出力:
#   3
#   True False
#   True
#   ok

# 組み込みの `Sized`（`__len__` を要求する protocol）ではなく、このクラス
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/typing/builtin_protocol_shadow.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

class Sized:
    mut width: int

    fn __init__(mut self, let width: int) -> None:
        self.width = width

let s: Sized = Sized(3)
emit([str(s.width)])
# `[1]` は `__len__` を持つが、`Sized` はここではクラスなので偽
emit([str(s is Sized), str([1] is Sized)])

# ほかの組み込みの protocol はそのまま使える
emit([str([1] is Iterable)])
emit([str("ok")])

# ── 出力を照らす ──
check_output([
    "3",
    "True False",
    "True",
    "ok",
    "",
], "builtin_protocol_shadow")
