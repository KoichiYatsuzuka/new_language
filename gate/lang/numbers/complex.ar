# complex type demo（表示は CPython の repr と同じ・python_builtins_plan.md のタスク 1-5）

# Imaginary literals
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/complex.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

let z1: complex = 3j
let z2: complex = -2j
let z3: complex = 0.5j

emit([str(z1)])    # 3j（実部が +0 なら虚部だけ・CPython と同じ）
emit([str(z2)])    # (-0-2j)（`-2j` の実部は -0.0・CPython と同じ）

# Arithmetic: int/float + imaginary builds a complex
let a: complex = 1 + 2j
let b: complex = 3 + 4j
emit([str(a)])     # (1+2j)
emit([str(b)])     # (3+4j)

# complex arithmetic
let c_add: complex = a + b
let c_sub: complex = b - a
let c_mul: complex = a * b
let c_div: complex = b / a
emit([str(c_add)])  # (4+6j)
emit([str(c_sub)])  # (2+2j)
emit([str(c_mul)])  # (-5+10j)  (1+2j)(3+4j) = 3+4j+6j+8j^2 = -5+10j
emit([str(c_div)])  # (2.2-0.4j)  (3+4j)/(1+2j) = (11-2j)/5

# mixed scalar arithmetic
let d: complex = 2.0 + 3j
let e: complex = d + 1
let f: complex = d * 2.0
emit([str(e)])   # (3+3j)
emit([str(f)])   # (4+6j)

# unary negation
let neg: complex = -(1 + 1j)
emit([str(neg)])  # (-1-1j)

# complex() constructor
let from_re: complex = complex(5)
let from_re_im: complex = complex(3, 4)
let from_cplx: complex = complex(a)
emit([str(from_re)])     # (5+0j)
emit([str(from_re_im)])  # (3+4j)
emit([str(from_cplx)])   # (1+2j)

# member methods
let v: complex = 3 + 4j
emit([str(v.real())])   # 3.0
emit([str(v.imag())])   # 4.0
emit([str(v.angle())])  # ~0.9272952… (atan2(4,3))

# equality
let p: complex = 1 + 2j
let q: complex = 1 + 2j
let r: complex = 1 + 3j
emit([str(p == q)])  # True
emit([str(p == r)])  # False

# is-type check
let x: complex = 2j
if x is complex:
    emit([str("x is complex")])  # x is complex

# ── 出力を照らす ──
check_output([
    "3j",
    "(-0-2j)",
    "(1+2j)",
    "(3+4j)",
    "(4+6j)",
    "(2+2j)",
    "(-5+10j)",
    "(2.2-0.4j)",
    "(3+3j)",
    "(4+6j)",
    "(-1-1j)",
    "(5+0j)",
    "(3+4j)",
    "(1+2j)",
    "3.0",
    "4.0",
    "0.9272952180016122",
    "True",
    "False",
    "x is complex",
    "",
], "complex")
