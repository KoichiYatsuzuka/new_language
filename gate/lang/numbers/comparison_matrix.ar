# comparison_matrix.ar — 順序比較 `<` `>` `<=` `>=` の網羅チェック（タスク #18）
#
# 型検査の `ordered_comparable` は 4 演算子すべてについて
# `(int,int)` / `(float,float)` / `(int,float)` / `(float,int)` / `(str,str)` を許可している。
# しかし実行時 `apply_binop` は `<` `>` の混在と int/float 同士しか実装しておらず、
# **検査は通るのに実行時 TypeError** になる組み合わせがあった:
#   - `i <= f` / `i >= f`（int/float 混在）
#   - `"a" < "b"` など str 同士のすべて
#
# #18 で実行時を検査器の許可リストに合わせた。この例題は 5 つの型組み合わせ × 4 演算子を
# 全部通し、`--vm=off` と `--vm=auto` で同じ結果になることを確認する。
# 各ブロックの 3 行目（等しい値）はどれも `False False True True` になるはず。
#
# 検証: .\compare_vm_modes.ps1 -Filter comparison_matrix
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/comparison_matrix.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

fn ii(let a: int, let b: int) -> None:
    emit([str(a < b), str(a > b), str(a <= b), str(a >= b)])

fn ff(let a: float, let b: float) -> None:
    emit([str(a < b), str(a > b), str(a <= b), str(a >= b)])

fn ifm(let a: int, let b: float) -> None:
    emit([str(a < b), str(a > b), str(a <= b), str(a >= b)])

fn fim(let a: float, let b: int) -> None:
    emit([str(a < b), str(a > b), str(a <= b), str(a >= b)])

fn ss(let a: str, let b: str) -> None:
    emit([str(a < b), str(a > b), str(a <= b), str(a >= b)])

emit([str("=== int/int ===")])
ii(1, 2)
ii(2, 1)
ii(2, 2)

emit([str("=== float/float ===")])
ff(1.5, 2.5)
ff(2.5, 1.5)
ff(2.5, 2.5)

emit([str("=== int/float ===")])
ifm(2, 2.5)
ifm(3, 2.5)
ifm(2, 2.0)

emit([str("=== float/int ===")])
fim(2.5, 3)
fim(2.5, 2)
fim(2.0, 2)

emit([str("=== str/str ===")])
ss("a", "b")
ss("b", "a")
ss("a", "a")
ss("abc", "abd")
ss("Z", "a")

# ── 出力を照らす ──
check_output([
    "=== int/int ===",
    "True False True False",
    "False True False True",
    "False False True True",
    "=== float/float ===",
    "True False True False",
    "False True False True",
    "False False True True",
    "=== int/float ===",
    "True False True False",
    "False True False True",
    "False False True True",
    "=== float/int ===",
    "True False True False",
    "False True False True",
    "False False True True",
    "=== str/str ===",
    "True False True False",
    "False True False True",
    "False False True True",
    "True False True False",
    "True False True False",
    "",
], "comparison_matrix")
