# float_floor_div_mod.ar — float の `//` と `%`（python_builtins_plan.md のタスク 1-2）
#
# 対になる誤りの例: float_floor_div_mod_error.ar（ゼロ除算）
#
# CPython 3.12 の `_float_div_mod` と同じ手順で計算する:
#   - 余りは fmod で出し、符号を**割る数**に合わせる（`7.5 % -2.0` は -0.5）
#   - 余りが 0 なら割る数の符号つきの 0（`6.0 % -3.0` は -0.0）
#   - 商は負の無限大の方向へ丸める（`-7.5 // 2.0` は -4.0）
#   - int と float が混ざれば float（`-7 // 2.0` は -4.0）
# ⚠ 以前は float の `//` / `%` が静的にも実行時にも誤り（`unsupported operand types`）だった。
# ⚠ `a - floor(a/b)*b` で計算すると `a/b` の丸めを拾って端でずれる（`0.1 % 0.01` が 0.0）。下の ② が確かめる。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/float_floor_div_mod.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 1. signs ===")])
emit([str(7.5 // 2.0), str(7.5 % 2.0)])        # 3.0 1.5
emit([str(-7.5 // 2.0), str(-7.5 % 2.0)])      # -4.0 0.5
emit([str(7.5 // -2.0), str(7.5 % -2.0)])      # -4.0 -0.5
emit([str(-7.5 // -2.0), str(-7.5 % -2.0)])    # 3.0 -1.5

emit([str("=== 2. edge values ===")])
emit([str(0.1 // 0.01), str(0.1 % 0.01 > 0.0)])  # 10.0 True（余りは 3.469446951953614e-18。0.0 ではない）
emit([str(6.0 % -3.0)])                   # -0.0
emit([str(-0.0 // 1.0)])                  # -0.0

emit([str("=== 3. int and float mixed ===")])
emit([str(-7 // 2.0), str(7 % -2.5)])          # -4.0 -0.5
emit([str(7.5 // 2), str(-7.5 % 2)])           # 3.0 0.5

emit([str("=== 4. inside a function and augmented assignment ===")])
fn split(a: float, b: float) -> str:
    mut q = a
    mut r = a
    q //= b
    r %= b
    return str(q) + " " + str(r)

emit([str(split(-7.5, 2.0))])             # -4.0 0.5
emit([str(split(1.25, -0.5))])            # -3.0 -0.25

emit([str("=== 5. division by zero ===")])
try:
    emit([str(1.0 // 0.0)])
except ZeroDivisionError as e:
    emit([str("caught")])                 # caught

# ── 出力を照らす ──
check_output([
    "=== 1. signs ===",
    "3.0 1.5",
    "-4.0 0.5",
    "-4.0 -0.5",
    "3.0 -1.5",
    "=== 2. edge values ===",
    "10.0 True",
    "-0.0",
    "-0.0",
    "=== 3. int and float mixed ===",
    "-4.0 -0.5",
    "3.0 0.5",
    "=== 4. inside a function and augmented assignment ===",
    "-4.0 0.5",
    "-3.0 -0.25",
    "=== 5. division by zero ===",
    "caught",
    "",
], "float_floor_div_mod")
