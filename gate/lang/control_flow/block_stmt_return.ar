# block_stmt_return.ar — 関数の中の block: 文から return で抜ける（python_builtins_plan.md のタスク 5-3）
#
# block: 文の中の return は、普通の文と同じく関数から抜ける（囲む try の finally も走る）。
# ⚠ 以前は関数の中の block: に return があるだけで関数ごと VmForceError（バイトコードにできない）だった。
#   Python の with open(p) as f: return f.read() も、変換先が block: なので同じ理由で読めなかった。
# ⚠ ブロック式（let x = block -> int: ..）の中の return は今も作れない（式の途中から関数を抜ける形）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/block_stmt_return.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

fn first_even(let xs: list[int]) -> int:
    block:
        for x in xs:
            if x % 2 == 0:
                return x
    return -1

fn classify(let n: int) -> str:
    block:
        let doubled = n * 2
        if doubled > 10:
            return "big"
    return "small"

fn guarded() -> str:
    try:
        block:
            return "from block"
    finally:
        emit([str("finally runs")])
    return "unreached"

emit([str(first_even([1, 3, 4, 5])), str(first_even([1, 3]))])   # 4 -1
emit([str(classify(7)), str(classify(2))])                         # big small
emit([str(guarded())])                                        # finally runs / from block

# ── 出力を照らす ──
check_output([
    "4 -1",
    "big small",
    "finally runs",
    "from block",
    "",
], "block_stmt_return")
