# control_flow_expr_escape.ar — break / continue が制御フロー「式」を貫通して外側ループへ届く（#34）
#
# Arrow では `break` / `continue` は入れ子の if / match / block: 式を貫通して
# 最も内側の for / while へ届く。ブロック式が**式の途中**に現れる場合
# （`1 + block ->int: …`）、跳ぶ時点で積まれている値も正しく捨てる必要がある。
#
# ⚠ この形を踏む例題が長らく 1 本も無く、VM が載せられないことに気づけなかった（#34）。
#    ここを削ると `force_gate` / `compare_vm_modes` の検知力が落ちる。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/control_flow_expr_escape.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 1. break through a block: expression ===")])
mut found = -1
for i in range(10):
    let _ = block ->int:
        if i == 5:
            found = i
            break
        block_return i
emit([str(found)])                      # 5

emit([str("=== 2. break through an if expression ===")])
mut hit = -1
for i in range(10):
    let _ = if i == 3 ->int:
        hit = i
        break
    else:
        0
emit([str(hit)])                        # 3

emit([str("=== 3. break with pending operands on the stack ===")])
# `1 + 2 * block ...` は block 式に入る時点で 1 と 2 が積まれている。
mut r = 0
for i in range(5):
    r = 1 + 2 * block ->int:
        if i == 3:
            break
        block_return i
emit([str(r)])                          # 5  (i=2 での 1 + 2*2)

emit([str("=== 4. continue through a block: expression ===")])
mut s = 0
for i in range(6):
    let v = 100 + block ->int:
        if i < 3:
            continue
        block_return i
    s = s + v
emit([str(s)])                          # 312  (103 + 104 + 105)

emit([str("=== 5. continue through an if expression ===")])
mut t = 0
for i in range(6):
    let v = if i < 3 ->int:
        continue
    else:
        block_return i
    t = t + v
emit([str(t)])                          # 12  (3 + 4 + 5)

emit([str("=== 6. break through a match expression (while) ===")])
mut n = 0
mut out = -1
while True:
    let v = 5 + match n ->int:
        case 3:
            break
        case _:
            block_return n
    out = v
    n += 1
emit([str(out)])                        # 7  (n=2 での 5 + 2)

emit([str("=== 7. break reaches only the innermost loop ===")])
mut log = []
for i in range(3):
    for j in range(5):
        let v = 10 + block ->int:
            if j == 2:
                break
            block_return j
        log.append(v)
emit([str(log)])                        # [10, 11, 10, 11, 10, 11]

emit([str("=== 8. break inside a loop expression returns accumulated yields ===")])
let res = for i in range(10) ->list[int]:
    let _ = if i == 4 ->int:
        break
    else:
        0
    loop_yield i * 2
emit([str(res)])                        # [0, 2, 4, 6]

emit([str("=== 9. nested block expressions ===")])
mut deep = -1
for i in range(5):
    let a = 1 + block ->int:
        let b = 2 + block ->int:
            if i == 2:
                break
            block_return i
        block_return b
    deep = a
emit([str(deep)])                       # 4  (i=1 での 1 + (2 + 1))

emit([str("=== 10. break through a block: statement ===")])
mut bs = -1
for i in range(5):
    block:
        if i == 3:
            break
        bs = i
emit([str(bs)])                         # 2

emit([str("=== 11. same forms inside a function body ===")])
fn scan() -> int:
    mut acc = 0
    for i in range(5):
        acc = 1 + block ->int:
            if i == 3:
                break
            block_return i
    return acc
emit([str(scan())])                     # 3

emit([str("=== 12. break out of a try body (handler must not linger) ===")])
fn scan_try() -> int:
    mut got = -1
    for i in range(5):
        try:
            let _ = block ->int:
                if i == 2:
                    break
                block_return i
            got = i
        except ValueError:
            emit([str("BUG: the loop handler fired")])
    # ループの try は既に抜けているので、ここの raise は外側で捕まらねばならない
    raise ValueError("must escape")
    return got

try:
    emit([str(scan_try())])
except ValueError:
    emit([str("caught outside")])     # ハンドラが残っていればここへ来ない

emit([str("=== 13. continue out of a try body ===")])
mut ts = 0
for i in range(6):
    try:
        if i < 3:
            continue
        ts = ts + i
    except ValueError:
        emit([str("unused")])
emit([str(ts)])                         # 12

emit([str("=== 14. block expression as the RHS of an attribute assignment ===")])
class Box:
    mut v: int

    fn __init__(mut self) -> None:
        self.v = 0

mut bx = Box()
for i in range(5):
    # 右辺の評価中はレシーバ bx が積まれている（跳ぶ前に捨てる必要がある）
    bx.v = 1 + block ->int:
        if i == 3:
            break
        block_return i
emit([str(bx.v)])                       # 3

# ── 出力を照らす ──
check_output([
    "=== 1. break through a block: expression ===",
    "5",
    "=== 2. break through an if expression ===",
    "3",
    "=== 3. break with pending operands on the stack ===",
    "5",
    "=== 4. continue through a block: expression ===",
    "312",
    "=== 5. continue through an if expression ===",
    "12",
    "=== 6. break through a match expression (while) ===",
    "7",
    "=== 7. break reaches only the innermost loop ===",
    "[10, 11, 10, 11, 10, 11]",
    "=== 8. break inside a loop expression returns accumulated yields ===",
    "[0, 2, 4, 6]",
    "=== 9. nested block expressions ===",
    "4",
    "=== 10. break through a block: statement ===",
    "2",
    "=== 11. same forms inside a function body ===",
    "3",
    "=== 12. break out of a try body (handler must not linger) ===",
    "caught outside",
    "=== 13. continue out of a try body ===",
    "12",
    "=== 14. block expression as the RHS of an attribute assignment ===",
    "3",
    "",
], "control_flow_expr_escape")
