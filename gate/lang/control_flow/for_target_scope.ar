# for_target_scope.ar — `for` のループ変数はブロック内の束縛（bug_fix.md B4・規則 2）
#
# ⚠⚠ ループ変数は**ブロックを抜けたら解放される**。ループ後に読むと静的エラー `name 'i' is not defined`
#    （name_scope_plan.md の 1-4。以前は実行時の NameError）
#    → [for_target_scope_error.ar](for_target_scope_error.ar)
#
# ⚠ 以前は**関数の中でだけ漏れていた**。最上位では名前引きが失敗して NameError に
#   なるのに、関数内ではフレーム slot が残って最後の値が読めてしまい、
#   **同じコードが置き場所で振る舞いを変えていた**（B4 のケース b vs c/h）。
#
# 覆う形（外側に同名がある）は規則 1 で静的エラー
# → [for_target_shadow_error.ar](for_target_shadow_error.ar)
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/for_target_scope.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

emit([str("=== 1. 逐次の for は同じ名前を使い回せる ===")])
# 前のループの i は解放済みなので、再束縛ではなく新しい束縛になる。
fn twice() -> int:
    mut s = 0
    for i in [1, 2]:
        s += i
    for i in [10, 20]:
        s += i
    return s
emit([str(twice())])                    # 33

emit([str("=== 2. 入れ子 ===")])
fn nested() -> int:
    mut s = 0
    for i in range(3):
        for j in range(3):
            s += i * j
    return s
emit([str(nested())])                   # 9

emit([str("=== 3. タプル分解 ===")])
fn pairs() -> int:
    mut s = 0
    for k, v in [(1, 2), (3, 4)]:
        s += k * v
    return s
emit([str(pairs())])                    # 14

emit([str("=== 4. 捨てターゲット `_` は何度でも使える ===")])
for _ in range(2):
    emit([str("a")])
for _ in range(2):
    emit([str("b")])

emit([str("=== 5. break で抜けても本体内の値はそのまま使える ===")])
fn first_over(let xs: list[int], let lim: int) -> int:
    for x in xs:
        if x > lim:
            return x
    return -1
emit([str(first_over([1, 5, 9], 4))])   # 5

emit([str("=== 6. 最上位でも関数内でも同じ ===")])
# ⚠ ここが B4 の要点。以前は最上位だけ NameError で関数内は最後の値が読めた。
for i in range(3):
    emit([str("top-level i ="), str(i)])

# ── 出力を照らす ──
check_output([
    "=== 1. 逐次の for は同じ名前を使い回せる ===",
    "33",
    "=== 2. 入れ子 ===",
    "9",
    "=== 3. タプル分解 ===",
    "14",
    "=== 4. 捨てターゲット `_` は何度でも使える ===",
    "a",
    "a",
    "b",
    "b",
    "=== 5. break で抜けても本体内の値はそのまま使える ===",
    "5",
    "=== 6. 最上位でも関数内でも同じ ===",
    "top-level i = 0",
    "top-level i = 1",
    "top-level i = 2",
    "",
], "for_target_scope")
