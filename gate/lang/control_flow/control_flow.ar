    "len of 'hello': 5",
    "3",
    "2",
    "1",
    "0",
    "=== match: value comparison ===",
    "B",
    "hello",
    "caught by wildcard",
    "42",
    "=== match: type-pattern arms ===",
    "int",
    "it's a dog",
