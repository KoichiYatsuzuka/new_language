# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/basics/ref_equality.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ...lib.check import emit, check_output

class Point:
    mut x: int
    mut y: int
    fn __init__(mut self, let x: int, let y: int) -> None:
        self.x = x
        self.y = y

let a = Point(1, 2)
let b = Point(1, 2)
let c = a

# == は値（構造的）比較: 同じクラスかつ全フィールド等値
emit([str(a == b)])   # True  (同じ型・フィールド値)
emit([str(a == c)])   # True  (同じ参照)
emit([str(a == Point(9, 9))])  # False

# === は参照比較: 同一オブジェクトのみ真
emit([str(a === c)])  # True  (同じ参照)
emit([str(a === b)])  # False (別オブジェクト)

# プリミティブは === も値比較と同じ動作
let x = 42
let y = 42
emit([str(x === y)])  # True

# リスト: === はポインタ比較
let lst1 = [1, 2, 3]
let lst2 = [1, 2, 3]
let lst3 = lst1
emit([str(lst1 === lst3)])  # True
emit([str(lst1 === lst2)])  # False

# ── 出力を照らす ──
check_output([
    "True",
    "True",
    "False",
    "True",
    "False",
    "True",
    "True",
    "False",
    "",
], "ref_equality")
