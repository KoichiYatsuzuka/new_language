# py_property_typed_error.ar — getter の注釈が `float` の property を `str` の変数へ束縛する（タスク 6-8）
#
# 置き場の型は getter の戻り値の注釈なので、Arrow から読んだ値は `float`。
# 期待: 静的型エラー（`str` と宣言した変数を `float` で初期化している）
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/interop/py_property_typed_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

import[py] test_modules.py_property_typed as pt

mut s = pt.Sensor(21.5, [3] => py_list[int])
let name: str = s.celsius   # expect: static VarTypeMismatch
print(name)
