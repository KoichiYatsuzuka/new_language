# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/cs_interop_test.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

import[cs-dll] cs_interop_test.ArrowBridge as bridge

# ── Static integer arithmetic ──────────────────────────────────────────────
let add_result = bridge.Calculator.Add(10, 5)
emit([str("Calculator.Add(10, 5) ="), str(add_result)])      # expected 15

let sub_result = bridge.Calculator.Subtract(10, 5)
emit([str("Calculator.Subtract(10, 5) ="), str(sub_result)])  # expected 5

let mul_result = bridge.Calculator.Multiply(6, 7)
emit([str("Calculator.Multiply(6, 7) ="), str(mul_result)])   # expected 42

# ── Static float arithmetic ────────────────────────────────────────────────
let div_result = bridge.Calculator.Divide(10.0, 4.0)
emit([str("Calculator.Divide(10.0, 4.0) ="), str(div_result)])  # expected 2.5

let pow_result = bridge.Calculator.Power(2.0, 10.0)
emit([str("Calculator.Power(2.0, 10.0) ="), str(pow_result)])   # expected 1024.0

let sqrt_result = bridge.Calculator.Sqrt(9.0)
emit([str("Calculator.Sqrt(9.0) ="), str(sqrt_result)])         # expected 3.0

# ── Static properties (float) ──────────────────────────────────────────────
let pi = bridge.Calculator.getPi()
emit([str("Calculator.Pi ="), str(pi)])   # expected ~3.14159…

let e = bridge.Calculator.getE()
emit([str("Calculator.E ="), str(e)])     # expected ~2.71828…

# ── Calculator instance ────────────────────────────────────────────────────
let calc0 = bridge.Calculator()
calc0.Accumulate(5.0)
calc0.Accumulate(3.5)
let acc = calc0.GetAccumulated()
emit([str("Accumulate(5.0, 3.5) ="), str(acc)])   # expected 8.5

calc0.Reset()
let acc2 = calc0.GetAccumulated()
emit([str("After Reset() ="), str(acc2)])          # expected 0.0

# Calculator with initial value
let calc1 = bridge.Calculator(100.0)
calc1.Accumulate(25.0)
let acc3 = calc1.GetAccumulated()
emit([str("calc1(100.0).Accumulate(25.0) ="), str(acc3)])  # expected 125.0

# ── TextProcessor instance ─────────────────────────────────────────────────
let tp = bridge.TextProcessor("  Hello, World!  ")

let upper = tp.ToUpper()
emit([str("ToUpper() ="), str(upper)])   # expected "  HELLO, WORLD!  "

let lower = tp.ToLower()
emit([str("ToLower() ="), str(lower)])   # expected "  hello, world!  "

let trimmed = tp.Trim()
emit([str("Trim() ="), str(trimmed)])    # expected "Hello, World!"

let contains = tp.Contains("World")
emit([str("Contains('World') ="), str(contains)])   # expected True / 1

tp.Append(" Extra")
let text = tp.getText()
emit([str("After Append ="), str(text)])   # expected "  Hello, World!   Extra"

# ── TextProcessor static methods ───────────────────────────────────────────
let repeated = bridge.TextProcessor.Repeat("ab", 3)
emit([str("Repeat('ab', 3) ="), str(repeated)])   # expected "ababab"

let is_empty = bridge.TextProcessor.IsNullOrEmpty("")
emit([str("IsNullOrEmpty('') ="), str(is_empty)])   # expected 1 (true)

let not_empty = bridge.TextProcessor.IsNullOrEmpty("hello")
emit([str("IsNullOrEmpty('hello') ="), str(not_empty)])  # expected 0 (false)

# ── オブジェクト・nullable の戻り値と、null の文字列引数（ffi_value_exchange_plan.md 2-1）───────
# 以前はオブジェクトを返すメソッドが整数（ハンドル番号）を返し、`string?` の引数に None を渡すと
# 後ろの引数が 1 つずれていた（文字列は (ptr, len) の 2 つなのに、None を 1 つで積んでいた）。
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。
let copy = tp.Clone()
if copy.getText() != tp.getText():
    raise ValueError("Clone: got " + copy.getText())
copy.Append("!")
if tp.getText() == copy.getText():
    raise ValueError("Clone shares the object")
emit([str("Clone() is a separate C# object:"), str(copy.getText())])

let w = tp.FindWord("World")
if (w mustbe str) != "World":
    raise ValueError("FindWord(World)")
if tp.FindWord("absent") is not None:
    raise ValueError("FindWord(absent) should be None")
emit([str("FindWord: string? returns a value or None")])

if not bridge.TextProcessor.IsNullOrEmpty(None):
    raise ValueError("IsNullOrEmpty(None) should be True")
emit([str("IsNullOrEmpty(None) ="), str(bridge.TextProcessor.IsNullOrEmpty(None))])

emit([str("=== All cs-dll tests passed ===")])

# ── 出力を照らす ──
check_output([
    "Calculator.Add(10, 5) = 15",
    "Calculator.Subtract(10, 5) = 5",
    "Calculator.Multiply(6, 7) = 42",
    "Calculator.Divide(10.0, 4.0) = 2.5",
    "Calculator.Power(2.0, 10.0) = 1024.0",
    "Calculator.Sqrt(9.0) = 3.0",
    "Calculator.Pi = 3.141592653589793",
    "Calculator.E = 2.718281828459045",
    "Accumulate(5.0, 3.5) = 8.5",
    "After Reset() = 0.0",
    "calc1(100.0).Accumulate(25.0) = 125.0",
    "ToUpper() =   HELLO, WORLD!  ",
    "ToLower() =   hello, world!  ",
    "Trim() = Hello, World!",
    "Contains('World') = True",
    "After Append =   Hello, World!   Extra",
    "Repeat('ab', 3) = ababab",
    "IsNullOrEmpty('') = True",
    "IsNullOrEmpty('hello') = False",
    "Clone() is a separate C# object:   Hello, World!   Extra!",
    "FindWord: string? returns a value or None",
    "IsNullOrEmpty(None) = True",
    "=== All cs-dll tests passed ===",
    "",
], "cs_interop_test")
