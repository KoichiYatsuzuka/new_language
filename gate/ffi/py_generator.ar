# py_generator.ar — Python のジェネレータを Arrow の `for` で回す
#
# Python のジェネレータ（関数・入れ子・メソッド）は CPython の反復子のまま届き、`for` は取り出すたびに 1 つ取る
# （pandas_import_plan.md 2-4）。⇒ ④ の無限ジェネレータ + `break` は先を取り出さない。
# Arrow の側の `gen` メソッドは `examples/collections/gen_method.ar`。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_generator.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

import[py] test_modules.py_generator as m

# ── ① 素のジェネレータ ──────────────────────────────────────────────────
for v in m.two():
    emit([str(v)])
# 1
# 2

# ── ② for を含む本体 ────────────────────────────────────────────────────
mut xs = [1, 2, 3]
for v in m.squares(xs => py_list[int]):
    emit([str(v)])
# 1
# 4
# 9

# ── ③ if でふるい落とす（yield が入れ子の中にある） ─────────────────────
for v in m.filtered(xs => py_list[int]):
    emit([str(v)])
# 2
# 3

# ── ④ ★無限ジェネレータ + break（＝遅延評価の証拠） ────────────────────
mut n = 0
for v in m.counter():
    emit([str(v)])
    n = n + 1
    if n >= 3:
        break
# 0
# 1
# 2

# ── ⑤ 入れ子 `def` のジェネレータ（外側は普通の関数のまま） ─────────────
for v in m.outer():
    emit([str(v)])
# 7

# ── ⑥ 通常の関数は壊れていない ──────────────────────────────────────────
emit([str(m.not_a_gen(xs => py_list[int]))])
# 3

# ── ⑦ `gen` メソッド ────────────────────────────────────────────────────
mut b = m.Bag(xs => py_list[int])
for v in b.each():
    emit([str(v)])
emit([str(b.size())])
# 1
# 2
# 3
# 3

# ── 出力を照らす ──
check_output([
    "1",
    "2",
    "1",
    "4",
    "9",
    "2",
    "3",
    "0",
    "1",
    "2",
    "7",
    "3",
    "1",
    "2",
    "3",
    "3",
    "",
], "py_generator")
