# module_toplevel_flow.ar — 最上位に制御フローを持つモジュールを import する（#41）
#
# import されるモジュールの本体は**まだツリーウォークで実行される**（#42）。
# この例題はその経路の唯一の網で、`AR_TW_STATS` の `tw_control_flow` に計上される。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/module_toplevel_flow.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

from test_modules.mod_toplevel_flow import[ar] get_total, get_doubled

emit([str(get_total())])                # 8  (0 + 1 + 3 + 4)
emit([str(get_doubled())])              # [0, 2, 4]

# ── 出力を照らす ──
check_output([
    "8",
    "[0, 2, 4]",
    "",
], "module_toplevel_flow")
