# py_fstring.ar — f-string を使う Python の関数を Arrow から呼ぶ
#
# f-string は CPython が評価する（`!s` / `!r` / 入れ子の f-string・`{{` / `}}`）。書式指定は `py_format.ar`。
# Arrow の list / dict は `=> py_list[T]` / `=> py_dict[K, V]` で写して渡す。
# ⚠ py 関数の引数は型注釈が無いので `Any` の値を受ける。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_fstring.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

import[py] test_modules.py_fstring as m

# ── ① 基本形 ────────────────────────────────────────────────────────────
mut name = "bob"
emit([str(m.simple(name))])
# hi bob
mut n = 5
emit([str(m.multi(name, n))])
# hi bob, n=5!
emit([str(m.only_expr(n))])
# 5
emit([str(m.empty())])
#            （空行）
emit([str(m.literal_only())])
# plain
mut a = 1
mut b = 2
emit([str(m.adjacent(a, b))])
# 12

# ── ② `{{` / `}}` はリテラルの波括弧 ────────────────────────────────────
emit([str(m.braces(n))])
# {literal} 5

# ── ③ 埋め込みは任意の式（演算・呼び出し・属性・添字） ──────────────────
emit([str(m.expr_inside(a, b))])
# sum=3
mut xs = [1, 2, 3]
emit([str(m.call_inside(xs => py_list[int]))])
# len=3
mut o = m.Box(7)
emit([str(m.attr_inside(o))])
# v=7
mut d = {"x": 9}
emit([str(m.index_inside(d => py_dict[str, int]))])
# x=9

# ── ④ 変換フラグ `!s` / `!r` ────────────────────────────────────────────
mut s = "hi"
emit([str(m.conv_str(s))])
# hi
emit([str(m.conv_repr(s))])
# 'hi'      （repr なので引用符が付く）

# ── ⑤ f-string の結果をさらに f-string に埋める ─────────────────────────
emit([str(m.nested_fstring(n))])
# outer [5]

# ── 出力を照らす ──
check_output([
    "hi bob",
    "hi bob, n=5!",
    "5",
    "",
    "plain",
    "12",
    "{literal} 5",
    "sum=3",
    "len=3",
    "v=7",
    "x=9",
    "hi",
    "'hi'",
    "outer [5]",
    "",
], "py_fstring")
