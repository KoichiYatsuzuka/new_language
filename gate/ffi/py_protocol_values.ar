# py_protocol_values.ar — CPython の物と protocol（pandas_import_plan.md の 6-6）
#
# `py_list` などは組み込みの表で、Python のクラスのインスタンスは型スタブのメソッドで、protocol と静的に照合する。
# 実行時の型テスト（`x is HasLen`）は CPython 3.12 の `isinstance(x, Protocol)` と同じく、属性を静的に引く
# （`inspect.getattr_static`）。利用者のコード（`__getattr__` など）は走らない。
# ⚠ 以前は CPython の物の型テストがいつも偽だった。
#
# 期待される出力:
#   2 4
#   True True False
#   ok
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_protocol_values.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

import[py] test_modules.py_protocol_values as m

protocol HasLen:
    fn __len__(self) -> int:
        ...

fn size(mut x: HasLen) -> int:
    return len(x)

mut pl = [1, 2] => py_list[int]
mut b = m.bag()
emit([str(size(pl)), str(size(b))])
mut lz = m.lazy()
emit([str(pl is HasLen), str(b is HasLen), str(lz is HasLen)])
emit([str("ok")])

# ── 出力を照らす ──
check_output([
    "2 4",
    "True True False",
    "ok",
    "",
], "py_protocol_values")
