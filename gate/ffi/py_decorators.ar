# py_decorators.ar — デコレータを使う Python のモジュール（関数・クラス・`@staticmethod` / `@classmethod` / `@abstractmethod`）
#
# デコレータは CPython が実行する。型スタブは `@staticmethod` / `@classmethod` を静的メソッドとして読み（`@classmethod`
# の `cls` は呼び出しで渡さない）、Python と同じくインスタンスからも呼べる。
# ⚠ `@classmethod` の戻り値の型は注釈（`-> "Box"`）から取る（注釈が無ければ `Any`）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_decorators.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.pycap import py_output   # ⚠ いちばん初めの import（Python の print を貯める・README 2.3）
from ..lib.check import emit, check_output, check_text

import[py] test_modules.py_decorators as d

# ── 定義時に走るデコレータの副作用 ───────────────────────────────────────
# import の時点で以下が出力済み:
#   registered   … @banner
#   B / A        … @tag_a @tag_b（下から適用）
#   marked       … @mark（クラスデコレータ）

# ── ① 元の関数をそのまま返すデコレータ ──────────────────────────────────
mut name = "bob"
emit([str(d.hello(name))])
# hello bob

# ── ② スタックされたデコレータ ───────────────────────────────────────────
emit([str(d.stacked())])
# stacked

# ── ③ 関数を別の関数へ差し替えるデコレータ ──────────────────────────────
#     twice(3) は本来 6 だが、@always42 が差し替えているので 42。
mut n = 3
emit([str(d.twice(n))])
# 42

# ── ④ クラスデコレータ（@mark はクラスをそのまま返す） ──────────────────
mut v = 7
mut b = d.Box(v)
emit([str(b.get())])
# 7

# ── ⑤ @staticmethod → `static fn`（クラス経由で呼ぶ） ────────────────────
mut a = 10
emit([str(d.Box.bump(a))])
# 11

# ── ⑥ @classmethod → `class_method fn`（第 1 引数にクラス自身が渡る） ────
mut w = 99
mut b2 = d.Box.of(w)
emit([str(b2.get())])
# 99

# ── ⑦ @abstractmethod は抽象フラグに振り替えるだけ（本体はそのまま動く） ─
emit([str(b.described())])
# box


# ── 出力を照らす ──
# Arrow の側の行（emit）と Python の側の行（print・lib/pycap.ar）を別々に照らす（gate/README.md 2.3）。
check_output([
    "hello bob",
    "stacked",
    "42",
    "7",
    "11",
    "99",
    "box",
    "",
], "py_decorators")
check_text(py_output(), [
    "registered",
    "B",
    "A",
    "marked",
    "",
], "py_decorators (python side)")
