# js_proc_async_test.ar — Promise を返す JS 関数を AsyncManager 経由で呼ぶテスト
#
# Node.js の fs.promises.readFile は Promise を返す。
# Arrow の <- async でラップすることで、Arrow メインスレッドをブロックせずに
# 結果を取得できる。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/js_proc_async_test.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

import[js-proc] path as js_path
import[js-proc] js_text as analysis

emit([str("=== AsyncManager + js-proc ===")])

let mng = AsyncManager(2)

# タスク0: path.resolve を非同期で実行（実際は同期だが仕組みの確認）
mng <- async->str:
    block_return js_path.resolve("examples", "js_proc_test.ar")

# タスク1: analysis.cleanTypeAnnotation を非同期で実行
mng <- async->str:
    block_return analysis.cleanTypeAnnotation("  Optional[int]  ")

# 完了を待つ
mng.wait_for_finish()

# ⚠ 写すときに直した: path.resolve は作業ディレクトリからの絶対パスを返すので、末尾だけを照らす
emit([str("resolved path ends with examples\\js_proc_test.ar:"), str(str(mng.results[0]).endswith("\\examples\\js_proc_test.ar"))])
emit([str("cleaned type:"), str(mng.results[1])])
emit([str("status:"), str(mng.progress_status)])
emit([str("errors:"), str(mng.error_list)])
emit([str("done.")])

# ── 出力を照らす ──
check_output([
    "=== AsyncManager + js-proc ===",
    "resolved path ends with examples\\js_proc_test.ar: True",
    "cleaned type: Optional[int]",
    "status: [Async.Done, Async.Done]",
    "errors: [None, None]",
    "done.",
    "",
], "js_proc_async_test")
