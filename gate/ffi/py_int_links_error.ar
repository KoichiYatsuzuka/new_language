# import[py] の、import をたどって付けた型で静的に誤りを見つける（pandas_import_plan.md の D-2・タスク 1-3）
#
# 正しい形は py_int_links.ar。以前はどれも型が `Any` で、実行するまで分からなかった:
#   - 再エクスポートしたクラスのメソッドの戻り値（`width` は `int`）
#   - ほかのファイルの基底のメソッドの引数（`count` は引数を取らない）
#   - `@overload` で選んだ形の戻り値（`lazy` を渡さない `read` は `Frame` で、`Reader` ではない）
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/interop/py_int_links_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

import[py] py_int_links_pkg as pk

mut f: pk.Frame = pk.Frame(3)
let s: str = f.width()                  # int を str で受ける   # expect: static VarTypeMismatch
let n: int = f.count(1)                 # 引数を取らないメソッドに 1 つ渡す   # expect: static CallArgCountMismatch
mut r: pk.Reader = pk.read("a.csv")     # lazy を渡さないと Frame   # expect: static VarTypeMismatch
