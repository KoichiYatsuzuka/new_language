# py_format.ar — Python のモジュールの f-string の書式指定・str.format・format() を CPython で動かす
#
# `{x:spec}`・`!r` / `!s` / `!a`・書式指定の中の `{w}`・`__format__` を持つ Python のクラスを使う。
#
# fm.run() の出力（CPython）:
#   (1.5, -2.25) (1.50, -2.25) <   1.5,   -2.2> Vec(1.5, -2.25)
#   apples  |1,234.50|123.4%
#   pears   |98,765.43|9876.5%
#        right|'na\xefve'|  mid
#   1.230000e-04 1_000_000 0b11111111
#   total=3 total = 003 '\xe9'
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_format.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.pycap import py_output   # ⚠ いちばん初めの import（Python の print を貯める・README 2.3）
from ..lib.check import emit, check_output, check_text

import[py] test_modules.py_format as fm

fm.run()


# ── 出力を照らす ──
# Arrow の側の行（emit）と Python の側の行（print・lib/pycap.ar）を別々に照らす（gate/README.md 2.3）。
check_output([
    "",
], "py_format")
check_text(py_output(), [
    "(1.5, -2.25) (1.50, -2.25) <   1.5,   -2.2> Vec(1.5, -2.25)",
    "apples  |1,234.50|123.4%",
    "pears   |98,765.43|9876.5%",
    "     right|'na\\xefve'|  mid  ",
    "1.230000e-04 1_000_000 0b11111111",
    "total=3 total = 003 '\\xe9'",
    "",
], "py_format (python side)")
