# import[py] の、`.py` の無いモジュールの同梱のスタブで静的に誤りを見つける（pandas_import_plan.md の 1-4）
#
# 正しい形は py_int_builtin_modules.ar。以前は `import[py] sys` そのものが「型が見つからない」構文解析の誤りだった。
#   - 大域変数の型（`sys.maxsize` は `int`・`sys.platform` は `str`）
#   - 引数の数（`sys.intern` は 1 つ・`zlib.crc32` は 1〜2 つ）
#   - 戻り値の型（typeshed の `zlib.compress` は `bytes`・1-6）
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/interop/py_int_builtin_modules_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

import[py] sys
import[py] zlib

let size: str = sys.maxsize             # int を str で受ける   # expect: static VarTypeMismatch
let name: int = sys.platform            # str を int で受ける   # expect: static VarTypeMismatch
mut s = sys.intern("a", "b")            # 1 つしか取らない   # expect: static CallArgCountMismatch
mut c = zlib.crc32()                    # 少なくとも 1 つ要る   # expect: static CallArgCountMismatch
let z: str = zlib.compress("a".encode()) # bytes を str で受ける   # expect: static VarTypeMismatch
