# blk_method_call.ar — コンパイル済みコードが raw レイアウトのクラスのメソッドを番地で呼ぶ（copy_alloc_speed_plan.md 7-14）
#
# モジュールは .arc（コンパイル済み）を読む。非コンパイル（.ar）でも同じ値になること。
#   1. cargo run --release -- --compile examples/interop/test_modules/blk_method_call_module.ar
#   2. cargo run --release -- examples/interop/blk_method_call.ar
#
# 受け手（`h.v` など）と `let` のクラスの引数を番地から取り、コールバックを持たない変種（`@X_blk`）で呼ぶ。呼ぶ前に
# 生成コードが確かめること（外れたら今までの呼び出し）:
#   - 受け手のクラス: 本体の同じ名前・同じ並びのクラス（`V`）が入っていたら、本体のメソッドが走る
#   ⚠ 本体の同じ名前のクラスを入れる件は、known_bugs.md #30 の後は作れない（モジュールの `mustbe` が本体のクラスを
#     通さない）。今は拒まれることだけを確かめる。
#   - 全フィールドの初期化: 未初期化のフィールドを読むメソッドは、今までどおりのエラーになる
#   - `__copy__` を持つクラスが無いこと: `mut` の値を `let` で受ける写しは `__copy__` を呼ぶ
# ⚠ 期待値と違えば raise する（ゲートの多くは exit code しか見ない）。
# ⚠ gate/ への写し（gate_speed_plan.md 9-1）: もとは examples/interop/blk_method_call.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

import test_modules.blk_method_call_module as m

# 本体の `V`: モジュールの `V` と名前もフィールドの並びも同じで、メソッドの中身だけ違う
class V:
    mut x: float
    mut y: float

    fn tag(let self) -> float:
        return self.x + 2000.0

    fn bump(mut self, let k: float) -> None:
        self.x = self.x + k * 10.0

fn check(let label: str, let got: float, let want: float) -> None:
    if got != want:
        raise ValueError(label + ": expected " + str(want) + ", got " + str(got))
    emit([str(label + " OK")])

fn fresh() -> m.H:
    return m.H(m.V(1.0, 2.0), m.V(0.5, 0.25), m.N(3), m.P(4.0), m.C(1.0), "h")

# 3 周する（関数の中のループと合わせて、2 周目からは IC とガードのセルが埋まっている）
for r in range(3):
    emit([str("round " + str(r))])
    mut h = fresh()
    check("tags", m.tags(h, 4), 4004.0)
    h = fresh()
    check("bumps", m.bumps(h, 4), 7.0)
    check("bumps leaves the field", h.v.x, 7.0)
    h = fresh()
    check("adds", m.adds(h, 4), 3003.0)
    check("adds leaves the argument", h.w.x * 1000.0 + h.w.y, 500.25)
    h = fresh()
    check("self_adds (the argument is a copy taken at the call)", m.self_adds(h, 3), 8016.0)
    h = fresh()
    check("dots", m.dots(h, 4), 4.0)
    h = fresh()
    check("twices", float(m.twices(h, 4)), 44.0)
    check("twices leaves the field", float(h.n.n), 7.0)
    h = fresh()
    check("shouts (not compiled to the block variant)", m.shouts(h, 2), 2.0)
    check("locals", m.locals(3), 5506.1875)

    # 未初期化のフィールドを読むメソッド: 今までどおりのエラー
    h = fresh()
    mut msg = ""
    try:
        let t = m.totals(h, 4)
    except AttributeError as e:
        msg = str(e)
    if msg != "'P' object has no attribute 'y'":
        raise ValueError("totals: expected the uninitialized-field error, got '" + msg + "'")
    emit([str("totals raised: " + msg)])

    # `__copy__` を持つクラス: 格納の写しで 101、`let` で受ける写しでもう 1 回呼ぶ
    h = fresh()
    check("copy_gets", m.copy_gets(h, 4), 804.0)

    # 本体の `V` は、モジュールの `mustbe V` を通らない（known_bugs.md #30）。
    # ⚠ 以前は `mustbe` が名前で照合したので通り、受け手のクラスがモジュールの `V` でない（ガードが外れて本体の
    #   メソッドが走る）形をここで確かめていた。今はこの形を Arrow のソースから作れない。
    h = fresh()
    mut refused = ""
    try:
        m.put(h, V(5.0, 6.0))
    except TypeError as e:
        refused = str(e)
    if "another class of the same name, defined in the main program" in refused:
        emit([str("put refused the main program's V")])
    else:
        emit([str("put did not refuse the main program's V: " + refused)])


# ── 出力を照らす ──
# ⚠ モジュール（test_modules/blk_method_call_module.ar・`.arc` と対なので書き換えない）が print した 6 行は stdout へ
#   直接出るので照らさない（emit で貯めたこのファイルの行だけを照らす・gate/README.md 2.3）。
check_output([
    "round 0",
    "tags OK",
    "bumps OK",
    "bumps leaves the field OK",
    "adds OK",
    "adds leaves the argument OK",
    "self_adds (the argument is a copy taken at the call) OK",
    "dots OK",
    "twices OK",
    "twices leaves the field OK",
    "shouts (not compiled to the block variant) OK",
    "locals OK",
    "totals raised: 'P' object has no attribute 'y'",
    "copy_gets OK",
    "put refused the main program's V",
    "round 1",
    "tags OK",
    "bumps OK",
    "bumps leaves the field OK",
    "adds OK",
    "adds leaves the argument OK",
    "self_adds (the argument is a copy taken at the call) OK",
    "dots OK",
    "twices OK",
    "twices leaves the field OK",
    "shouts (not compiled to the block variant) OK",
    "locals OK",
    "totals raised: 'P' object has no attribute 'y'",
    "copy_gets OK",
    "put refused the main program's V",
    "round 2",
    "tags OK",
    "bumps OK",
    "bumps leaves the field OK",
    "adds OK",
    "adds leaves the argument OK",
    "self_adds (the argument is a copy taken at the call) OK",
    "dots OK",
    "twices OK",
    "twices leaves the field OK",
    "shouts (not compiled to the block variant) OK",
    "locals OK",
    "totals raised: 'P' object has no attribute 'y'",
    "copy_gets OK",
    "put refused the main program's V",
    "",
], "blk_method_call")
