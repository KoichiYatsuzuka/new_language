class V:
    mut x: float
    mut y: float
    fn __init__(mut self, x: float, y: float) -> None:
        ...


class N:
    mut n: int
    fn __init__(mut self, n: int) -> None:
        ...


class Q:
    mut x: float
    mut y: float
    fn __init__(mut self, x: float) -> None:
        ...
    fn __init__(mut self, x: float, y: float) -> None:
        ...


class K:
    mut n: int
    mut tag: str
    fn label(self) -> str:
        ...
    fn touch(mut self, s: str) -> None:
        ...
    fn count(self) -> int:
        ...
    fn __init__(mut self, n: int, tag: str) -> None:
        ...


class H:
    mut v: V
    mut w: V
    mut n: N
    mut q: Q
    mut k: K
    mut name: str
    fn __init__(mut self, v: V, w: V, n: N, q: Q, k: K, name: str) -> None:
        ...


fn fresh() -> H:
    ...

fn put_k(mut h: H, x: Any) -> None:
    ...

fn flips(mut h: H, k: int) -> float:
    ...

fn mixes(mut h: H, k: int) -> float:
    ...

fn counts(mut h: H, k: int) -> int:
    ...

fn promotes(mut h: H, k: int) -> float:
    ...

fn from_local(mut h: H, k: int) -> float:
    ...

fn init_by_write(k: int) -> float:
    ...

fn read_uninit(mut h: H, k: int) -> float:
    ...

fn labels(mut h: H, k: int) -> str:
    ...
