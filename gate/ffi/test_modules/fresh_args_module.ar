# fresh_args_module.ar — fresh_args.ar のコンパイル済みの側（copy_alloc_speed_plan.md 2-4）
#
# 作りたての値を、格納・生成の引数・`let` 仮引数に渡す。どの関数も「複製を省くと値が変わる」形を含み、
# 結果を数で返す（本体が期待値と比べる）。

class P:
    mut x: int

class Pair:
    mut a: P
    mut b: P

class Holder:
    mut p: P
    mut ps: list[P]

fn ident(mut p: P) -> P:
    return p

fn first(mut h: Holder) -> P:
    return h.p

fn read(let v: P) -> int:
    return v.x

fn read_after_write(let v: P, mut src: P) -> int:
    src.x = 50
    return v.x

# 格納: 作りたての値を 2 回・名前の値・引数をそのまま返す関数の結果・フィールドをそのまま返す関数の結果
fn store_cases() -> int:
    mut xs: list[P] = []
    xs.append(P(1))
    xs.append(P(1))
    xs[0].x = 5
    mut p = P(1)
    xs.append(p)
    xs[2].x = 9
    xs.append(ident(p))
    xs[3].x = 7
    mut h = Holder(P(2), [P(3)])
    xs.append(first(h))
    xs[4].x = 8
    # 100*xs[1] + 10*p + h.p → 1, 1, 2 なら 112
    return xs[1].x * 100 + p.x * 10 + h.p.x

# 作りたてのリストの中に名前の値
fn nested_cases() -> int:
    mut p = P(1)
    mut ys: list[list[P]] = []
    ys.append([p])
    ys[0][0].x = 6
    return p.x

# 生成の引数: 作りたての値 2 つ・同じ名前の値を 2 つ・引数をそのまま返す関数の結果
fn construct_cases() -> int:
    mut v = P(1)
    mut a = Pair(P(10), P(20))
    a.a.x = 11
    mut b = Pair(v, v)
    b.a.x = 5
    mut c = Pair(ident(v), P(3))
    c.a.x = 6
    # a.b, b.b, v → 20, 1, 1 なら 2011
    return a.b.x * 100 + b.b.x * 10 + v.x

# `let` 仮引数: 作りたての値・名前の値を別の引数から書き換える・引数をそのまま返す関数の結果
fn param_cases() -> int:
    mut p = P(1)
    let r1 = read(P(3))
    let r2 = read_after_write(p, p)
    p.x = 1
    let r3 = read_after_write(ident(p), p)
    # 3, 1, 1 なら 311
    return r1 * 100 + r2 * 10 + r3

# フィールド・添字への格納
fn field_cases() -> int:
    mut p = P(1)
    mut h = Holder(P(2), [P(3)])
    h.p = p
    h.p.x = 4
    h.ps[0] = p
    h.ps[0].x = 5
    h.p = P(7)
    # p, h.p → 1, 7 なら 17
    return p.x * 10 + h.p.x
