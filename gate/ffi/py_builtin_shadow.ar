# py_builtin_shadow.ar — Python のモジュールの最上位で組み込みの名前を束縛し直す（CPython で実行する）
#
# `test_modules/py_builtin_shadow.py` は最上位で `id = 7` / `str = "..."` / `def len(x)` を書く。
# CPython ではモジュールの大域が組み込みを隠すので、モジュールの中の `id` / `str` / `len` はそれを指す。
# ⚠ 隠すのはそのモジュールの中だけ。この（Arrow の）プログラムの `len` / `id` は組み込みのまま。
# ⚠ Arrow のソースの最上位で組み込みの名前を宣言し直すのは従来どおり誤り（`let len = 3`）。
# ⚠ Arrow に無い組み込み（`format` など）を参照するモジュールは読む時点で誤りになる（タスク 1-1・
#   `py_unsupported_builtin_error.ar`）が、モジュールで定義した同名の関数を指すなら通る。
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_builtin_shadow.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

import[py] test_modules.py_builtin_shadow as s

emit([str(s.read_back())])          # (7, 'shadowed str', 42)
emit([str(s.id), str(s.str)])            # 7 shadowed str
emit([str(len([1, 2]))])            # 2（こちらは組み込みの len）
emit([str(s.formatted())])          # n:5（モジュールで定義した format）

# ── 出力を照らす ──
check_output([
    "(7, 'shadowed str', 42)",
    "7 shadowed str",
    "2",
    "n:5",
    "",
], "py_builtin_shadow")
