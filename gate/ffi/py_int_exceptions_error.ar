# import[py] の、例外でない Python のクラスで捕まえる・投げる（静的な誤り・pandas_import_plan.md の 2-1）
#
# 正しい形は py_int_exceptions.ar。Python のクラスが例外か（組み込みの例外を継承しているか）は、型スタブが基底をたどって決める。
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/interop/py_int_exceptions_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

import[py] py_int_exceptions as px

try:   # expect: static ExceptNotError
    px.fail_app(1)
except px.Plain:                        # 例外のクラスではない
    print("caught")

raise px.Plain()                        # 例外ではない物は投げられない   # expect: static InvalidRaiseType
