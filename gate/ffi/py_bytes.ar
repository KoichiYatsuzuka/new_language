# py_bytes.ar — Python の b".." リテラルと bytes / frozenset を使うモジュールを CPython で動かし、bytes を受ける
#
# bytes は不変なので境界で Arrow の bytes に写す（`-> bytes` の注釈が型になる）。
# pb.run() の出力（CPython）:
#   b'\x89PNG\r\n' 6 True False
#   [b'name=caf\xc3\xa9', b'tags=a,b'] ['name', 'tags']
#   café café
#   UnicodeDecodeError: 'utf-8' codec can't decode byte 0xe9 in position 3: unexpected end of data
#   [b'a', b'b'] True tags
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_bytes.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.pycap import py_output   # ⚠ いちばん初めの import（Python の print を貯める・README 2.3）
from ..lib.check import emit, check_output, check_text

import[py] test_modules.py_bytes as pb

let tail: bytes = pb.run()
emit([str(tail), str(tail.hex())])


# ── 出力を照らす ──
# Arrow の側の行（emit）と Python の側の行（print・lib/pycap.ar）を別々に照らす（gate/README.md 2.3）。
check_output([
    "b'\\x89PNG!' 89504e4721",
    "",
], "py_bytes")
check_text(py_output(), [
    "b'\\x89PNG\\r\\n' 6 True False",
    "[b'name=caf\\xc3\\xa9', b'tags=a,b'] ['name', 'tags']",
    "café café",
    "UnicodeDecodeError: 'utf-8' codec can't decode byte 0xe9 in position 3: unexpected end of data",
    "[b'a', b'b'] True tags",
    "",
], "py_bytes (python side)")
