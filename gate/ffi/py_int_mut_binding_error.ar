# Python のオブジェクトを不変の束縛で受けると静的な誤り（pandas_import_plan.md の D-3・タスク 1-2）
#
# 型から Python のクラスのインスタンスと分かるものは、型検査が止める（`ImmutablePythonObject`）:
#   'p' holds a Python object, which cannot be bound with `let` — Python code can change it through other references;
#   bind it with `mut`
# 正しい形は py_int_mut_binding.ar。型が `Any` などで静的に分からないものは py_int_mut_binding_runtime_error.ar。
# ⚠ gate/ への写し（gate_speed_plan.md 4-2）: もとは examples/interop/py_int_mut_binding_error.ar。行末の期待（expect のコメント）は写したときの誤りから書き、
#   例題のコメントと照らして見直した（gate/README.md 3 節）。

import[py] py_int_refcount as rc

let p = rc.make()                       # let   # expect: static ImmutablePythonObject
const P = rc.make()                     # const   # expect: static ImmutablePythonObject
let probes = [rc.make()]                # Python の物を持つ list   # expect: static ImmutablePythonObject

fn count_self(d: rc.Probe) -> int:      # mut でない引数   # expect: static ImmutablePythonObject
    return 1

mut m = rc.make()
freeze m                                # freeze   # expect: static ImmutablePythonObject
