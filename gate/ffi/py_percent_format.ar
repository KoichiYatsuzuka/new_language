# py_percent_format.ar — Python の `%` の書式の `%s` / `%r`（known_bugs.md の #4）
#
# `%s` は `str(x)`（`__str__`、無ければ `__repr__`）、`%r` は `repr(x)`。コンテナ・組の中の値は `repr` で並べる。
#
# pf.run() の出力（CPython）:
#   t|T()
#   R()|R()
#   ab|'ab'
#   5|5
#   1.5|1.5
#   None|None
#   True|True
#   [1, 'a']|[1, 'a']
#   {'k': T()}|{'k': T()}
#   (1, T())|(1, T())
#   "it's"
#       t|R()  |t
#   t
#   [T()]
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/interop/py_percent_format.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.pycap import py_output   # ⚠ いちばん初めの import（Python の print を貯める・README 2.3）
from ..lib.check import emit, check_output, check_text

import[py] test_modules.py_percent_format as pf

pf.run()


# ── 出力を照らす ──
# Arrow の側の行（emit）と Python の側の行（print・lib/pycap.ar）を別々に照らす（gate/README.md 2.3）。
check_output([
    "",
], "py_percent_format")
check_text(py_output(), [
    "t|T()",
    "R()|R()",
    "ab|'ab'",
    "5|5",
    "1.5|1.5",
    "None|None",
    "True|True",
    "[1, 'a']|[1, 'a']",
    "{'k': T()}|{'k': T()}",
    "(1, T())|(1, T())",
    "\"it's\"",
    "    t|R()  |t",
    "t",
    "[T()]",
    "",
], "py_percent_format (python side)")
