# check.ar — gate/ のテストが結果を確かめるためのモジュール（gate/README.md の 2 節・gate_speed_plan.md D-15）。
#
# 合わなければ GateCheckFailed を raise する。ランナーはこの例外で止まったものを「確かめ落ち」と表示し、
# ほかの誤りで止まったもの（「異常終了」）と分ける。
# ⚠ このモジュールが壊れると全テストが落ちる。壊れ方で黙って通らないことは gate/check/ のテスト が確かめる。

class GateCheckFailed(Error):
    fn __init__(mut self, message: str) -> None:
        self.message = message

# `actual == expected` でなければ止める。説明・期待・実際の値（repr）を文面に入れる。
# ⚠ `Any` どうしを `==` で比べるのは静的な誤り（OperationOnAny）。`list[Any]` の `count` は実行時の `==` で数えるので、
#   それで同じ意味の比べ方にする（1 と 1.0 は等しい・インスタンスは中身で比べる）。以前は `actual == expected` と書いていて、
#   import 先の誤りが報告されるようになった（known_bugs #21）ところで全テストが止まった。
fn check_eq(let actual: Any, let expected: Any, let what: str) -> None:
    if not ([actual].count(expected) == 1):
        raise GateCheckFailed(what + ": expected " + repr(expected) + ", got " + repr(actual))

# `cond` が偽なら止める。
fn check(let cond: bool, let what: str) -> None:
    if not cond:
        raise GateCheckFailed(what)

# 必ず止める（ここに来たら誤り、という場所に置く）。⚠ `try` の中には置かない（README の 2.1）。
fn fail(let what: str) -> None:
    raise GateCheckFailed(what)

# ── 出力を貯めて照らす（README の 2.2）─────────────────────────────────────
# `print` の代わりに `emit([str(a), str(b)], sep=.., end=..)` で貯め、`check_output([行, …], 説明)` で照らす。
# `print` と同じく、値の間に sep（既定は空白 1 つ）、最後に end（既定は改行）を置く。None なら既定。
mut _emitted = ""

fn emit(let parts: list[str], let sep: Union[str, None] = None, let end: Union[str, None] = None) -> None:
    mut s = " "
    if sep is not None:
        s = sep
    mut e = "\n"
    if end is not None:
        e = end
    _emitted = _emitted + s.join(parts) + e

# 貯めた出力を改行で分けた行の並びが `lines` と同じでなければ止める（最初に違う行の番号と両方の行を文面に入れる）。
# 出力が改行で終わるときは、最後の要素が "" になる。照らした後は貯めた出力を空にする。
fn check_output(let lines: list[str], let what: str) -> None:
    let text = _emitted
    _emitted = ""
    check_text(text, lines, what)

# 文字列 `text` を改行で分けた行の並びが `lines` と同じでなければ止める（check_output と同じ文面）。
# Python の側の出力（lib/pycap.ar の py_output()）を照らすのにも使う。
fn check_text(let text: str, let lines: list[str], let what: str) -> None:
    let got = text.split("\n")
    mut n = 0
    while n < len(got) and n < len(lines):
        if not (got[n] == lines[n]):
            raise GateCheckFailed(what + ": output line " + str(n + 1) + ": expected " + repr(lines[n]) + ", got " + repr(got[n]))
        n += 1
    if not (len(got) == len(lines)):
        mut extra = ""
        if n < len(got):
            extra = got[n]
        else:
            extra = lines[n]
        raise GateCheckFailed(what + ": expected " + str(len(lines)) + " output line(s), got " + str(len(got)) + " (first extra: " + repr(extra) + ")")
