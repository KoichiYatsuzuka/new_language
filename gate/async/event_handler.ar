# event_handler.ar — Signal[T] / on / once / off / emit / emit_async / EventLoop

# ── 基本的な Signal と on/off ──────────────────────────────────────────────
# ⚠ gate/ への写し（gate_speed_plan.md 4-1）: もとは examples/async/event_handler.ar。print は emit に置き換え、
#   出力は最後の check_output で照らす（gate/README.md 2.2）。
from ..lib.check import emit, check_output

let counter = Signal[int]()

fn on_count(mut n: int) -> None:
    emit([str("handler A:"), str(n)])

fn on_once(mut n: int) -> None:
    emit([str("handler B (once):"), str(n)])

# on: 継続購読
counter on on_count

# once: 1 回だけ購読
counter once on_once

# 1 回目の emit — A と B 両方呼ばれる
counter.emit(1)

# 2 回目の emit — B は解除済みなので A だけ呼ばれる
counter.emit(2)

# off: 購読解除
counter off on_count

# 3 回目の emit — ハンドラなし（何も出力されない）
counter.emit(3)

emit([str("handler_count:"), str(counter.handler_count)])   # → 0

# ── emit_async + EventLoop.run() ────────────────────────────────────────────

let events = Signal[int]()

fn async_handler(mut v: int) -> None:
    emit([str("async got:"), str(v)])

events on async_handler

# emit_async は EventLoop のキューに積む（即時呼び出しではない）
events.emit_async(10)
events.emit_async(20)
events.emit_async(30)

# EventLoop.run(timeout) でキューを処理する（タイムアウト付き）
EventLoop.run(1.0)

emit([str("done")])

# ── 出力を照らす ──
check_output([
    "handler A: 1",
    "handler B (once): 1",
    "handler A: 2",
    "handler_count: 0",
    "async got: 10",
    "async got: 20",
    "async got: 30",
    "done",
    "",
], "event_handler")
