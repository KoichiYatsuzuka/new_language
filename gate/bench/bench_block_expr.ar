# V-C ベンチ: ブロック式（block:/if 式 + block_return、for 式 + loop_yield）。
# これらは V-C 第2増分まで丸ごとフォールバックしていた。
# ⚠ gate/ への写し（gate_speed_plan.md 4-8）: もとは examples/bench/bench_block_expr.ar。合否だけを見る（速さは測らない・README 7 節）。
#   大文字の名前の定数（100 以上）と 1 万以上の整数のリテラルを 100 で割って回数を減らし、時計を決まったもの
#   （lib/fake_time.ar）にした。print は emit に置き換え、出力は最後の check_output で照らす。
#   期待は写したときの exe の出力（4-8）。
from ..lib.check import emit, check_output

fn classify(n: int) -> int:
    let r: int = block:
        if n % 15 == 0:
            block_return 4
        elif n % 3 == 0:
            block_return 3
        elif n % 5 == 0:
            block_return 5
        else:
            block_return 1
    return r

fn sum_squares(n: int) -> int:
    let sqs: list[int] = for i in range(n) -> list[int]:
        loop_yield i * i
    mut total: int = 0
    for s in sqs:
        total += s
    return total

fn main() -> None:
    mut acc: int = 0
    mut k: int = 0
    while k < 2000:
        acc += classify(k)
        acc += sum_squares(20)
        k += 1
    emit([str(acc)])

main()

# ── 出力を照らす ──
check_output([
    "4944532",
    "",
], "bench_block_expr")
