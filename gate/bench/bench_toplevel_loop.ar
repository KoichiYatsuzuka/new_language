# bench_toplevel_loop.ar — **最上位ループ vs fn 内ループ**の計測（#70）。
#
# ⚠⚠ **この例題が無かったので、最上位ホットループの遅さは検査網に一切映っていなかった。**
# 他の bench は全部「ホットループは必ず fn の中に置く」と冒頭に書いてあり
# （#10-b で最上位も VM に載るようになった後もその文言が残っていた）、
# **素直に最上位へ書くユーザーのコードを測るものが 1 本も無かった**（#70 で起票）。
#
# 何を見ているか:
#   最上位で宣言した変数は slot ではなく**グローバル**なので、コンパイラの
#   `as_local` が `None` を返し、**型特化・融合命令（IntBinLL / IntBinLC）が一切効かない**。
#     fn の中   : `IntBinLL(i, n, Lt)`                  … 1 命令
#     最上位    : `LoadGlobal(i); LoadGlobal(n); IntBinSS(Lt)` … 3 命令
#                 （しかも `LoadGlobal` は IC ヒットでも epoch 検査＋値の clone）
#
# ⚠ **同一プログラム内で両方を測る**。別プロセスで比べるとプロセス生成の床（±2ms）と
#   コード配置のノイズ（#62 で ±7% を実測）に埋もれる。
#
# Run: target/release/arrow.exe examples/bench/bench_toplevel_loop.ar
# ⚠ gate/ への写し（gate_speed_plan.md 4-8）: もとは examples/bench/bench_toplevel_loop.ar。合否だけを見る（速さは測らない・README 7 節）。
#   大文字の名前の定数（100 以上）と 1 万以上の整数のリテラルを 100 で割って回数を減らし、時計を決まったもの
#   （lib/fake_time.ar）にした。print は emit に置き換え、出力は最後の check_output で照らす。
#   期待は写したときの exe の出力（4-8）。
from ..lib.check import emit, check_output

import ..lib.fake_time as time   # ⚠ gate/ の写し: 決まった時計（README 7 節）
let N = 20000

# ── fn 内: 空ループ（ループ制御のみ）────────────────────────
fn loop_empty_fn(let n: int) -> int:
    mut i = 0
    while i < n:
        i += 1
    return i

# ── fn 内: int 加算（IntBinLL が効く形）─────────────────────
fn loop_add_fn(let n: int) -> int:
    mut i = 0
    mut acc = 0
    let k = 3
    while i < n:
        acc = acc + k
        i += 1
    return acc

let t0 = time.time()
let r1 = loop_empty_fn(N)
let t1 = time.time()
let r2 = loop_add_fn(N)
let t2 = time.time()

# ── 最上位: 同じループを素直に書く ──────────────────────────
mut i = 0
while i < N:
    i += 1
let t3 = time.time()

mut j = 0
mut acc = 0
let k = 3
while j < N:
    acc = acc + k
    j += 1
let t4 = time.time()

let fn_empty = (t1 - t0) / float(N) * 1000000000.0
let fn_add = (t2 - t1) / float(N) * 1000000000.0
let tl_empty = (t3 - t2) / float(N) * 1000000000.0
let tl_add = (t4 - t3) / float(N) * 1000000000.0

emit([str("empty loop  fn      : " + str(fn_empty) + " ns/iter")])
emit([str("empty loop  toplevel: " + str(tl_empty) + " ns/iter")])
emit([str("METRIC toplevel_empty_ratio " + str(tl_empty / fn_empty))])
emit([str("int add     fn      : " + str(fn_add) + " ns/iter")])
emit([str("int add     toplevel: " + str(tl_add) + " ns/iter")])
emit([str("METRIC toplevel_add_ratio " + str(tl_add / fn_add))])
emit([str("checksum " + str(r1) + " " + str(r2) + " " + str(i) + " " + str(acc))])

# ── 出力を照らす ──
check_output([
    "empty loop  fn      : 50.0 ns/iter",
    "empty loop  toplevel: 50.0 ns/iter",
    "METRIC toplevel_empty_ratio 1.0",
    "int add     fn      : 50.0 ns/iter",
    "int add     toplevel: 50.0 ns/iter",
    "METRIC toplevel_add_ratio 1.0",
    "checksum 20000 60000 20000 60000",
    "",
], "bench_toplevel_loop")
