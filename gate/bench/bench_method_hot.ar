# V-B ベンチ（メソッド本体隔離）: オブジェクトはループ外で一度だけ生成し、
# 読み取りメソッドをタイトループで叩く。メソッド本体の VM 化のみを測る
# （割り当てコストを除外）。norm_sq -> dot(self)（self 経由メソッド呼び + フィールド読み）。
# ⚠ gate/ への写し（gate_speed_plan.md 4-8）: もとは examples/bench/bench_method_hot.ar。合否だけを見る（速さは測らない・README 7 節）。
#   大文字の名前の定数（100 以上）と 1 万以上の整数のリテラルを 100 で割って回数を減らし、時計を決まったもの
#   （lib/fake_time.ar）にした。print は emit に置き換え、出力は最後の check_output で照らす。
#   期待は写したときの exe の出力（4-8）。
from ..lib.check import emit, check_output

class Vec3:
    let x: float
    let y: float
    let z: float

    fn __init__(mut self, x: float, y: float, z: float) -> None:
        self.x = x
        self.y = y
        self.z = z

    fn dot(self, o: Vec3) -> float:
        return self.x * o.x + self.y * o.y + self.z * o.z

    fn norm_sq(self) -> float:
        return self.dot(self)

fn main() -> None:
    let v: Vec3 = Vec3(1.0, 2.0, 3.0)
    mut acc: float = 0.0
    mut i: int = 0
    while i < 40000:
        acc += v.norm_sq()
        i += 1
    emit([str(acc)])

main()

# ── 出力を照らす ──
check_output([
    "560000.0",
    "",
], "bench_method_hot")
