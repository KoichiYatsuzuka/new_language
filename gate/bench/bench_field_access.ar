# bench_field_access.ar
#
# E2E benchmark: measures interpreter overhead of field access in a tight loop.
# Run: cargo run --release -- examples/bench/bench_field_access.ar
#
# This is the CURRENT (HashMap-based) baseline.
# After the HashMap→Vec optimization, re-run to compare.
# ⚠ gate/ への写し（gate_speed_plan.md 4-8）: もとは examples/bench/bench_field_access.ar。合否だけを見る（速さは測らない・README 7 節）。
#   大文字の名前の定数（100 以上）と 1 万以上の整数のリテラルを 100 で割って回数を減らし、時計を決まったもの
#   （lib/fake_time.ar）にした。print は emit に置き換え、出力は最後の check_output で照らす。
#   期待は写したときの exe の出力（4-8）。
from ..lib.check import emit, check_output

import ..lib.fake_time as time   # ⚠ gate/ の写し: 決まった時計（README 7 節）
# -------------------------------------------------------------------------
# Case 1: concrete class, direct field access (obj.field)
# -------------------------------------------------------------------------
class Particle:
    mut x: float
    mut y: float
    mut z: float
    mut mass: float
    fn __init__(mut self, let x: float, let y: float,
                let z: float, let mass: float) -> None:
        self.x = x
        self.y = y
        self.z = z
        self.mass = mass

fn kinetic(let p: Particle) -> float:
    return p.mass * (p.x * p.x + p.y * p.y + p.z * p.z)

let N    = 20
let REPS = 5

mut pts = for i in range(N) -> list[Particle]:
    let f = float(i) * 0.001
    loop_yield Particle(f, f * 2.0, f * 3.0, 1.0 + f)

let t0 = time.time()
mut total = 0.0
mut rep = 0
while rep < REPS:
    mut i = 0
    while i < N:
        total += kinetic(pts[i])
        i += 1
    rep += 1
let t1 = time.time()
emit([str("concrete class  field access: " + str(t1 - t0) + " s  (N=" + str(N) + " x REPS=" + str(REPS) + ")")])

# -------------------------------------------------------------------------
# Case 2: trait-typed access (unqualified .field on trait param)
# -------------------------------------------------------------------------
trait HasEnergy:
    mut mass: float
    mut speed: float

# ⚠ `mass` / `speed` は trait `HasEnergy` が宣言しているので**再宣言しない**（再宣言は禁止）。
class Ball(HasEnergy):
    fn __init__(mut self, let mass: float, let speed: float) -> None:
        self.mass = mass
        self.speed = speed

fn energy(let obj: Ball) -> float:
    return obj.mass * obj.speed * obj.speed * 0.5

mut balls = for i in range(N) -> list[Ball]:
    let f = float(i) * 0.001
    loop_yield Ball(1.0 + f, f * 2.0)

let t2 = time.time()
mut total2 = 0.0
mut rep2 = 0
while rep2 < REPS:
    mut j = 0
    while j < N:
        total2 += energy(balls[j])
        j += 1
    rep2 += 1
let t3 = time.time()
emit([str("trait-backed    field access: " + str(t3 - t2) + " s  (N=" + str(N) + " x REPS=" + str(REPS) + ")")])

emit([str("result check: " + str(total) + " / " + str(total2))])

# ── 出力を照らす ──
check_output([
    "concrete class  field access: 0.001 s  (N=20 x REPS=5)",
    "trait-backed    field access: 0.001 s  (N=20 x REPS=5)",
    "result check: 0.17542700000000003 / 0.025061",
    "",
], "bench_field_access")
