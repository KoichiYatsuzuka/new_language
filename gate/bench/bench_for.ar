# V-D ベンチ: for ループ（range / リスト反復 / ネスト for / break/continue）。
# V-C まで for を含む関数は丸ごとフォールバックしていた。
# ⚠ gate/ への写し（gate_speed_plan.md 4-8）: もとは examples/bench/bench_for.ar。合否だけを見る（速さは測らない・README 7 節）。
#   大文字の名前の定数（100 以上）と 1 万以上の整数のリテラルを 100 で割って回数を減らし、時計を決まったもの
#   （lib/fake_time.ar）にした。print は emit に置き換え、出力は最後の check_output で照らす。
#   期待は写したときの exe の出力（4-8）。
from ..lib.check import emit, check_output

fn sum_range(n: int) -> int:
    mut s: int = 0
    for x in range(n):
        s += x
    return s

fn filtered(n: int) -> int:
    mut s: int = 0
    for x in range(n):
        if x % 3 == 0:
            continue
        if x > 5000:
            break
        s += x * 2
    return s

fn nested(a: int, b: int) -> int:
    mut acc: int = 0
    for i in range(a):
        for j in range(b):
            acc += (i * j) % 7
    return acc

fn main() -> None:
    mut total: int = 0
    mut k: int = 0
    while k < 400:
        total += sum_range(1000)
        total += filtered(2000)
        total += nested(30, 30)
        k += 1
    emit([str(total)])

main()

# ── 出力を照らす ──
check_output([
    "1266807600",
    "",
], "bench_for")
